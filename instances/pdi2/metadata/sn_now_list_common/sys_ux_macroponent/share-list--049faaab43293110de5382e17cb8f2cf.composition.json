                                "inlineScript": "/**\n  * @param {params} params\n  * @param {api} params.api\n  * @param {TransformApiHelpers} params.helpers\n  */\nfunction evaluateProperty({api, helpers}) {\n  const listMenuModel = api.data.controller.listMenu.model;\n  const selectedMenuId = listMenuModel.selectedListMenuItem.id;\n  const sharedUsersValue = listMenuModel.menuItems[selectedMenuId]?.sharedUsers || [];\n  const sharedGroupsValue = listMenuModel.menuItems[selectedMenuId]?.sharedGroups || [];\n  if (sharedUsersValue?.join(',') === api.state.sharedUsersValue && sharedGroupsValue?.join(',') === api.state.sharedGroupsValue) {\n    return true;\n  }\n\treturn false;\n}",
