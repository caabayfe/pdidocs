      "composition" : [ {
      "elementId" : "rich_text_1",
      "elementLabel" : "Rich text 1",
      "propertyValues" : {
      "html" : {
      "type" : "CLIENT_TRANSFORM_SCRIPT",
      "script" : {
      "apiVersion" : "1.0.0",
      "inlineScript" : "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.imports\n */\nfunction evaluateProperty({ api }) {\n    const isHomePage = (api.elements.canvasAppshellLayout.activeScreenId === 'home');\n    const isHomeActive = isHomePage ? 'active' : '';\n    const isSettingsActive = isHomePage ? '' : 'active';\n\n    const homeLink = isHomePage ? 'javascript:void(0)' : '/now/conversation/v1settings/home';\n    const settingsLink = isHomePage ? '/now/conversation/v1settings/general' : 'javascript:void(0)';\n    const result = api.data.app_menu.output;\n    const home = result ? result.tabNameTranslations.home : 'Home';\n    const chat_settings = result ? result.tabNameTranslations.chat_settings : 'Chat Settings';\n    if(result && result.adminConsolePages && result.adminConsolePages.length > 0)\n        return `\n        <style>\n            a { color: white;\n                font-size: 1rem;\n                opacity: 0.8;\n                text-decoration: none;\n                padding: 0.75rem 1rem;\n                line-height: 20px;\n            }\n            a.active { opacity : 1; border-bottom: 2px solid white; }\n            a:hover { border-bottom: 2px solid white; opacity: 0.95;}\n        </style>\n        <a href=\"${homeLink}\" class=\"${isHomeActive}\">${home}</a>\n        <a href=\"${settingsLink}\" class=\"${isSettingsActive}\">${chat_settings}</a>\n        `;\n    else\n        return `\n        <style>\n            a { color: white;\n                font-size: 1rem;\n                opacity: 0.8;\n                text-decoration: none;\n                padding: 0.75rem 1rem;\n                line-height: 20px;\n            }\n            a.active { opacity : 1; border-bottom: 2px solid white; }\n            a:hover { border-bottom: 2px solid white; opacity: 0.95;}\n        </style>\n        <a href=\"${homeLink}\" class=\"${isHomeActive}\">${home}</a>\n`;\n}",
      "scriptSysId" : null
      }
      }
