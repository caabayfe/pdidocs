<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<style>
		form {
			width: 600px;
			margin: 20px auto 30px auto;
			border: 1px solid rgba(0,0,0,0.2);
			padding: 35px;
			box-shadow: 0 1px 5px rgba(0,0,0,0.3);
			border-radius: 3px;
		}
		
		label {
			padding-top: 7px;
		}
		
		.col-sm-9 {
			padding-left: inherit;
			padding-right: inherit;
		}
		
		.footer-buttons {
			display: block;
			text-align: right;
		} 
		
		#sn_codesearch_results {
			padding: 20px 40px;
			border-top: 1px solid #e8e8e8;
		}
	</style>
	
	<g:ui_form>
		
		<fieldset>
				<div class="row form-group">
					<label class="col-sm-3 control-label" for="sn_codesearch_table">Search Table</label>

					<span class="col-sm-9">
						<select id="sn_codesearch_table" class="form-control" name="table">
							<g2:scripted_table_options none="true" selected="" script="sn_codesearch.SearchableTablesForDefaultGroup" showTableNames="false" showTableNamesOnLabel="true" fieldScope="sn_codesearch"/>
						</select>
					</span>
				</div>

				<div class="row form-group">
					<label for="sn_codesearch_term" class="control-label col-sm-3">Term</label>
					<span class="col-sm-9 form-field">
						<input id="sn_codesearch_term" class="form-control" type="text" placeholder="Type a term" name="sn_codesearch_term" />
					</span>
				</div>
			
				<div class="row form-group">
					<div class="col-sm-3"></div>
					<div class="col-sm-9">
						<span class="input-group-checkbox">
							<input id="sn_codesearch_search_all_scopes" class="checkbox" type="checkbox" name="sn_codesearch_search_all_scopes" />
							<label for="sn_codesearch_search_all_scopes" class="checkbox-label">Search All Applications</label>
						</span>
					</div>
				</div>
			
		</fieldset>
		
		<!-- the sn_codesearch_getResults and sn_codesearch_clearSelections function definitions are in the UI Page CodeSearchExampleUse -->
		<div class="footer-buttons">
			<g:dialog_buttons_ok_cancel ok="return sn_codesearch_getResults()" ok_id="ok_button" cancel_type="button" cancel="sn_codesearch_clearSelections()" />
		</div>
	</g:ui_form>
	<div id="sn_codesearch_results">
	</div>
</j:jelly>
