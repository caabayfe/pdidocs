        "inlineScript" : "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api\n}) {\n    if (api.context.props.payload.props_details.text &&\n        api.context.props.payload.props_details.text.icon &&\n        api.context.props.payload.props_details.text.label) {\n        const {\n            icon,\n            label\n        } = api.context.props.payload.props_details.text;\n\n        return `\n    <style>\n    .card {\n        color : RGB(var(--now-color_grouped--green-4))\n    }\n    .label {\n        color : RGB(var(--now-color_grouped--green-4));\n        font-size: var(--now-static-space--lg);\n        font-weight: 700;\n    }\n    </style>\n    <now-icon class=\"card\" icon=${icon} size=\"md\"></now-icon>\n    <now-rich-text class=\"label\" html=${label}></now-rich-text>\n    `;\n    }\n    return '';\n}",
        "scriptSysId" : null,
        "target" : null
      }
    }
  },
