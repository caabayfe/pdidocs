            "html": {
                "script": {
                    "apiVersion": "2.0.0",
                    "controllerElementId": null,
                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    const {\n        title,\n        inline_style\n    } = api.context.props.payload.props_details.plugin_title;\n    return `\n    <style>\n    .plugin_card_title {\n font-size: 16px;\n      font-weight: 600;\n      text-align: center;\n      margin-left:auto;\n      margin-right:auto;\n      min-width:2rem\n    }\n    p{\n      margin-bottom:1px;\n    }\n    </style>\n    <p class=\"plugin_card_title\" ${inline_style ? `style=${inline_style}` : ''}>\n      ${title}\n    </p>\n  `;\n\n}",
                    "scriptSysId": "05335b9a530411102958ddeeff7b1215",
