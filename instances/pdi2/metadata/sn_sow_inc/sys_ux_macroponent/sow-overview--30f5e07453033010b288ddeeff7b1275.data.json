                                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n * @param {any} params.imports\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    var reportRanges = [];\n    var results = api.data.fetch_report_ranges.output.data.GlideRecord_Query.sys_report_range._results;\n    for (var index in results) {\n        var reportRange = {\n            label: results[index].label.displayValue,\n            upper_value_duration: results[index].upper_value_duration.value\n        };\n        reportRanges.push(reportRange);\n    }\n    return {\n        propName: 'reportRanges',\n        value: reportRanges\n    };\n}",
