                                                "apiVersion": "1.0.0",
                                                "controllerElementId": null,
                                                "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    const questionAnswerDetails = api.data.security_question_verification_controller.questionAnswerDetails;\n    let requestPayload = {};\n    requestPayload.isEncrypted = false;\n    for (let i = 0; i < questionAnswerDetails.length; i++) {\n        requestPayload[\"sysparm_question_\" + i] = questionAnswerDetails[i].question.id;\n        requestPayload[\"sysparm_answer_\" + i] = questionAnswerDetails[i].answer;\n    }\n    return {\n        requestDetail: requestPayload,\n        errorMessagePrefix: \"One or more answer(s) incorrect.\"\n    };\n}",
                                                "scriptSysId": null,
