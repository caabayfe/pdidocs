<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">  
	<g2:evaluate var="jvar_path" object="true" >
            var pc = new sn_ex_sp.PortalExtensibleNavigationUtil();
            var menuPath = pc.getUIFormatterContent(current);
            menuPath;
        </g2:evaluate>
	<g2:evaluate var="jvar_hasPath" object="true" jelly ="true">
            var path = jelly.jvar_path;
	    var hasPath = path.length > 0;
	    hasPath;
        </g2:evaluate>
        <j2:if test="$[jvar_hasPath]">
            <td class="breadcrumb_container">
				<div style="overflow: visible">
					<label for="" dir="ltr" class="${jvar_cols_label} control-label">
						<span title="" class="label-text">${gs.getMessage("Menu path")}</span>
					</label>
				</div>
				<div class="${jvar_cols_field} form-field input_controls" style="overflow: visible">
					<div style="padding-left:10px">
						<g2:no_escape>
							$[jvar_path]
						</g2:no_escape>
					</div>
				</div>
            </td>
        </j2:if>
</j:jelly>
