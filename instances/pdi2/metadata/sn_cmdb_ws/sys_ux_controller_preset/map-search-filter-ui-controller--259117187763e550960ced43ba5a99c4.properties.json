{
    "ciSysid": {
        "binding": {
            "address": [
                "rootNode"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "configIdentifierId": {
        "binding": {
            "address": [
                "getMapDataController",
                "configIdentifier"
            ]
        },
        "type": "DATA_OUTPUT_BINDING"
    },
    "controlPanelButtonItems": {
        "type": "JSON_LITERAL",
        "value": [
            {
                "icon": "timeline-outline",
                "id": "toggleTimeline",
                "label": "",
                "tooltip": "Toggle visibility of the timeline"
            }
        ]
    },
    "editMode": {
        "operation": {
            "left": {
                "transform": {
                    "operands": {
                        "container": [
                            {
                                "binding": {
                                    "address": [
                                        "editMode"
                                    ],
                                    "category": "props"
                                },
                                "type": "CONTEXT_BINDING"
                            }
                        ],
                        "type": "LIST_CONTAINER"
                    },
                    "operator": "LOWERCASE"
                },
                "type": "CLIENT_TRANSFORM"
            },
            "operator": "EQUAL",
            "right": {
                "type": "JSON_LITERAL",
                "value": "true"
            }
        },
        "type": "BINARY"
    },
    "levels": {
        "binding": {
            "address": [
                "levels"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "nodemapButtonItems": {
        "type": "JSON_LITERAL",
        "value": [
            
        ]
    },
    "perfLogging": {
        "binding": {
            "address": [
                "perfLogging"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "presetId": {
        "binding": {
            "address": [
                "presetId"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "selectedItemId": {
        "transform": {
            "operands": {
                "container": [
                    {
                        "operation": {
                            "left": {
                                "binding": {
                                    "address": [
                                        "selectedNodeSysid"
                                    ],
                                    "category": "props"
                                },
                                "type": "CONTEXT_BINDING"
                            },
                            "operator": "NOT_EQUAL",
                            "right": {
                                "type": "JSON_LITERAL",
                                "value": ""
                            }
                        },
                        "type": "BINARY"
                    },
                    {
                        "binding": {
                            "address": [
                                "selectedNodeSysid"
                            ],
                            "category": "props"
                        },
                        "type": "CONTEXT_BINDING"
                    },
                    {
                        "binding": {
                            "address": [
                                "selectedConnectionId"
                            ],
                            "category": "props"
                        },
                        "type": "CONTEXT_BINDING"
                    }
                ],
                "type": "LIST_CONTAINER"
            },
            "operator": "IF"
        },
        "type": "CLIENT_TRANSFORM"
    }
}
