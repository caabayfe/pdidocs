{
    "ciClass": {
        "binding": {
            "address": [
                "selectedNodeClass"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "ciSysid": {
        "binding": {
            "address": [
                "selectedNodeSysid"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "configIdentifierId": {
        "binding": {
            "address": [
                "getMapDataController",
                "configIdentifier"
            ]
        },
        "type": "DATA_OUTPUT_BINDING"
    },
    "connectionId": {
        "binding": {
            "address": [
                "selectedConnectionId"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "isEditMode": {
        "operation": {
            "left": {
                "binding": {
                    "address": [
                        "editMode"
                    ],
                    "category": "props"
                },
                "type": "CONTEXT_BINDING"
            },
            "operator": "EQUAL",
            "right": {
                "type": "JSON_LITERAL",
                "value": "true"
            }
        },
        "type": "BINARY"
    },
    "levels": {
        "binding": {
            "address": [
                "levels"
            ],
            "category": "props"
        },
        "type": "CONTEXT_BINDING"
    },
    "timestamp": {
        "binding": {
            "address": [
                "mapSearchFilterController",
                "reloadTimestamp"
            ],
            "category": "data"
        },
        "type": "DATA_OUTPUT_BINDING"
    }
}
