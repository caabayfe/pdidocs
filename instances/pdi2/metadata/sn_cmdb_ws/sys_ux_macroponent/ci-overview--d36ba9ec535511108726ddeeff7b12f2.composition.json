                                        "payload": {
                                            "script": {
                                                "apiVersion": "1.0.0",
                                                "controllerElementId": null,
                                                "inlineScript": "/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tconst {\n        row,\n\t\tsys_id: sysId,\n        record_id: recordId,\n\t\trecordTable\n    } = event.payload;\n\tconst {\n        overviewType\n    } = api.context.props;\n\n\tlet className = '';\n\tif (overviewType === 'summary') {\n\t\tclassName = row?.rowData?.value?.get(\"encoded_query\")?.columnData?.displayValue;\n\n\t\treturn {\n\t\t\troute: 'class-overview',\n\t\t\tfields: { sysClassName: className },\n\t\t\tparams: { sysId: recordId },\n\t\t\tredirect: null,\n\t\t\tpassiveNavigation: null,\n\t\t\ttitle: null,\n\t\t\tmultiInstField: null,\n\t\t\ttargetRoute: 'current',\n\t\t\texternal: null,\n\t\t\tnavigationOptions: null\n\t\t};\n\t} else if (overviewType === 'my-cis') {\n\t\treturn {\n\t\t\troute: 'record',\n\t\t\tfields: { table: recordTable, sysId: sysId },\n\t\t\tparams: null,\n\t\t\tredirect: null,\n\t\t\tpassiveNavigation: null,\n\t\t\ttitle: null,\n\t\t\tmultiInstField: null,\n\t\t\ttargetRoute: 'current',\n\t\t\texternal: null,\n\t\t\tnavigationOptions: null\n\t\t};\n\t}\n}",
