                                                                        "apiVersion": "1.0.0",
                                                                        "controllerElementId": null,
                                                                        "inlineScript": "/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar roles = api.context.session.user.roles;\n\tvar role = roles.join(',');\n\tif (roles.includes('sn_cmdb_admin') || roles.includes('admin') || roles.includes('maint')) {\n\t\trole = 'sn_cmdb_admin';\n\t} else if (roles.includes('sn_cmdb_editor')) {\n\t\trole = 'sn_cmdb_editor';\n\t} else if (roles.includes('sn_cmdb_user')) {\n\t\trole = 'sn_cmdb_user';\n\t}\n\treturn {\n\t\tevent: \"Edit attribute\",\n\t\tvalue: {\n\t\t\t'class': api.context.props.table,\n\t\t\t'section': api.context.props.section.caption,\n\t\t\t'role': role\n\t\t}\n\t};\n}",
