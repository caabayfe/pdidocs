                        "address": [
                            "as_compose_record_ctrl",
                            "activityStream",
                            "isHTMLEditorAvailable"
                        ]
                    }
                },
                "fitToParent": {
                    "type": "BINARY",
                    "operation": {
                        "operator": "AND",
                        "left": {
                            "type": "BINARY",
                            "operation": {
                                "operator": "EQUAL",
                                "left": {
                                    "type": "DATA_OUTPUT_BINDING",
                                    "binding": {
                                        "address": [
                                            "as_compose_record_ctrl",
                                            "activityStream",
                                            "isSideBySideEnabled"
                                        ]
                                    }
                                },
                                "right": {
                                    "type": "JSON_LITERAL",
                                    "value": true
                                }
                            }
                        },
                        "right": {
                            "type": "BINARY",
                            "operation": {
                                "operator": "EQUAL",
                                "left": {
                                    "type": "DATA_OUTPUT_BINDING",
                                    "binding": {
                                        "address": [
                                            "as_compose_record_ctrl",
                                            "activityStream",
                                            "isSideBySideAvailable"
                                        ]
                                    }
                                },
                                "right": {
                                    "type": "JSON_LITERAL",
                                    "value": true
                                }
                            }
                        }
                    }
                },
                "enableManualResizer": {
                    "type": "JSON_LITERAL",
                    "value": true
                },
                "emailAction": {
                    "type": "DATA_OUTPUT_BINDING",
                    "binding": {
                        "address": [
                            "as_compose_record_ctrl",
                            "activityStream",
                            "composeEmailInfo"
                        ]
                    }
                },
                "showEmailMiniCompose": {
                    "type": "CLIENT_TRANSFORM",
                    "transform": {
                        "operator": "IF",
                        "operands": {
                            "type": "LIST_CONTAINER",
                            "container": [
                                {
                                    "type": "DATA_OUTPUT_BINDING",
                                    "binding": {
                                        "address": [
                                            "as_compose_record_ctrl",
                                            "isEmailClientEnabled"
                                        ]
                                    }
                                },
                                {
                                    "type": "JSON_LITERAL",
                                    "value": "ALWAYS"
                                },
                                {
                                    "type": "JSON_LITERAL",
                                    "value": "NEVER"
                                }
                            ]
                        }
                    }
                },
                "enableUnsavedFieldIndicators": {
                    "type": "JSON_LITERAL",
                    "value": true
                },
                "hasUnsentEmail": {
