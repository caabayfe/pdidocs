{
  "table": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "table"
      ]
    }
  },
  "sysId": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "sysId"
      ]
    }
  },
  "fields": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "form",
        "fields"
      ]
    }
  },
  "lastFormSubmit": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "lastSubmitted"
      ]
    }
  },
  "isNewRecord": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "isNew"
      ]
    }
  },
  "isSideBySideViewEnabled": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "isSideBySideEnabled"
      ]
    }
  },
  "isSideBySideViewAvailable": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "isSideBySideAvailable"
      ]
    }
  },
  "isRichTextEnabled": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "isHTMLEditorEnabled"
      ]
    }
  },
  "isRichTextAvailable": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "isHTMLEditorAvailable"
      ]
    }
  },
  "insertValueInJournalField": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "form",
        "insertValueInJournalField"
      ]
    }
  },
  "fitToParent": {
    "type": "BINARY",
    "operation": {
      "operator": "AND",
      "left": {
        "type": "BINARY",
        "operation": {
          "operator": "EQUAL",
          "left": {
            "type": "DATA_OUTPUT_BINDING",
            "binding": {
              "address": [
                "activityStream",
                "isSideBySideEnabled"
              ]
            }
          },
          "right": {
            "type": "JSON_LITERAL",
            "value": true
          }
        }
      },
      "right": {
        "type": "BINARY",
        "operation": {
          "operator": "EQUAL",
          "left": {
            "type": "DATA_OUTPUT_BINDING",
            "binding": {
              "address": [
                "activityStream",
                "isSideBySideAvailable"
              ]
            }
          },
          "right": {
            "type": "JSON_LITERAL",
            "value": true
          }
        }
      }
    }
  },
  "autoresize": {
    "type": "BINARY",
    "operation": {
      "operator": "OR",
      "left": {
        "type": "BINARY",
        "operation": {
          "operator": "EQUAL",
          "left": {
            "type": "DATA_OUTPUT_BINDING",
            "binding": {
              "address": [
                "activityStream",
                "isSideBySideEnabled"
              ]
            }
          },
          "right": {
            "type": "JSON_LITERAL",
            "value": false
          }
        }
      },
      "right": {
        "type": "BINARY",
        "operation": {
          "operator": "EQUAL",
          "left": {
            "type": "DATA_OUTPUT_BINDING",
            "binding": {
              "address": [
                "activityStream",
                "isSideBySideAvailable"
              ]
            }
          },
          "right": {
            "type": "JSON_LITERAL",
            "value": false
          }
        }
      }
    }
  },
  "enableManualResizer": {
    "type": "JSON_LITERAL",
    "value": true
  },
  "emailAction": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "composeEmailInfo"
      ]
    }
  },
  "showEmailMiniCompose": {
    "type": "CLIENT_TRANSFORM",
    "transform": {
      "operator": "IF",
      "operands": {
        "type": "LIST_CONTAINER",
        "container": [
          {
            "type": "DATA_OUTPUT_BINDING",
            "binding": {
              "address": [
                "isEmailClientEnabled"
              ]
            }
          },
          {
            "type": "JSON_LITERAL",
            "value": "ALWAYS"
          },
          {
            "type": "JSON_LITERAL",
            "value": "NEVER"
          }
        ]
      }
    }
  },
  "enableUnsavedFieldIndicators": {
    "type": "JSON_LITERAL",
    "value": true
  },
  "hasUnsentEmail": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "hasUserTypedEmailContent"
      ]
    }
  },
  "emailMiniComposerPosition": {
    "type": "JSON_LITERAL",
    "value": "LAST"
  },
  "bare": {
    "type": "JSON_LITERAL",
    "value": false
  },
  "supplemental": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "activityStream",
        "additionalEventInfo"
      ]
    }
  },
  "suppressGlobalEvents": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "shouldSuppressGlobalEvents"
      ]
    }
  },
  "userSession": {
    "type": "CONTEXT_BINDING",
    "binding": {
      "address": [
        "user"
      ],
      "category": "session"
    }
  },
  "recordMembers": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "form",
        "recordMembers"
      ]
    }
  },
  "nowDsDomainId": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "nowDsDomainId"
      ]
    }
  },
  "nowDsDomainScope": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "nowDsDomainScope"
      ]
    }
  },
  "nowDsRecordId": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "nowDsRecordId"
      ]
    }
  },
  "nowDsRecordTable": {
    "type": "DATA_OUTPUT_BINDING",
    "binding": {
      "address": [
        "nowDsRecordTable"
      ]
    }
  },
  "postButtonSize": {
    "type": "JSON_LITERAL",
    "value": "md"
  }
}
