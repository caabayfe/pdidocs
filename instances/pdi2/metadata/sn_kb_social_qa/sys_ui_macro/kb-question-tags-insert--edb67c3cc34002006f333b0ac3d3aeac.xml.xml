<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:requires position="last" name="scripts/app.social_qa/tags/kb_social_qa_related_tags.js"/>
	<g2:evaluate var="jvar_question_id">
		current.getUniqueValue();
	</g2:evaluate>
	<g2:evaluate var="jvar_knowledge_base">
		current.getValue('kb_knowledge_base');
	</g2:evaluate>
	<style>
	    HTML[data-doctype=true] .custom-form-group.form-group {
			margin-left: -15px !important;
			margin-right: -15px !important;
		}
	</style>
	<div id="label.kb_social_qa_question.tags" no-wrap="true">
		<label class="col-xs-12 col-md-1_5 col-lg-2 control-label">
			<span class="label-text" title="Tags related to the question">Tags</span>
		</label>
	</div>
	<div class="col-xs-10 col-md-9 col-lg-8 form-field input_controls">
		<ul id="question_tags"
			data-table="kb_social_qa_question"
			data-label="${gs.getMessage('Add tag...')}"
			data-sys_id="$[jvar_question_id]"
			data-knowledge_base="$[jvar_knowledge_base]"
			style="margin-left:0px !important;margin-top:0px !important; height: inherit; display:none;" 
			class="form-control">
		</ul>
		<input id="sys_original.kb_social_qa_question.tags" name="sys_original.kb_social_qa_question.tags" value="" type="hidden"/>
		<input id="kb_social_qa_question.tags" name="kb_social_qa_question.tags" value="" type="hidden"/>
	</div>
	<div class="col-xs-2 col-md-1 form-field-addons"></div>

</j:jelly>
