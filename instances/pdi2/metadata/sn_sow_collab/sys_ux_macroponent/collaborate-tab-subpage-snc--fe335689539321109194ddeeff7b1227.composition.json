                                {
                                    "broker": null,
                                    "clientScript": null,
                                    "clientTransformScript": "javascript(/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    let eventName = \"Start Collaboration\";\n    let provider = \"collaboration\";\n\n    switch (event.payload.item.id) {\n        case 'start-ms-teams-meeting':\n            eventName = \"Open Start Conference Modal\";\n            provider = \"Microsoft Teams\";\n            break;\n        case 'start-zoom-meeting':\n            eventName = \"Open Start Conference Modal\";\n            provider = \"Zoom\";\n            break;\n        case 'start-twiliodirect-meeting':\n            eventName = \"Open Start Conference Modal\";\n            provider = \"Twilio\";\n            break;\n        case 'start-webex-meeting':\n            eventName = \"Open Start Conference Modal\";\n            provider = \"Webex\";\n            break;\n    }\n\n    if (event.payload.item.sectionId == 'call') {\n        return {\n            event: 'Open Start Conference Modal',\n            value: {\n                'User': api.context.session.user.sys_id,\n                'Provider': event.payload.item.serviceProvider\n            }\n        };\n    } else if (event.payload.item.id == \"start-sidebar-discussion\") {\n        return {\n            event: \"Open Sidebar Discussion Modal\",\n            value: {\n                \"User\": api.context.session.user.sys_id\n            }\n        };\n    } else if (event.payload.item.id == \"teams-chat\") {\n        return {\n            event: \"Open Microsoft Teams Chat Modal\",\n            value: {\n                \"User\": api.context.session.user.sys_id\n            }\n        };\n    } else if (event.payload.item.id == \"import-teams-chat\") {\n        return {\n            event: \"Click Import Microsoft Teams Chat\",\n            value: {\n                \"User\": api.context.session.user.sys_id\n            }\n        };\n    } else {\n        return {\n            event: eventName,\n            value: {\n                \"User\": api.context.session.user.sys_id,\n                \"Provider\": provider\n            }\n        }\n    }\n})",
