<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<!-- 
	Phase 2 GlideRecord object of the incident is available in this macro via jvar_task variable.
	
	Here is a simple usage:

	<g2:evaluate jelly="true" object="true">
        var opened_by = jelly.jvar_task.getDisplayValue('opened_by');
        var caller = jelly.jvar_task.getDisplayValue('caller_id');
    </g2:evaluate>
    <div class="col-sm-12">
		<div class="col-sm-6">
			$[opened_by]
		</div>
		<div class="col-sm-6">
			$[caller]
		</div>
    </div>
	-->
</j:jelly>
