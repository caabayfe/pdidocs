<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<style>
		.cards {
			font-family: SourceSansPro;
			color: #343D47;
			border-bottom: 1px solid #BDC0C4;
		}
		.cards table {
			width: 100%;
			table-layout: fixed;
			border-spacing: 20px;
			border-collapse: separate;
		}
		.cards table tr td{
			text-align: center;
			border: 1px solid #bdc0c4;
			border-radius: 3px;
			box-shadow: 0 1px 1px 0 rgba(0,0,0,0.2);
			height: 100px;
			width: 33%;
			padding: 20px;
		}
		.cards table tr td .number {
			font-size: 24px;
		}
		.cards table tr td .text {
			font-size: 13px;
		}
	</style>
	<g:evaluate var="jvar_countssarray" jelly="true" object="true">
		jelly.jvar_counts.split(",")
	</g:evaluate>
	<g:evaluate var="jvar_titlessarray" jelly="true" object="true">
		jelly.jvar_titles.split(",")
	</g:evaluate>
	<div class="cards">
		<table>
			<tr>
				<j:forEach items="${jvar_countssarray}" var="jvar_count" indexVar="jvar_index">
					<td>
						<div class="number"><b>${jvar_count}</b></div>
						<div class="text">${jvar_titlessarray[jvar_index]}</div>
					</td>
				</j:forEach>
			</tr>
		</table>
	</div>
</j:jelly>
