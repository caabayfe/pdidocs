<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_escape_text" jelly="true">
		var escapeTextProperty = gs.getProperty("glide.ui.escape_text");
		escapeTextProperty == "true";
	</g:evaluate>
	<j:if test="${jvar_escape_text == true}">
		${jvar_text}
	</j:if>
	<j:if test="${jvar_escape_text != true}">
		${html:jvar_text}
	</j:if>
</j:jelly>
