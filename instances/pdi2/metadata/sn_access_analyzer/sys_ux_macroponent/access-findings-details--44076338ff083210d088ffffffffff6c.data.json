    {
        "definition": {
            "id": "6fbd21e4ff343210d088ffffffffffc9",
            "type": "TRANSFORM"
        },
        "elementId": "get_access_analyzer_finding_details",
        "elementLabel": "Get Access Analyzer Finding Details",
        "eventMappings": [
            {
                "eventMappingId": "UddBVNfYWDUzeeeeddFEHTOIUXQlI",
                "isConfiguration": false,
                "offRowStorageId": null,
                "sourceEventApiName": "sn_uxf.DATA_FETCH_SUCCEEDED",
                "sourceEventCorrelationId": null,
                "sourceEventDefinition": {
                    "apiName": "sn_uxf.DATA_FETCH_SUCCEEDED",
                    "id": null,
                    "type": "UXEVENT"
                },
                "sourceEventSysId": null,
                "targets": [
                    {
                        "broker": null,
                        "clientScript": null,
                        "clientTransformScript": "javascript(/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n\n    var text = api?.data?.get_access_analyzer_finding_details?.output?.finding_details;\n\n    // Split before any title ending with \":\" at start of line\n    var parts = text.split(/(?=\\n?[A-Z][\\w\\s]+:)/);\n\n    // Format each part\n    var formattedFindingDetails = parts.map(function(section) {\n        section = section.trim(); // remove leading/trailing spaces\n\n        // Add line break before numbered points (1., 2., 3.)\n        section = section.replace(/(\\d+\\.)/g, '<br>$1');\n\n        // Handle bullet points: convert lines starting with \"-\" or \"*\" to a., b., c. per section\n        var lines = section.split(/\\n|<br>/);\n        var bulletIndex = 0;\n        lines = lines.map(function(line) {\n            line = line.trim();\n            if (/^\\s*[-*]\\s+/.test(line)) {\n                var letter = String.fromCharCode(97 + bulletIndex++); // 'a', 'b', 'c'...\n                return letter + \". \" + line.replace(/^\\s*[-*]\\s+/, '');\n            }\n            return line;\n        });\n\n        // Only add <br> before title if it’s not at the very start\n        if (!/^<br>/.test(lines[0])) {\n            lines[0] = '<br>' + lines[0];\n        }\n\n        return lines.join('<br>');\n    }).join('');\n\n    return {\n        propName: \"findingDetails\",\n        value: formattedFindingDetails\n    };\n})",
                        "conditional": null,
                        "declarativeAction": null,
                        "event": {
                            "apiName": "sn_uxf.MACROPONENT_STATE_UPDATE_REQUESTED",
                            "payload": {
                                "script": {
                                    "apiVersion": "1.0.0",
                                    "controllerElementId": null,
                                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n\n    var text = api?.data?.get_access_analyzer_finding_details?.output?.finding_details;\n\n    // Split before any title ending with \":\" at start of line\n    var parts = text.split(/(?=\\n?[A-Z][\\w\\s]+:)/);\n\n    // Format each part\n    var formattedFindingDetails = parts.map(function(section) {\n        section = section.trim(); // remove leading/trailing spaces\n\n        // Add line break before numbered points (1., 2., 3.)\n        section = section.replace(/(\\d+\\.)/g, '<br>$1');\n\n        // Handle bullet points: convert lines starting with \"-\" or \"*\" to a., b., c. per section\n        var lines = section.split(/\\n|<br>/);\n        var bulletIndex = 0;\n        lines = lines.map(function(line) {\n            line = line.trim();\n            if (/^\\s*[-*]\\s+/.test(line)) {\n                var letter = String.fromCharCode(97 + bulletIndex++); // 'a', 'b', 'c'...\n                return letter + \". \" + line.replace(/^\\s*[-*]\\s+/, '');\n            }\n            return line;\n        });\n\n        // Only add <br> before title if it’s not at the very start\n        if (!/^<br>/.test(lines[0])) {\n            lines[0] = '<br>' + lines[0];\n        }\n\n        return lines.join('<br>');\n    }).join('');\n\n    return {\n        propName: \"findingDetails\",\n        value: formattedFindingDetails\n    };\n}",
