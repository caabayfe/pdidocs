        "propertyValues": {
            "html": {
                "type": "TRANSLATION_LITERAL",
                "value": {
                    "code": null,
                    "comment": "",
                    "message": "<p style=\"margin: 5pt 0cm; font-size: 12pt; font-family: Aptos, sans-serif;\"><span style=\"font-size: 10.0pt; font-family: Verdana, sans-serif;\">The Take action option enables you to apply role or group assignments based on the simulation results. This consent form ensure that the admin is aware of the following implications:</span></p>\n<ul style=\"margin-bottom: 0cm; margin-top: 0px;\" type=\"disc\">\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Enabling the Take Action option will change the user's role or groups in the database.</li>\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Adding or removing a role or group to the user:\n<ul style=\"margin-bottom: 0cm; margin-top: 0px; list-style-type: circle;\" type=\"disc\">\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Affects users on the ServiceNow platform, not the third-party tool (Access Rights Manager).</li>\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Bypasses any approval flow configured on the ServiceNow platform.</li>\n</ul>\n</li>\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Provides or revokes access to other resources beyond the access simulation.</li>\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">Auditing will be conducted for every change made during the access simulation.</li>\n<li style=\"font-size: 10pt; line-height: 200%; font-family: Verdana, sans-serif;\">It is recommended to add roles through a group instead of directly assigning them, following ServiceNow's recommendation.</li>\n</ul>\n<p style=\"margin: 0cm; font-size: 12pt; font-family: Aptos, sans-serif;\">&nbsp;</p>"
                }
            }
        },
        "slot": null,
        "styles": null
    }
