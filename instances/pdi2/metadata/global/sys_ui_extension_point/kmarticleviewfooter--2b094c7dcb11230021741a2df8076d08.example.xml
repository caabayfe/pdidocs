<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <div class="content-frame single-col meta internal">
      <div class="panel panel-default" style="margin-top:20px;">
         <div class="panel-body">
            <div id="kb_internal_panel">
               <table width="100%" cellspacing="0" cellpadding="0">
                  <tbody>
                     <tr>
                        <td valign="top" width="50%">
                           <h4>Article Information</h4>
                           <table class="table borderless table-condensed" style="padding:10px 50px 10px 10px;">
                              <tbody>
                                 <tr>
                                    <td align="right"><strong>${gs.getMessage("State")} : </strong></td>
                                    <td>${jvar_knowledgerecord.getValue("workflow_state")}</td>
                                    <td align="right"><strong>${gs.getMessage("Published")} : </strong></td>
                                    <td>${jvar_knowledgerecord.getValue("published")}</td>
                                 </tr>
                                 <tr>
                                    <td align="right"><strong>${gs.getMessage("Audience")} : </strong></td>
                                    <td>Internal</td>
                                    <td align="right"><strong>${gs.getMessage("Valid to")} : </strong></td>
                                    <td>${jvar_knowledgerecord.getValue("valid_to")}</td>
                                 </tr>
                                 <tr>
                                    <td align="right"><strong>${gs.getMessage("Author")} : </strong></td>
                                    <td>${jvar_knowledgerecord.getValue("author.name")}</td>
                                 </tr>
                                 <tr>
                                    <td align="right" valign="top"><strong>${gs.getMessage("Created")} : </strong></td>                                <td>${jvar_knowledgerecord.getValue("sys_created_on")}</td>
                                 </tr>
                                 <tr>
                                    <td align="right" valign="top" style="white-space:nowrap;"><strong>${gs.getMessage("Last Updated")} : </strong></td><td>${jvar_knowledgerecord.getValue("sys_updated_on")}</td>
                                 </tr>
                                 <tr>
                                    <td align="right"><strong>${gs.getMessage("Views")} : </strong></td>                                    
                                    <td>${jvar_knowledgerecord.getValue("sys_view_count")+1}</td>
                                    <!-- +1 done to take current view count into account -->
                                    <td></td>
                                    <td></td>
                                 </tr>
                                 <tr>
                                    <td align="right"><strong>${gs.getMessage("Used")} : </strong></td>
                                    <td>${jvar_knowledgerecord.getValue("use_count")}</td>
                                    <td></td>
                                    <td></td>
                                 </tr>
                              </tbody>
                           </table>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
         </div>
      </div>
   </div>
</j:jelly>
