<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_url" object="true">
		var velocityProcessModelDefSysID = gs.getProperty('com.snc.change_management.velocity.process_opt_project');
		var url = new ProminUtilsAJAX().getWorkBenchUrl(velocityProcessModelDefSysID);
		url;
	</g:evaluate>
	<div style ="width:100%; text-align:center; margin-top:50px">
		<a href="${jvar_url}" target="_blank" style="margin-bottom:50px; display: inline-block" rel="noopener noreferrer nofollow" >
			${gs.getMessage('Change Velocity Monitor')} 
			<span  class="icon-open-document-new-tab" style="float: right; margin-top: -2px; margin-left: 4px;"/>
		</a>
		<img style="display:block; margin:0 auto;" src="changeVelocityPO.png" alt="" width="45%" height="100%" />
	</div>
</j:jelly>
