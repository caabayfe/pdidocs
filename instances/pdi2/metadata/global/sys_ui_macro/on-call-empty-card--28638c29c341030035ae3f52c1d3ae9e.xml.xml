<div class="oc-card-empty">
	<div class="oc-card-component-empty-nobody" ng-if="!group.rota">
		<div class="groupname oc-truncate" uib-tooltip="{{group.name}}" show-tooltip-on-text-overflow="" tooltip-class="oc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="false">
			<span ng-bind-html="groupOnCallCtrl.highlight(group.name, groupOnCallCtrl.textSearch)"></span>
		</div>
		<div class="rotaname">
			<span></span>
			<span class="rotatimes"></span>
		</div>
		<div class="oc-roster-member">
			<div class="user-avatar">
				<div class="oc-card-icon-nobody">
					<i class="icon-phone oc-card-phone" />
				</div>
				<div class="user-info">
					<span class="info">
						<div class="oc-user-nobody" aria-label="{{groupOnCallCtrl.form.nobodyOnCall}}">
							{{groupOnCallCtrl.form.nobodyOnCall}}
						</div>
					</span>
				</div>
				<div style="clear: both"></div>
			</div>
		</div>
		<div class="oc-pin-action-count">
			<div class="oc-pinned pinned" ng-click="tooltipIsOpen=false; groupOnCallCtrl.togglePinned($event, group)" tabindex="0" uib-tooltip="{{groupOnCallCtrl.form.unpinOnCallSchedule}}" tooltip-placement="bottom" tooltip-is-open="tooltipIsOpen" tooltip-class="oc-pinned-tooltip" role="checkbox" ng-focus="group.showPin=true; tooltipIsOpen=true" ng-blur="group.showPin=false; tooltipIsOpen=false" ng-if="groupOnCallCtrl.isPinned(group.sys_id)" aria-label="{{groupOnCallCtrl.form.unpinOnCallSchedule}}" >
				<i class="icon-tack oc-icon-tack" />
			</div>
			
			<div class="oc-pinned unpinned" ng-click="tooltipIsOpen=false; groupOnCallCtrl.togglePinned($event, group)" tabindex="0" uib-tooltip="{{groupOnCallCtrl.form.pinOnCallSchedule}}" tooltip-placement="bottom" tooltip-is-open="tooltipIsOpen" tooltip-class="oc-pinned-tooltip" role="checkbox" ng-focus="group.showPin=true; tooltipIsOpen=true" ng-blur="group.showPin=false; tooltipIsOpen=false" aria-label="{{groupOnCallCtrl.form.pinOnCallSchedule}}" ng-if="!groupOnCallCtrl.isPinned(group.sys_id)">
				<i class="icon-tack" ng-class="group.showPin ? 'oc-icon-tack' : 'oc-icon-tack-hidden'" />
			</div>
			<div class="oc-card-actions-count" ng-if="group.actionsCount" uib-tooltip-html="'{{groupOnCallCtrl.pendingActionMsg(group.actionsCount)}}'" tooltip-class="oc-pinned-tooltip" tooltip-placement="bottom" aria-label="{{groupOnCallCtrl.pendingActionMsg(group.actionsCount)}}" tooltip-append-to-body="true">
				<span>{{group.actionsCount.gaps + group.actionsCount.oddities + group.actionsCount.timeOffRequests}}</span>
			</div>
		</div>
	</div>
</div>
