<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	
  <script language="javascript">
	  addMacroEventListeners('sysparm_simple_input')
  </script>
	
<g:evaluate var="jvar_verification_label" object="true" jelly="true">
	var resetUtil = new global.PasswordResetUtil();
	resetUtil.getVerificationLabel(jelly.sysparm_verification_id);
</g:evaluate>

  <h2 class="pwd-title" id="simple-title">${jvar_verification_label}</h2>
  <h3 class="pwd-subtitle">${gs.getMessage('Type your response in the input field')}</h3>

  <div class="form-group is-required">
    <label class="control-label" id="simple-label">
        <span class="required-marker sn-tooltip-basic"></span>
        ${gs.getMessage("This is a simple verification method. Enter 'ok' to pass, anything else will fail.")}
    </label>
    <input id="sysparm_simple_input" maxlength="256" name="sysparm_simple_input" value="" autocomplete="off" placeholder="" class="form-control pwd-form-control" type="text" oninput="clearFieldError('password_comment_${JS,HTML:sysparm_verification_id}', 'verification_forms');" required="required" aria-labelledby="simple-title simple-label"/>
  </div>
</j:jelly>
