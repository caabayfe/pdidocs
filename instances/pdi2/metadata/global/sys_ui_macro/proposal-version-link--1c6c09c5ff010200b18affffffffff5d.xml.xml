<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j2:set var="jvar_hasRef" value="$[!current.std_change_producer_version.nil()]"/>
	<j2:if test="$[jvar_hasRef]">
		<j2:set var="jvar_element_hint" value="${gs.getMessage('Version generated by this proposal')}"/>
		<j:set var="jvar_element_label" value="${gs.getMessage('Template version')}"/>
		<j2:set var="jvar_value" value="$[gs.getMessage('Version {0}', current.std_change_producer_version.version)]"/>

		<g:macro_invoke macro="snc_itsma_custom_form_field_doctype" element_id="current_std_change_template_proposal_comp" element_label="${jvar_element_label}">
			<a id="current_std_change_template_proposal_comp" class="linked"
			   href="/std_change_producer_version.do?sys_id=$[URL:current.std_change_producer_version]">
				$[jvar_value]
			</a>
		</g:macro_invoke>
		<g:macro_invoke macro="snc_itsma_custom_form_field_nondoctype" element_id="current_std_change_template_proposal_comp" element_label="${jvar_element_label}">
			<a id="current_std_change_template_proposal_comp" class="linked"
			   href="/std_change_producer_version.do?sys_id=$[URL:current.std_change_producer_version]">
				$[jvar_value]
			</a>
		</g:macro_invoke>
	</j2:if>
</j:jelly>
