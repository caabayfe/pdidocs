<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:macro
		 discard="actionDiscard()"
		 cancel="GlideDialogWindow.prototype.locate(this).destroy(); return false"
		 save="actionSave()"
		 discard_id="discard_button"
		 cancel_id="cancel_button"
		 save_id="save_button"
		 discard_type="submit"
		 cancel_type="submit"
		 save_type="submit"
	  />

	<div>
		<g:dialog_button
			 id="${jvar_discard_id}"
			 type="${jvar_discard_type}"
			 onclick="${jvar_discard}"
			 style_class="btn btn-destructive-subdued pull-left">
			 ${gs.getMessage("Don't Save")}
		</g:dialog_button>

		<g:dialog_button
			id="${jvar_save_id}"
			type="${jvar_save_type}"
			style_class="btn btn-primary pull-right"
			onclick="${jvar_save}">
			${gs.getMessage('Save')}
		</g:dialog_button>

		<g:dialog_button
			id="${jvar_cancel_id}"
			type="${jvar_cancel_type}"
			style_class="btn btn-default pull-right"
			onclick="${jvar_cancel}">
			${gs.getMessage('Cancel')}
		</g:dialog_button>

	</div>
</j:jelly>
