<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:if test="${!empty(jvar_process)}">
		<g:evaluate var="jvar_custom_footer_name" jelly="true">
			var customFooterMacroName;
			var p = new SNC.PwdProcess(jelly.jvar_process);
			if (p.exists()) {
				customFooterMacroName = p.getFooterMacroName();
			}
			customFooterMacroName;
		</g:evaluate>
		<j:if test="${!empty(jvar_custom_footer_name)}">
            <j:if test="${jvar_use_polaris &amp;&amp; jvar_show_header_footer}">
                <div class="login-card login-card-custom-footer">
			        <g:macro_invoke macro="${jvar_custom_footer_name}" stage="${jvar_stage}" />
                </div>
            </j:if>
            <j:if test="${!jvar_use_polaris &amp;&amp; jvar_show_header_footer}">
                <g:macro_invoke macro="${jvar_custom_footer_name}" stage="${jvar_stage}" />
            </j:if>
		</j:if>
    </j:if>

</j:jelly>
