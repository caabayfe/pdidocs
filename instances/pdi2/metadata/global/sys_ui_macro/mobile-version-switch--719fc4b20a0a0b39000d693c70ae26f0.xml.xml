<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g2:evaluate var="jvar_mobile_device_type" expression="session.getProperty('mobile_device_type')" />
   <j2:if test="$[jvar_mobile_device_type!='null']">
      <a id="mobile_version_switch" href="navpage.do?sysparm_device=$[jvar_mobile_device_type]&amp;sysparm_userpref.mobile_use_full.$[jvar_mobile_device_type]=false">
         <img src="images/icons/cell_phone.gifx" title="${gs.getMessage('Switch back to mobile version')}" border="0" />
      </a>
      <script>
         CustomEvent.observe('user.login', function(user) { showObjectInline(gel("mobile_version_switch")); });
      </script>
   </j2:if>
</j:jelly>
