<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_canvas">
		gs.getProperty('glide.cms.enable.responsive_grid_layout', true);
	</g:evaluate>
	<j:choose>
		<j:when test="${jvar_canvas}">
			<!-- Canvas does not care about the divs and styles, but the template still has to work well for homepages when canvas is active -->
			<table border="0" cellspacing="6" id="${jvar_name}" width="100%">
				<tr>
					<td id="dropzone1" dropzone="true" valign="top" width="40%"></td>
					<td id="dropzone2" dropzone="true" valign="top" width="40%"></td>
					<td id="dropzone5" dropzone="true" valign="top" width="20%" rowspan="2"></td>
				</tr>
				<tr>
					<td id="dropzone3" dropzone="true" valign="top" width="40%"></td>
					<td id="dropzone4" dropzone="true" valign="top" width="40%"></td>
				</tr>
			</table>
			<style>
				#dropzone5 {
					border-left: 1px solid lightgrey;
				}
			</style>
		</j:when>
		<j:otherwise>
			<g:layout_data_quality_no_canvas />
		</j:otherwise>
	</j:choose>
</j:jelly>
