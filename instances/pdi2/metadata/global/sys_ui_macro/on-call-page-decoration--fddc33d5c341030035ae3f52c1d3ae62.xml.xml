<div>
	<div ng-if="!groupOnCallCtrl.isLoading &amp;&amp; groupOnCallCtrl.textSearch != '' &amp;&amp; !groupOnCallCtrl.foundGroups()" class="oc-search-results" >
		{{groupOnCallCtrl.form.noResultsFound}}
	</div>
	<div ng-if="groupOnCallCtrl.isLoading" class="oc-loading-msg-container">
		<div class="oc-splash-msg">{{groupOnCallCtrl.form.loading}}</div>
	</div>
	<div ng-if="groupOnCallCtrl.showLimitReachedMessage()" class="oc-limit-msg-container">
		<div class="oc-splash-msg">{{groupOnCallCtrl.form.limitReachedMsg}}</div>
	</div>
</div>
