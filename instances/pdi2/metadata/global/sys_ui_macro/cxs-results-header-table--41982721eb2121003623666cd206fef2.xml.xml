<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate jelly="true">
		var ariaPresentation = "presentation";
		var ariaExpanded = true;
		if (jelly.jvar_minimized)
			ariaExpanded = false;
	</g:evaluate>
    <g:evaluate var="jvar_is_doctype" expression="GlideMobileExtensions.getDeviceType() == 'doctype'"/>
    <table id="cxs_results_header" class="cxs_results_header wide" cellspacing="0" role = "${ariaPresentation}">
        <tbody>
            <tr>
                <td class="horizontal-rule">
                    <hr role = "${ariaPresentation}" />
                </td>
                <td class="header-button">
                    <j:choose>
                        <j:when test="${jvar_is_doctype}">
                        	<g:evaluate jelly="true">								
					var currentIcon = jelly.jvar_expanded_class;
                        		if (jelly.jvar_minimized)
						currentIcon = jelly.jvar_collapsed_class + " " + jelly.jvar_collapsed_spacer_class;
                        	</g:evaluate>
                            <button class="btn btn-default disabled" id="cxs_maximize_results" aria-expanded = "${ariaExpanded}" onclick="cxs_onToggleResults(this); return false;">
                                ${jvar_results_header_text}${SP}<i class="${currentIcon}" aria-hidden = "true"></i>
                            </button>
                           
                        </j:when>
                        <j:otherwise>
                            <g:set_if var="jvar_header_icon" test="${jvar_minimized == 'true'}" true="images/drop_down_arrow.gifx" false="images/drop_down_arrow.gifx" />
                            <button class="disabled" id="cxs_maximize_results" aria-expanded = "${ariaExpanded}" disabled="disabled">
                                ${jvar_results_header_text}
                            </button>
                        </j:otherwise>
                    </j:choose>
                </td>
                <td class="horizontal-rule">
                    <hr  role = "${ariaPresentation}" />
                </td>
            </tr>
        </tbody>
    </table>
</j:jelly>
