<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	
  <script language="javascript">
	  addMacroEventListeners('sysparm_pers_reply_${JS,HTML:sysparm_verification_id}_1');
  </script>

  <g:evaluate var="jvar_personal_data_label" object="true" jelly="true">
    var paramValue = new global.PwdCommonVerificationHandler().getPersonalDataLabel(jelly.sysparm_verification_id);
    gs.getMessage('Ask the user to provide their: {0}', [paramValue]);
  </g:evaluate>

  <g:evaluate var="jvar_personal_data_answer" object="true" jelly="true">
    var valueFromDB = new global.PwdCommonVerificationHandler().getPersonalDataConfirmationAnswer(jelly.sysparm_verification_id);
    gs.getMessage('The answer should be: {0}', [valueFromDB]);
  </g:evaluate>
	
<g:evaluate var="jvar_verification_label" object="true" jelly="true">
	var resetUtil = new global.PasswordResetUtil();
	resetUtil.getVerificationLabel(jelly.sysparm_verification_id);
</g:evaluate>

  <h2 class="pwd-title" id="personal-data-title">${jvar_verification_label}</h2>
  <h3 class="pwd-subtitle" id="presonal-data-sub-title">${jvar_personal_data_label}</h3>

  <div class="form-group is-required">
    <fieldset>
      <label for="field5" class="control-label" id="label_answer">	
         ${jvar_personal_data_answer}	         
      </label>

      <div>
        <span class="input-group-radio">
          <input id="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}_1" class="radio" type="radio" name="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}" value="accept" aria-describedby="personal-data-title presonal-data-sub-title label_answer">
            <label for="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}_1" class="radio-label" aria-label="${gs.getMessage('Accept answer')}" >
              ${gs.getMessage('Accept')}</label>
          </input>
        </span>

        <span class="input-group-radio">
          <input id="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}_2" class="radio" type="radio" name="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}" value="reject" aria-describedby="personal-data-title presonal-data-sub-title label_answer">
            <label for="sysparm_pers_reply_${JS,HTML:sysparm_verification_id}_2" class="radio-label" aria-label="${gs.getMessage('Reject answer')}">
              ${gs.getMessage('Reject')}</label> 
          </input>
        </span>
      </div>
    
    </fieldset>
  </div>
</j:jelly>
