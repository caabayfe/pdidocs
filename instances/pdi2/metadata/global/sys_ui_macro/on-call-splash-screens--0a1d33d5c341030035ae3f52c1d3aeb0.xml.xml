<div>
	<div ng-if="groupOnCallCtrl.showPinnedSplashMsg" class="oc-splash-msg-container">
		<div class="oc-splash-msg-card">
			<div class="oc-splash-icon-container">
				<div class="oc-splash-icon">
					<i class="icon-tack oc-splash-tack" />
				</div>
			</div>
			<div class="oc-splash-title">{{groupOnCallCtrl.form.pinnedOnCallSchedulesTitle}}</div>
			<div class="oc-splash-msg">{{groupOnCallCtrl.form.pinnedDesc}}</div>
		</div>
	</div>
	<div ng-if="groupOnCallCtrl.showManageBelongSplashMsg" class="oc-splash-msg-container">
		<div class="oc-splash-msg-card">
			<div class="oc-splash-icon-container">
				<div class="oc-splash-icon">
					<i class="icon-calendar oc-splash-calendar" />
				</div>
			</div>
			<div class="oc-splash-title">{{groupOnCallCtrl.form.myOnCallSchedules}}</div>
			<div class="oc-splash-msg">{{groupOnCallCtrl.form.manageBelongDesc}}</div>
		</div>
	</div>
	<div ng-if="groupOnCallCtrl.showAllSplashMsg" class="oc-splash-msg-container">
		<div class="oc-splash-msg-card">
			<div class="oc-splash-icon-container">
				<div class="oc-splash-icon">
					<i class="icon-calendar oc-splash-calendar" />
				</div>
			</div>
			<div class="oc-splash-title">{{groupOnCallCtrl.form.allOnCallSchedules}}</div>
			<div class="oc-splash-msg">{{groupOnCallCtrl.form.allOnCallSchedulesDesc}}</div>
		</div>
	</div>
</div>
