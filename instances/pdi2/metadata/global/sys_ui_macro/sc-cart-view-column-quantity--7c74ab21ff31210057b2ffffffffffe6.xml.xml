<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate jelly="true" var="showQuantity">
		var showQuantity = !(jelly.jvar_cat_item.getType() == "sc_cat_item_producer");
		showQuantity;
	</g:evaluate>
	<j:if test="${showQuantity}"> ${jvar_cart_item.getDisplayCartQuantity()} </j:if>
	<j:if test="${!showQuantity}"> - </j:if>
</j:jelly>
