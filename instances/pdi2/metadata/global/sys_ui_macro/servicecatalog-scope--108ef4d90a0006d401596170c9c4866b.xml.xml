<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	
	<g:evaluate jelly="true">
		var scope = new GlideRecord(jelly.jvar_table);
		scope.addQuery('cmdb_ci_service', jelly.jvar_service);
		scope.orderBy('service_scope.name');
		scope.query();
	</g:evaluate>
	<j:if test="${scope.hasNext()}">
		<div class="catalog_specs_header">${scope.sys_meta.label}</div>
		<ul>
			<j:while test="${scope.next()}">
				<li>
					<span 
						onmousemove="g_popup_manager.enqueue(event, '${scope.service_scope}', 'service_scope_pop.do', 'sysparm_sys_id=${scope.service_scope}', 600)" 
						onmouseout="lockPopup(event)">
						${scope.service_scope.name}
					</span>
				</li>
			</j:while>
		</ul>
	</j:if>
	
</j:jelly>
