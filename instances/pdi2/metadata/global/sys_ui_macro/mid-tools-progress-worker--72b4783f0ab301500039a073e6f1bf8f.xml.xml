<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <span id="MIDToolProgress"></span>

   <stages id="mystages" style="display: none;">
       <stage>
           <name>Sending message to MID Server</name>
           <complete_condition>
               ${jvar_ecc_queue_id}
           </complete_condition>
       </stage>
       <stage>
           <name>Running MID server script</name>
           <complete_condition>
               ${jvar_ecc_queue_id}
           </complete_condition>
           <oncomplete>
               window.location = 'mid_tools_result.do';
           </oncomplete>
       </stage>
   </stages>

   <g:include_script src="AJAXProgress.jsdbx"/>
   <script>
       var ajp = new AJAXProgress('MIDToolProgress', 'mystages');
       ajp.start();
   </script>
</j:jelly>
