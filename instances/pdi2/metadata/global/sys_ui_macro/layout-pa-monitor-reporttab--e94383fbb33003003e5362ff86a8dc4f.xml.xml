<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
		<!-- The following table isn't actually displayed but only used to
		convert widget position to Canvas coordinates.
		The Canvas is a 12 column responsive grid layout.
		-->
		<div id="dropzones_container">
			<div id="content_wrapper">
				<table id="${jvar_name}" border="0" cellspacing="4" width="100%">
					<tr>
						<td id="dropzone1" dropzone="true" width="50%" colspan="2"/>
						<td id="dropzone2" dropzone="true" width="50%" colspan="2"/>
					</tr>
					<tr>
						<td id="dropzone3" dropzone="true" width="50%" colspan="2"/>
						<td id="dropzone4" dropzone="true" width="50%" colspan="2"/>
					</tr>
				</table>
			</div>
		</div>
</j:jelly>
