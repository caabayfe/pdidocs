<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:function verification_id="REQUIRED" />
	<!-- 
	Print out the verification name
	-->
	<g:evaluate var="jvar_title" jelly="true" >
		var verificationName 
			= new SNC.PwdVerificationManager().getVerificationLabelByVerificationId(jelly.jvar_verification_id);

		gs.getMessage('Enrollment for {0}',verificationName);
	</g:evaluate>
	<div class="caption" id="caption_${jvar_verification_id}">${jvar_title}</div>
</j:jelly>
