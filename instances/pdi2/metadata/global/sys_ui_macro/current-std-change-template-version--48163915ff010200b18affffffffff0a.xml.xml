<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j2:set var="jvar_element_hint" value="${gs.getMessage('Current version number')}"/>
	<j:set var="jvar_element_label" value="${gs.getMessage('Current version')}"/>
	<g2:evaluate var="jvar_value" jelly="true">
		var str = '';
		var gr = current;
		if (!gr.current_version.nil()) {
			var version = gr.current_version.version;
			var isRetired = gr.current_version.std_change_proposal.proposal_type == 3;
			str = gs.getMessage('Version {0}', version);
			if (isRetired) {
				str = gs.getMessage("Version {0} '(Retired)'", version);
			}
		}
		str;
	</g2:evaluate>
	<g:macro_invoke macro="snc_itsma_custom_form_field_doctype" element_id="current_std_change_template_version_comp" element_label="${jvar_element_label}">
		<a id="current_std_change_template_version_comp" class="linked"
		   href="/std_change_producer_version.do?sys_id=$[URL:current.current_version]">
			$[jvar_value]
		</a>
	</g:macro_invoke>
	<g:macro_invoke macro="snc_itsma_custom_form_field_nondoctype" element_id="current_std_change_template_version_comp" element_label="${jvar_element_label}">
		<a id="current_std_change_template_version_comp" class="linked"
		   href="/std_change_producer_version.do?sys_id=$[URL:current.current_version]">
			$[jvar_value]
		</a>
	</g:macro_invoke>
</j:jelly>
