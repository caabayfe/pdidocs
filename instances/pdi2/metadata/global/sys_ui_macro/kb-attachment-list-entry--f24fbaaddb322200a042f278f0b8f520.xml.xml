<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g:macro show_link="false"/>
   <j:forEach var="jvar_attachmentObj" items="${jvar_attachments}">
     <g:evaluate var="jvar_attachment" jelly="true" expression="var sys_attachment = new GlideRecord('sys_attachment'); sys_attachment.get(jelly.jvar_attachmentObj.sys_id);"/>
     <div style="margin-top: 1em; margin-left: 3em;"><g:attachment_entry show_link="${jvar_show_link}"/></div>
	   <j:if test="${!empty(jvar_attachmentObj.terms)}">
	   <div style="margin-left: 3em;"><g:no_escape>${jvar_attachmentObj.terms}</g:no_escape></div>
	   </j:if>
	</j:forEach>
</j:jelly>
