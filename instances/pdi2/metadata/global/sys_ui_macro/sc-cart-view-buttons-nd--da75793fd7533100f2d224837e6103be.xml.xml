<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate jelly="true">
        var continueShoppingAction = GlideappCatalogURLGenerator.getContinueShoppingAction(jelly.sysparm_catalog, jelly.sysparm_catalog_view);
        var restartGuideUrl = GlideappCatalogURLGenerator.getRestartGuideURL(jelly.sysparm_catalog, jelly.sysparm_catalog_view, gs.getSessionToken());
        var describeNeedsButtonOnClickAction = "location.assign('" + restartGuideUrl + "'); return false;";
        var showChooseOptionsButton = jelly.jvar_sc_choose_options_button;
        if (jelly.sysparm_guide != 'true')
            showChooseOptionsButton = 'false';
    </g:evaluate>
    <div class="catalog_button_container" style="height: 40px; padding-left: 10px;">
        <j:if test="${jvar_sc_checkout_button == 'true' and jvar_cart.isEmpty() != 'true'}">
            <g:sc_button img="" classes="request_catalog_button header_button sc_float_right" id="header_button_checkout_in_footer" onclick="checkout(this, forms['sc_cart.do']);" label="${jvar_sc_checkout_label}" title="${jvar_sc_checkout_label}" isPrimary="true"/>
        </j:if>
        <j:if test="${jvar_sc_continue_shopping_button == 'true'}">
            <g:sc_button img="" classes="request_catalog_button header_button" id="header_button_continue_shopping_in_footer" onclick="${continueShoppingAction}" label="${jvar_sc_continue_shopping_label}" title="${jvar_sc_continue_shopping_label}"/>
        </j:if>
         <j:if test="${showChooseOptionsButton == 'true'}">
            <g:sc_button img="" classes="request_catalog_button header_button" id="describe_needs" onclick="${describeNeedsButtonOnClickAction}" label="${jvar_sc_choose_options_label}" title="${jvar_sc_choose_options_label}" isPrimary="true"/>
         </j:if>
    </div>
</j:jelly>
