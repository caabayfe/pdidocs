<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<div class="snc-article-hidden-fields" aria-hidden="true" >
    <input id="articleId" type="hidden"  value="${knowledgeRecord.sys_id}" />
	<input type="hidden" aria-hidden="true" id="ts_queryId" value="${tsQueryId}" />
    <input id="articleWorkflowState" type="hidden" value="${knowledgeRecord.workflow_state}" />
    <input id="articleTitleTemplate" type="hidden" value="${kbViewInfo.articleTitleTemplate}"/>
    <input id="articleTemplate" type="hidden" value="${kbViewInfo.articleTemplate}"/>
    <input id="articleTitleOld" type="hidden" value="$[JS:gs.nil(knowledgeRecord.short_description) ? kbViewInfo.wikiLinkText : knowledgeRecord.short_description]" />
    <input id="articleOriginal" type="hidden" value="$[NS:kbViewInfo.articleType == 'wiki' ? knowledgeRecord.wiki : knowledgeRecord.text]" />
    <input id="articleTextType" type="hidden" value="${NS:kbViewInfo.articleType}" />
	<textarea id="articleWikiText" style="display:none" aria-label="${gs.getMessage('Article wiki text')}" >
		${NS:knowledgeRecord.wiki.getTextAreaDisplayValue()}
	</textarea>
    <input id="articleInPopUp" type="hidden" value="${kbViewInfo.isInPopup}" />
    <input id="articleDirty" type="hidden" value="${kbViewInfo.dirtyFormMessage}" />
    <input id="articleIsNew" type="hidden" value="${kbViewInfo.isNewRecord}" />
    <input id="articleModified" type="hidden" value="false" />
    <input id="articleEditMode" type="hidden" value="false" />
	<input id="articleVersion" type="hidden" value="${kbViewInfo.knowledgeBaseVersion}" />
    <input id="articleDisplayAttachments" type="hidden" value="${knowledgeRecord.display_attachments}" />
    <input id="articleShowKBCreateIncident" type="hidden" value="${kbViewInfo.showKBCreateIncident}" />
    <input id="articleVersioningInstalled" type="hidden" value="${kbViewInfo.versioningInfo.isInstalled}" />
    <input id="articleKnowledgeBase" type="hidden" value="${knowledgeRecord.kb_knowledge_base}" />
    <input id="articleKnowledgeBaseName" type="hidden" value="${knowledgeRecord.kb_knowledge_base.getDisplayValue()}" />
	<input id="articleNumber" type="hidden" value="${knowledgeRecord.number}" />
	<j2:if test="$[kbViewInfo.showKBCreateIncident]">
		<input id="createIncidentLinkLocation" type="hidden" value="${ALLOW_JELLY:gs.getProperty('glide.knowman.create_incident_link')}"/>
	</j2:if>
	<input id="attachFields" type="hidden" value="${gs.getProperty('glide.knowman.attach.fields')}"/>
	<input id="canShowKBFeedback" type="hidden" value="${kbViewInfo.showKBFeedback}" />
    <input id="isLiveFeedEnabled" type="hidden" value="${kbViewInfo.isLiveFeedEnabled}" />
</div>
</j:jelly>
