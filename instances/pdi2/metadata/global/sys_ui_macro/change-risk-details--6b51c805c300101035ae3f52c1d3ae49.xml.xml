<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g2:evaluate var="jvar_showChangeRiskDetailsButton">
		var riskHelper = new global.ChangeRiskDetailsHelper();
		var answer = riskHelper.showDetailsButton(current);
		answer;
	</g2:evaluate>
	<j2:if test="$[jvar_showChangeRiskDetailsButton]">
		<button id="chg_risk_details_button" disabled="true" onclick="toggleRiskDetails(event);" name="change_risk_details"
			class="icon-info icon btn btn-default" title="${gs.getMessage('View details')}" aria-label="${gs.getMessage('View details')}" />
		<script>
			addLateLoadEvent(function() {
				if (!window.nowapi)
					ScriptLoader.getScripts('scripts/classes/nowapi/ui/GlidePopup.js', function() {});
				ScriptLoader.getScripts('RiskAssessmentResults.jsdbx', function() {
					$j("#chg_risk_details_button").prop("disabled", false);
				}); 
			});
		</script>
	</j2:if>
</j:jelly>
