<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:if test="${jvar_sc_intro_text == 'true' and jvar_cart.isEmpty() != 'true'}">
		<g:evaluate var="intro_text" jelly="true">
			var title = gs.getMessage(jelly.jvar_title);
			var intro_text = gs.getMessage("Items currently added to {0}", title);
			intro_text;
		</g:evaluate>
        <div id="sc_cart_view_intro_text">
            ${intro_text}
        </div>
        <br />
    </j:if>
</j:jelly>
