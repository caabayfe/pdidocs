<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:set var="jvar_search_label" value="${gs.getMessage('Search')}"/>

	<label for="sysparm_search" class="sr-only">
		${jvar_search_label}
	</label>
	<div class="input-group-transparent">
		<span class="input-group-addon-transparent icon-search"></span>
		<input size="${jvar_size}"
			id="sysparm_search" 
			name="sysparm_search" 
			autocomplete="off"
			class="form-control form-control-search" 
			type="search"
			onfocus="this.select();this.style.color = '#000';if (!this.ac) { addLoadEvent(function() {var e = $('sysparm_search'); if (!e.ac) new AJAXTextSearchCompleter('global_search_completer', 'sysparm_search', 'right', $$('span.globalSearch')[0]);}) } else this.ac.cacheClear();"
			accesskey="s"
			onkeydown="return acReferenceKeyDown(this, event);"
			onkeypress="return acReferenceKeyPress(this, event);"
			onkeyup="return acReferenceKeyUp(this, event);"
			function="$('textsearch').submit()" 
			title="${jvar_search_label}" alt="${jvar_search_label}"
			placeholder="${gs.getMessage('Search')}" />
			<span class="input-group-addon-transparent input-group-addon-pull-right icon-vcr-down recent-searches" tabindex="0" onkeypress="contextShow(event, 'search', 200, grabOffsetTop(this) + 20, 0, grabOffsetLeft(this) + 12);event.cancelBubble=true;" onclick="contextShow(event, 'search', 200, grabOffsetTop(this) + 20, 0, grabOffsetLeft(this) + 12);event.cancelBubble=true;" title="${gs.getMessage('Recent searches')}"></span>
			<span class="sr-only">
				${gs.getMessage('Recent searches')}
			</span>
	</div>
	
</j:jelly>
