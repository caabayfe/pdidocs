<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide">

<j:set var="jvar_line" value="${!jvar_line}" />

	<j:set var="jvar_trclass" value="even" />
		<j:if test="${jvar_line}">
		<j:set var="jvar_trclass" value="odd" />
		</j:if>
	<tr class="${jvar_trclass}" >
		<g:insert/>


	</tr>

</j:jelly>
