<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<form>
		<g:ui_table>
			<g:messages>
				Saving
				Reloading
			</g:messages>
				<tr>
					<td colspan="4">
						<g:ui_slushbucket up_down="true"/>
					</td>
				</tr>
				<tr>
					<td colspan="4">
						<g:ui_spacer pixels="6"/>
						<g:ui_checkbox name="wrap" id="wrap" class="checkbox_list_mechanic"/>
						<label class="label_list_mechanic" for="ni.wrap"> ${gs.getMessage('Wrap column text')} </label>
	
						<g:ui_spacer pixels="6"/>
						<g:ui_checkbox name="compact" id="compact" class="checkbox_list_mechanic"/>
						<label class="label_list_mechanic" for="ni.compact"> ${gs.getMessage('Compact rows')} </label>
	
						<g:ui_spacer pixels="6"/>
						<g:ui_checkbox name="highlighting" id="highlighting" class="checkbox_list_mechanic"/>
						<label class="label_list_mechanic" for="ni.highlighting" id="list_highlighting" name="list_highlighting"> ${gs.getMessage('Enable list highlighting')} </label>
	
						<g:ui_spacer pixels="6"/>
						<g:ui_checkbox name="field_style_circles" id="field_style_circles" class="checkbox_list_mechanic"/>
						<label class="label_list_mechanic" for="ni.field_style_circles" id="list_highlighting" name="field_style_circles"> ${gs.getMessage('Modern cell coloring')} </label>
	
					</td>
				</tr>
	
				<j:if test="${gs.getProperty('glide.ui.list_edit', 'true')}">
					<tr>
						<td colspan="4">
							<g:ui_spacer pixels="6"/>
							<g:ui_checkbox name="list_edit_enable" id="list_edit_enable" class="checkbox_list_mechanic"/>
							<label class="label_list_mechanic" for="ni.list_edit_enable"> ${gs.getMessage('Enable list edit')} </label>
							<g:ui_spacer pixels="6"/>
							<g:ui_checkbox name="list_edit_double" id="list_edit_double" class="checkbox_list_mechanic"/>
							<label class="label_list_mechanic" for="ni.list_edit_double"> ${gs.getMessage('Double click to edit')} </label>
						</td>
					</tr>
				</j:if>
			<tr>
				<td class="status_msg_update">
					<button id="reset_column_defaults" class="btn btn-default" disabled="true" onclick="actionOK(true)" type="submit">${gs.getMessage('Reset to column defaults')}</button>
				</td>
				<td class="text-align-right">
					<g:dialog_buttons_ok_cancel/>
				</td>
			</tr>
		</g:ui_table>
	</form>
</j:jelly>
