<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">	
	<g:evaluate>
		var gr = new GlideRecord('sys_db_object');
		gr.addQuery('name', '${jvar_table}');
		gr.query();
		gr.next();
	</g:evaluate>		
	<div class="card"
		 onclick="redirectToServiceForm('${jvar_table}')" 
		 tabindex="0">
		<div class="card-title">
			<h3>${gr.label}</h3>
		</div>
		<p>${jvar_subtext}</p>
	</div>
</j:jelly>
