<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:set var="jvar_isDoctype" value="${GlideMobileExtensions.getDeviceType()}" />
	<g:macro
		dialog_id=""
		label_style="width: 15%; position: relative;"
		field_style="width: 85%; position: relative; float: left;"
		textarea_id="note_text"
		textarea_label=""
		textarea_label_title=""
		textarea_name="note_text"
		textarea_onkeyup="enableButton()"
		textarea_onchange="enableButton()"
		textarea_style="height:auto; width: 100%; resize: vertical;"
		textarea_title=""
		ok_action=""
		ok="actionOK()"
		cancel="(window.GlideDialogWindow || window.GlideModalForm).prototype.locate(this).destroy(); return false"
		ok_id="ok_button"
		cancel_id="cancel_button" 
		ok_type="submit" 
		cancel_type="submit"
		ok_text="${gs.getMessage('OK')}"
		cancel_text="${gs.getMessage('Cancel')}"
		ok_title=""
		cancel_title=""
		ok_style_class="btn btn-primary"
		cancel_style_class="btn btn-default" />
	<j:if test="${jvar_isDoctype == 'doctype'}">
		<g:dialog_notes_ok_cancel_doctype />
	</j:if>
	<j:if test="${jvar_isDoctype != 'doctype'}">
		<g:dialog_notes_ok_cancel_nondoctype />
	</j:if>	
</j:jelly>
