<?xml version="1.0" encoding="utf-8" ?>

<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  
  <!--  
  Include UI script 
  Let's keep the same name as this macro. 
  -->
  <g:include_script src="pwd_enroll_sample_ui.jsdbx" />
  
  <script type="text/javascript">
        
    // When the page gets loaded, run the event handler for on-load event.
    addLoadEvent(
        function() { 
            mysample_on_load('${jvar_form_id}');
        }
    );
    
    // When the page gets loaded, register the event handler for on-submit event for the form.
    addSubmitEvent(
        function() { 
            return mysample_on_submit('${jvar_form_id}');
        }, '${jvar_form_id}'
    );
  </script>
  
  <span class="pwd-section-subtitle">${gs.getMessage("Type 'ok' in the input field to enroll")}</span>

  <div class="form-group is-required">
    <label for="sample_input" class="control-label col-sm-3">
      <span class="required-marker sn-tooltip-basic" title="${gs.getMessage('Required')}" data-original-title="${gs.getMessage('Required')}" aria-label="${gs.getMessage('Required')}"></span>
      ${gs.getMessage("Input")}
    </label>
    <span class="col-sm-9">
      <input id="sample_input" name="sample_input" placeholder="ok" class="form-control pwd-form-control" required="required" type="text" aria-required="true"/>
    </span>
  </div>
  <br/>
  <input type="hidden" name="mandatory" value="${jvar_mandatory}" />
  <input type="hidden" name="verificationId" value="${jvar_verification_id}" />

</j:jelly>
