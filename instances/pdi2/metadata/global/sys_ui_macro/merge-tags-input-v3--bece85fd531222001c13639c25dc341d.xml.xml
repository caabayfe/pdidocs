<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:ui_form onsubmit="return invokePromptCallBack('ok');">
		<div ng-controller="mergeTags">
			<div class="col-sm-12">
				<sn-reference-picker field="field" id="target_tag" sn-options="{placeholder: '${JS:gs.getMessage('Select')}'}"
								ed="{reference: 'label', qualifier: 'owner=javascript:gs.getUserID()'}"/>
			</div>
			<div class="modal-footer">
				<button type="button" ng-click="submitAction('ok')" class="btn btn-primary">${gs.getMessage('Merge')}</button>
				<button type="button" ng-click="submitAction('cancel')" class="btn btn-default">${gs.getMessage('Cancel')}</button>
			</div>
		</div>
	</g:ui_form>
</j:jelly>
