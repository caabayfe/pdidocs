<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="jelly:core" xmlns:g2="glide">
	<g2:macro data=""/>
	<g2:evaluate jelly="true">
		data = JSON.parse(jelly.jvar_data);
	</g2:evaluate>
	<div class="search-box">
		<span class="icon-filter"/>
		<input class="search-input" ng-class="$[data.table]?'search-filled':'empty-search'" placeholder="$[data.placeholder]" aria-label="$[data.placeholder]" type="search" autocomplete="off" ng-model="$[data.table]" ng-change="deselect('$[data.table]')"/>
		<a href="javascript:void(0)" ng-if="$[data.table]" class="icon-cross-circle clear-search" ng-click="clearSearch('$[data.table]')"/>
	</div>
	<div class="search-results-scroll">
		<ul class="scroll-section" ng-if="$[data.list]">
			<li class="search-result" aria-current="{{$[data.selectedElement]===item.value? 'page' : false}}" role="link" tabindex="0" ng-click="$[data.click](item.value)" ng-class="{selected: $[data.selectedElement]===item.value}" ng-repeat="item in $[data.list] | $[data.filter]">
				<span class="result-text" value="{{item.value}}">{{item.name}}</span>
				<i class="icon-loading" ng-if="($[data.selectedElement]===item.value) $[AND] $[data.isLoading]"/>
			</li>
		</ul>
	</div>
</j:jelly>
