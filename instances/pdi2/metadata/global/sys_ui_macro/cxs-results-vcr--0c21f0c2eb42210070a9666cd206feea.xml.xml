<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<g:evaluate>
	var tabIndex = -1;
	if(GlideAccessibility.isEnabled())
		tabIndex = 0;
	var ariaLabelNextPage = gs.getMessage("Shows next results page");
	var ariaLabelPreviousPage = gs.getMessage("Shows Previous results page");
	var ariaLabelFirstPage = gs.getMessage("Shows First results page");
	var ariaButton = "button";
</g:evaluate>
  <j:set var="jvar_unique_id" value="cxs_results" />
  <g:inline template="dir_checker.xml"/>

  <j:if test="${GlideMobileExtensions.getDeviceType() != 'doctype'}">
    <span id="${jvar_unique_id}_vcr" style="display: none;">
    
       <img id="${jvar_unique_id}_first"
            name="vcr_first"
            data-nav="true"
            src="images/vcr_first_dis.gifx?v=2"
            class="list_nav ${jvar_list_css} i16x16 h_flip_content" 
            title="${gs.getMessage('First page')}" alt="${gs.getMessage('First page')}"
            tabindex = "${tabIndex}" role = "${ariaButton}" aria-label = "${ariaLabelFirstPage}" />

       <img id="${jvar_unique_id}_back"
            data-nav="true"
            name="vcr_back"
            src="images/vcr_back_dis.gifx?v=2"
            class="list_nav ${jvar_list_css} i16x16 h_flip_content" 
            title="${gs.getMessage('Previous page')}" alt = "${gs.getMessage('Previous page')}"
            tabindex = "${tabIndex}" role = "${ariaButton}" aria-label = "${ariaLabelPreviousPage}" />
        <j:choose>
          <j:when test="${jvar_text_direction == 'rtl'}">
            <!-- For RTL Pagination -->
            <span dir="rtl" class="list_nav_vcr list_row_number_input ${jvar_list_css}">
                 <span id="${jvar_unique_id}_first_row" style="margin-left: 1px; margin-right: 1px">0</span>
                 &#8207;
                 ${gs.getMessage('to_lower')}
                 &#8207;
                 <span id="${jvar_unique_id}_last_row" style="margin-left: 1px; margin-right: 1px">0</span>
            </span>
           </j:when>
          <j:otherwise>
            <!-- For LTR Pagination -->  
            <span style="margin-left: 5px;" class="list_nav_vcr list_row_number_input ${jvar_list_css}">
                 <span id="${jvar_unique_id}_first_row" style="margin-left: 1px; margin-right: 1px">0</span>
                 ${gs.getMessage('to_lower')}
                 <span id="${jvar_unique_id}_last_row" style="margin-left: 1px; margin-right: 1px">0</span>
            </span>
           </j:otherwise>
        </j:choose> 
        <img id="${jvar_unique_id}_next"
             data-nav="true"
             name="vcr_next"
             src="images/vcr_forward_dis.gifx?v=2"
             class="list_nav ${jvar_list_css} i16x16 h_flip_content" 
             title="${gs.getMessage('Next page')}"
             tabindex = "${tabIndex}" role = "${ariaButton}" aria-label = "${ariaLabelNextPage}" />

    </span>
  </j:if>
  <j:if test="${GlideMobileExtensions.getDeviceType() == 'doctype'}">
    <span id="${jvar_unique_id}_vcr" style="display: none;">
        <button id="${jvar_unique_id}_first" title="${gs.getMessage('First page')}" name="vcr_first" data-nav="true" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content cxs_nav_button" aria-label = "${ariaLabelFirstPage}">
            <span class="icon-vcr-left" aria-hidden = "true"></span>
            <span class="icon-vcr-left" aria-hidden = "true"></span>
        </button>
        <button id="${jvar_unique_id}_back" title="${gs.getMessage('Previous page')}" name="vcr_back" data-nav="true" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content cxs_nav_button" aria-label = "${ariaLabelPreviousPage}">
            <span class="icon-vcr-left" aria-hidden = "true"></span>
        </button>
        <div class="vcr_controls" style="min-width: 6em; text-align: center; display: inline-block;">
            <j:choose>
                <j:when test="${jvar_text_direction == 'rtl'}">
                    <!-- For RTL Pagination -->
                    <span dir="rtl" class=" list_row_number_input ${jvar_list_css}">
                        <span id="${jvar_unique_id}_first_row" style="margin-left: 1px; margin-right: 1px">0</span>
                        &#8207;
                        ${gs.getMessage('to_lower')}
                        &#8207;
                        <span id="${jvar_unique_id}_last_row" style="margin-left: 1px; margin-right: 1px">0</span>
                    </span>
                </j:when>
                <j:otherwise>
                    <!-- For LTR Pagination -->
                    <span style="margin-left: 5px;" class=" list_row_number_input ${jvar_list_css}">
                        <span id="${jvar_unique_id}_first_row" style="margin-left: 1px; margin-right: 1px">0</span>
                        ${gs.getMessage('to_lower')}
                        <span id="${jvar_unique_id}_last_row" style="margin-left: 1px; margin-right: 1px">0</span>
                    </span>
                </j:otherwise>
            </j:choose>
        </div>
        <button id="${jvar_unique_id}_next" title="${gs.getMessage('Next page')}" name="vcr_next" data-nav="true" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content cxs_nav_button" aria-label = "${ariaLabelNextPage}">
            <span class="icon-vcr-right" aria-hidden = "true"></span>
        </button>
    </span>
  </j:if>
</j:jelly>
