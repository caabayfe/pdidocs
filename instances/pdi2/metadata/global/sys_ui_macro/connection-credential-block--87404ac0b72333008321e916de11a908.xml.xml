<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<style type="text/css">
		.h2heading {
			font-weight: bold;
		    font-size:18px;
		}
		
		.required-padding {
			padding: 0 8px;
		}
		
		.required-field {
            color: #c83c36;
		}
		
		.field-bottom-padding {
			padding-bottom: 8px;
		}
	</style>
	<g:evaluate var="jvar_fields" object="true" jelly="true">
		var fields = [];
        if(!gs.nil(jelly.jvar_fields_json)){
           fields = JSON.parse(jelly.jvar_fields_json);
        }
		
        fields;
	</g:evaluate>
	<j:if test="${jvar_fields.length > 0}">
   		<div class="row" id="${jvar_name}">
			<h2 class="h2heading">${jvar_message}</h2>
			<j:forEach var="jvar_field" items="${jvar_fields}">
				<g:cc_field cc_field="${jvar_field}" cc_prefix="" />
			</j:forEach>
		<br/><br/>
		</div>
	</j:if>
	
</j:jelly>
