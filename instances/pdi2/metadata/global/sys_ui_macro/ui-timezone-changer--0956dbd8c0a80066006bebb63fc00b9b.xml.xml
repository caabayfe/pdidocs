<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  <!-- Add a timezone changer -->
  <script language="javascript" src="scripts/timezone_change_support.jsx?v=${gs.getProperty('glide.builddate')}"/>
    <span id="timezone_changer">
        <label for="timezone_changer_select">${gs.getMessage("Time Zone")}:</label>$[SP]
        <SELECT id="timezone_changer_select" name="timezone_changer_select" onchange="tz.changeTimeZone();">
            <option value="">${gs.getMessage("Loading...")}</option>
        </SELECT>
        <span style="margin-left:2px" />
        <a title="${gs.getMessage('Reset to default Time zone')}" onclick="tz.getDefaultTimeZone();return false;">
			<img width="16" height="16" src="images/icons/refresh.gifx" alt="${gs.getMessage('Reset to default Time zone')}" />
        </a>
        <script language="javascript">
            tz = new TimeZoneChanger("timezone_changer");
        </script>
    </span>
</j:jelly>
