<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<div id="versions-list" class="collapse snc-article-versions-history-list">
			<g2:evaluate>
				var i=0;
				var length = versioningInfo.history.length;
			</g2:evaluate>
			<j2:while test="$[i &lt;length]">
				<g2:evaluate>
					var versionObj = versioningInfo.history[i];
					i = i+1;
				</g2:evaluate>
					<p>
						<j2:if test="$[!versionObj.isCurrent]"><a aria-label="$[HTML:versionObj.versionNumber]" aria-description="${ALLOW_JELLY: gs.getMessage('Opens version {0}', '${versionObj.versionNumber}')}" href="kb_view.do?sys_kb_id=$[versionObj.sysId]&amp;sysparm_class_name=$[versionObj.sysClassName]">$[HTML:versionObj.versionNumber]</a>$[SP]-$[SP]$[HTML:versionObj.versionText]</j2:if>
						<j2:if test="$[versionObj.isCurrent]"><b>$[HTML:versionObj.versionNumber]$[SP]-$[SP]$[HTML:versionObj.versionText]</b></j2:if>
				</p>
			</j2:while>
	</div>
</j:jelly>
