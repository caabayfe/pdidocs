<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<j:set var="jvar_extra_style" value=""/>
<j:if test="${jvar_detail_name == 'Top'}">
  <j:set var="jvar_extra_style" value="border-bottom: 1px solid #E9E9E9;"/>
</j:if>
<tbody data-sn-macro-sys-id="${jvar_macro_sys_id}">
<tr><td style='${jvar_extra_style}padding: 5px;' align='right' nowrap='true' width='100%'>

<span id="navigatordetail${jvar_detail_name}">

  <j:set var="jvar_first_img" value="images/nav_first.gifx?v=3"/>
  <j:set var="jvar_back_img" value="images/nav_backward1.gifx?v=3"/>
  <j:set var="jvar_next_img" value="images/nav_forward1.gifx?v=3"/>
  <j:set var="jvar_last_img" value="images/nav_last.gifx?v=3"/>
  <j:set var="jvar_backClass" value="pointerhand"/>
  <j:set var="jvar_nextClass" value="pointerhand"/>
	  
  <j:if test="${!jvar_back}">
	<j:set var="jvar_first_img" value="images/nav_first_dis.gifx?v=3"/>
	<j:set var="jvar_back_img" value="images/nav_backward1_dis.gifx?v=3"/>
	<j:set var="jvar_backClass" value=""/>
  </j:if>

  <j:if test="${!jvar_forward}">
	<j:set var="jvar_next_img" value="images/nav_forward1_dis.gifx?v=3"/>
	<j:set var="jvar_last_img" value="images/nav_last_dis.gifx?v=3"/>
	<j:set var="jvar_nextClass" value=""/>
  </j:if>
	  	  
  <img id="nav_first${jvar_detail_name}" 
	src="${jvar_first_img}" 
	alt="${gs.getMessage('First page')}"
	title="${gs.getMessage('First page')}"
	class="${jvar_backClass}" 
	style="margin-right: 0px;" width="16" height="16" 
	onclick="if (${jvar_back}) document.location.href='${jvar_nav_url}${jvar_back_all_row}';"/>

  <img id="nav_back${jvar_detail_name}" 
	src="${jvar_back_img}" 
	alt="${gs.getMessage('Previous page')}"
	title="${gs.getMessage('Previous page')}"
	class="${jvar_backClass}" 
	style="margin-right: 0px;" width="16" height="16" 
	onclick="if (${jvar_back}) document.location.href='${jvar_nav_url}${jvar_back_one_row}';"/>

  <label for="sys_rownum${jvar_detail_name}" style="display:none">Start row number</label>	

  <j:if test="${!jvar_is_search_vcr}">  
     <input type="hidden" id="sys_rownum${jvar_detail_name}_orig" name="sys_rownum${jvar_detail_name}_orig" value="${sysparm_current_row}"/>
     <input size="3" type="text" class="listbar_navto" id="sys_rownum${jvar_detail_name}" name="sys_rownum${jvar_detail_name}" autocomplete="off"
	    value="${sysparm_current_row}" onkeyup="gotoRowBrowse('${jvar_nav_category}',this, '${jvar_field_page}', '${jvar_nav_catalog}', '${jvar_nav_catalog_view}')" />
  </j:if>
  <j:if test="${jvar_is_search_vcr}">
     <input type="hidden" id="sys_rownum${jvar_detail_name}_orig" name="sys_rownum${jvar_detail_name}_orig" value="${sysparm_current_row}"/>
     <input size="3" type="text" class="listbar_navto" id="sys_rownum${jvar_detail_name}" name="sys_rownum${jvar_detail_name}" autocomplete="off"
	    value="${sysparm_current_row}" onkeyup="gotoRowSearch('${jvar_nav_category}', '${sysparm_safe_search}', '${gs.getSessionToken()}', this, '${jvar_field_page}', '${jvar_nav_catalog}', '${jvar_nav_catalog_view}')" />
  </j:if>

  <span style="margin-left: 5px;" class="print_hide font_smaller" id="nav_label${jvar_detail_name}">${jvar_nav_message}</span>

  <img id="nav_next${jvar_detail_name}" 
	src="${jvar_next_img}" 
	alt="${gs.getMessage('Next page')}"
	class="${jvar_nextClass}" 
	style="margin-right: 0px;" width="16" height="16" 
	title="${gs.getMessage('Next page')}"
	onclick="if (${jvar_forward}) document.location.href='${jvar_nav_url}${jvar_forward_one_row}';"/>

  <img id="nav_last${jvar_detail_name}" 
	src="${jvar_last_img}" 
	alt="${gs.getMessage('Last page')}"
	title="${gs.getMessage('Last page')}"
	class="${jvar_nextClass}" 
	style="margin-left: 0px;" width="16" height="16" 
	onclick="if (${jvar_forward}) document.location.href='${jvar_nav_url}${jvar_forward_all_row}';"/>

 </span>
</td></tr>
	</tbody>
</j:jelly>
