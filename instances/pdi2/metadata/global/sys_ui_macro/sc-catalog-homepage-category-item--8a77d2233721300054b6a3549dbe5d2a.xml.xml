<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate var="jvar_link_url" jelly="true">
		var params = {"sysparm_parent_sys_id":jelly.RP.getParameterValue("sysparm_parent_sys_id"), "sysparm_processing_hint":jelly.RP.getParameterValue("sysparm_processing_hint"), "sysparm_parent_table":jelly.RP.getParameterValue("sysparm_parent_table"), "sysparm_view": encodeURIComponent(jelly.RP.getParameterValue("sysparm_view"))};
		var jvar_link_url = GlideappCatalogURLGenerator.getHomepageCategoryLinkWithParams(jelly.jvar_catalog, jelly.jvar_catalog_view, jelly.jvar_category.getID(), params);
        jvar_link_url;
    </g:evaluate>
    <div style="white-space: nowrap;" class="homepage_category_only" data-sn-macro-sys-id="${jvar_macro_sys_id}">
      <a style="display: inline-block;" target="_self" href="${jvar_link_url}" tabindex="-1">
        <table style="width: 100%; height: 100%;" role="presentation">
          <tr>
            <j:if test="${jvar_category.getHomepageImageSRC() != ''}">
              <td class="homepage_category_only_image_cell" style="text-align: center; vertical-align: middle;">
                <span style="margin: 0px 10px 0px 0px; padding:10px 10px 10px 10px;">
                  <img style="width: 75px; height: 75px;" alt="${jvar_category.getTitle()}" src='${jvar_category.getHomepageImageSRC()}' onclick="document.location.href='${jvar_link_url}'; return false;" aria-hidden="true"/>
                </span>
              </td>
	    </j:if>
            <td class="homepage_category_only_description_cell" style="width: 100%; vertical-align: top; padding:0px 30px 0px 10px;" onclick="document.location.href='${jvar_link_url}'; return false;">
              <a target="_self" href="${jvar_link_url}"  aria-label="${jvar_category.getTitle()}. ${jvar_category.getDescription()}">
                  <h2 style="margin: 10px 0px 0px 0px; font-size:larger; font-weight:normal;">
                    ${jvar_category.getTitle()}
                  </h2>
              </a>
              <span style="white-space:normal;">
                ${jvar_category.getDescription()}	
              </span>
            </td>
          </tr>
        </table>
      </a>
    </div>
</j:jelly>
