<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_current_date" jelly="true">
		new Date().toJSON().slice(0,10);
	</g:evaluate>

	<g:evaluate var="jvar_date_range" jelly="true">
		GlideProperties.getInt('glide.util.logdaterange', 3);
	</g:evaluate>
	<input name="date_range" id="date_range" type="hidden" value="${jvar_date_range}" />
	<g:evaluate var="jvar_single_date" jelly="true">
		GlideProperties.getInt('glide.util.log.download.single_date.max_days', 24);
	</g:evaluate>
	<input name="single_date" id="single_date" type="hidden" value="${jvar_single_date}" />

	<div class="col-sm-12">
		<h4 class="form_header">${gs.getMessage('Select Date')}</h4>
		<div class="navbar-header" style="margin-left:18px">
			<ul class="button-group nav nav-segmented" id="date_tabs">
				<li id="oneDayTab" onclick="selectOneDay()" class="active">One Day</li>
				<li id="dateRangeTab" onclick="selectDateRange()">Date Range</li>
			</ul>
		</div>

		<div id="oneDayTable"  class="">
			<div class="col-xs-8 col-sm-7 col-md-4 col-lg-4" style="margin-left:5px;margin-right:0px">
				<span class="input-group element">
					<input type="text" id="date" style="; " name="date" value="${jvar_current_date}" class="form-control text-align-right-ltr element_reference_input" data-type="glide_element_date" onchange="checkDate()"/>
					<span class="input-group-btn">
						<a alt="${gs.getMessage('Choose Start Date...')}" title="${gs.getMessage('Choose Start Date...')}" class="btn-ref btn btn-default" name="anchorstartDatex" id="anchorstartDatex" data-type="element_date" onclick="new GwtDateTimePicker('date', '$[gs.getDateFormat()]', false);">
						<span aria-hidden="true" class="icon icon-calendar"></span>
						</a>
					</span>
				</span>
			</div>
		</div>
		<div id="dateRangeTable" class="hidden">
			<div class="col-xs-8 col-sm-7 col-md-4 col-lg-4" style="margin-left:5px;margin-right:0px">
				<span class="input-group element">
					<input type="text" id="startDate" style="; " name="startDate" value="${jvar_current_date}" class="form-control text-align-right-ltr element_reference_input" data-type="glide_element_date" onchange="checkStartDate()"/>
					<span class="input-group-btn">
						<a alt="${gs.getMessage('Choose Start Date...')}" title="${gs.getMessage('Choose Start Date...')}" class="btn-ref btn btn-default" name="anchorstartDatex" id="anchorstartDatex" data-type="element_date" onclick="new GwtDateTimePicker('startDate', '$[gs.getDateFormat()]', false);">
							<span aria-hidden="true" class="icon icon-calendar"></span>
						</a>
					</span>
				</span>
			</div>
			<span style="float:left;margin-top:8px;font-weight:bold">to</span>
			<div class="col-xs-8 col-sm-7 col-md-4 col-lg-4" style="margin-left:0px;margin-right:-8px">
				<span class="input-group element">
					<input type="text" id="endDate" style="; " name="endDate" value="${jvar_current_date}" class="form-control text-align-right-ltr element_reference_input" data-type="glide_element_date" onchange="checkEndDate()"/>
					<span class="input-group-btn">
						<a alt="${gs.getMessage('Choose End Date...')}" title="${gs.getMessage('Choose End Date...')}" class="btn-ref btn btn-default" name="anchorendDatex" id="anchorendDatex" data-type="element_date" onclick="new GwtDateTimePicker('endDate', '$[gs.getDateFormat()]', false);">
						<span aria-hidden="true" class="icon icon-calendar"></span>
						</a>
					</span>
				</span>
			</div>
		</div>
	</div>

	<div class="form-group col-sm-12">
		<fieldset style="text-align:left;">
			<h4 class="form_header">${gs.getMessage('Upon Completion')}</h4>
			<div class="form-group clearfix">
				<div class="col-sm-3">
					<span class="input-group-radio">
                        <input id="email" class="radio" type="radio" checked="checked" name="notify" value="email" onclick="gel('emailAddress').style.visibility=''"/>
                        <label for="email" class="radio-label">${gs.getMessage('Email me')}</label>
                    </span>
				</div>
				<div class="col-sm-6 col-md-4 form-field input_controls" style="margin-bottom=3px;margin-top=-7px;">
                    <input id="emailAddress" name="emailAddress" ititle="${gs.getMessage('Enter email address')}" class="form-control" value="" placeholder="${gs.getUser().getEmail()}"></input>
                </div>
			</div>
			<div class="form-group clearfix">
				<div class="col-sm-12">
					<span class="input-group-radio">
                        <input id="redirect" class="radio" type="radio" name="notify" value="redirect" onclick="gel('emailAddress').style.visibility='hidden'"/>
                        <label for="redirect" class="radio-label">${gs.getMessage('Download Now')}</label>
                    </span>
				</div>
			</div>
		</fieldset>
	</div>

</j:jelly>
