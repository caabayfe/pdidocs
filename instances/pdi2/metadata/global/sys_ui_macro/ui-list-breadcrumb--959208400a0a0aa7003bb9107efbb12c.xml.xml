<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

      <j:if test="${jvar_clipped != 'none'}">

        <j:if test="${jvar_clipped == null}">
            >
        </j:if>
        <j:if test="${jvar_clipped != null}">
           <span id="n_${jvar_guid}" onmouseover="enterBreadCrumb('${jvar_guid}')"  onmouseout="exitBreadCrumb('${jvar_guid}')">
            <a href="${jvar_clipped}" title="${gs.getMessage('Click to remove filter')}">
                >
            </a>
          </span>
         </j:if>

      </j:if>

        <a class="${jvar_classname}" href="${jvar_href}" id="m_${jvar_guid}">
          ${jvar_text}
        </a>

</j:jelly>
