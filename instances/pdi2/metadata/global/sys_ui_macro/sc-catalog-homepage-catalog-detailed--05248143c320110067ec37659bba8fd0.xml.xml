<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g:evaluate var="jvar_link_url" jelly="true">
		var params = {"sysparm_parent_sys_id":jelly.RP.getParameterValue("sysparm_parent_sys_id"), "sysparm_parent_table":jelly.RP.getParameterValue("sysparm_parent_table"), "sysparm_view":jelly.RP.getParameterValue("sysparm_view"), "sysparm_processing_hint":jelly.RP.getParameterValue("sysparm_processing_hint")};
		var jvar_link_url = GlideappCatalogURLGenerator.getHomepageCatalogLinkWithParams("${jvar_catalog.getID()}", "${jvar_catalog_view}", params);
		jvar_link_url;
    </g:evaluate>
    <div class="homepage_category_only" data-sn-macro-sys-id="${jvar_macro_sys_id}">
      <a target="_self" href="${jvar_link_url}" alt="${jvar_catalog.getTitle()}">
        <g:set_if var="jvar_backgroundColor" test="${jvar_catalog.getBackgroundColor() == ''}" true="44a9df" false="${jvar_catalog.getBackgroundColor()}" />
        <table style="padding:10px 10px 10px 10px; white-space: nowrap; width: 100%; height: 100%; background-color: ${jvar_backgroundColor};" role="presentation">
          <tr>
            <j:if test="${jvar_catalog.getDesktopImageSRC() != ''}">
              <td class="homepage_category_only_image_cell" style="width: 25%; text-align: center; vertical-align: middle;">
                <span>
                  <img alt="${jvar_catalog.getTitle()}" style="height:72px; width:73px;" src='${jvar_catalog.getDesktopImageSRC()}' onclick="document.location.href='${jvar_link_url}'; return false;" aria-hidden="true"/>
                </span>
              </td>
	    </j:if>
            <td class="homepage_category_only_description_cell" style="padding:10px 10px 10px 10px; vertical-align: middle;" onclick="document.location.href='${jvar_link_url}'; return false;">
              <a target="_self" href="${jvar_link_url}" aria-hidden="true" tabindex="-1">
                <span style="font-size:larger; font-weight:normal;" tabindex="-1">
                    ${jvar_catalog.getTitle()}
                </span>
              </a>
              <hr class="homepage_category_only_divider"/>
              <span style="white-space:normal; font-size:14px; font-style:italic;">
                ${jvar_catalog.getDescription()}	
              </span>
            </td>
          </tr>
        </table>
      </a>
    </div>
</j:jelly>
