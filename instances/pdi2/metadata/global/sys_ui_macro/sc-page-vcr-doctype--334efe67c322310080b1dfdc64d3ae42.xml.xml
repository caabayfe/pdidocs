<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<j:set var="jvar_extra_style" value=""/>
<j:if test="${jvar_detail_name == 'Top'}">
    <j:set var="jvar_extra_style" value="border-bottom: 1px solid #E9E9E9;"/>
</j:if>
<tbody data-sn-macro-sys-id="${jvar_macro_sys_id}">
<tr>
    <td style='${jvar_extra_style}padding: 5px;' align='right' nowrap='true' width='100%'>
        <span id="navigatordetail${jvar_detail_name}">
			<j:if test="${!jvar_streammode}">
				<button id="nav_first${jvar_detail_name}" name="vcr_first" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content" onclick="if (${jvar_back}) document.location.href='${jvar_nav_url}${jvar_back_all_row}';" title="${gs.getMessage('First page')}">
					<span class="sr-only">${gs.getMessage("First page")}</span>
					<span class="icon-vcr-left"></span>
					<span class="icon-vcr-left"></span>
				</button>
			</j:if>
            <button id="nav_back${jvar_detail_name}" name="vcr_back" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content" onclick="if (${jvar_back}) document.location.href='${jvar_nav_url}${jvar_back_one_row}';" title="${gs.getMessage('Previous page')}">
            	<span class="sr-only">${gs.getMessage("Previous page")}</span>
                <span class="icon-vcr-left"></span>
            </button>

            <label for="sys_rownum${jvar_detail_name}" style="display:none">Start row number</label>	
            <j:if test="${!jvar_is_search_vcr}">  
                <input type="hidden" id="sys_rownum${jvar_detail_name}_orig" name="sys_rownum${jvar_detail_name}_orig" value="${sysparm_current_row}"/>
				<j:if test="${jvar_streammode}">
					<input size="3" type="text" class="list_row_number_input form-control" style="color:rgb(72, 85, 99); display:inline; height:21px" id="sys_rownum${jvar_detail_name}" name="sys_rownum${jvar_detail_name}" autocomplete="off"
                    value="${sysparm_current_row}" title="${gs.getMessage('Row')}" disabled='true'/>
				</j:if>
				<j:if test="${!jvar_streammode}">
					<input size="3" type="text" class="list_row_number_input form-control" style="color:rgb(72, 85, 99); display:inline; height:21px" id="sys_rownum${jvar_detail_name}" name="sys_rownum${jvar_detail_name}" autocomplete="off"
                    value="${sysparm_current_row}" onkeyup="gotoRow(this, '${jvar_nav_url}')" title="${gs.getMessage('Row')}"/>
				</j:if>
            </j:if>
            <j:if test="${jvar_is_search_vcr}">  
                <input type="hidden" id="sys_rownum${jvar_detail_name}_orig" name="sys_rownum${jvar_detail_name}_orig" value="${sysparm_current_row}"/>
				<input size="3" type="text" class="list_row_number_input form-control" id="sys_rownum${jvar_detail_name}" style="display:inline; height:21px" name="sys_rownum${jvar_detail_name}" autocomplete="off"
                    value="${sysparm_current_row}" onkeyup="gotoRow(this, '${jvar_nav_url}')" title="${gs.getMessage('Row')}"/>
            </j:if>
            <span style="margin-left: 5px;" class="print_hide list_row_number_input" id="nav_label${jvar_detail_name}">${jvar_nav_message}</span>

            <button id="nav_next${jvar_detail_name}" name="vcr_next" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content" onclick="if (${jvar_forward}) document.location.href='${jvar_nav_url}${jvar_forward_one_row}';" title="${gs.getMessage('Next page')}">
            	<span class="sr-only">${gs.getMessage("Next page")}</span>
                <span class="icon-vcr-right"></span>
            </button>
			<j:if test="${!jvar_streammode}">
				<button id="nav_last${jvar_detail_name}" name="vcr_last" class="sc_vcr_btn list_nav btn btn-default btn-icon h_flip_content" onclick="if (${jvar_forward}) document.location.href='${jvar_nav_url}${jvar_forward_all_row}';" title="${gs.getMessage('Last page')}">
					<span class="sr-only">${gs.getMessage("Last page")}</span>
					<span class="icon-vcr-right"></span>
					<span class="icon-vcr-right"></span>
				</button>
			</j:if>
        </span>
    </td>
</tr>
	</tbody>
</j:jelly>
