<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g:evaluate>
      var fieldType = new GlideRecord('sys_glide_object');
      fieldType.addQuery("visible", true);
      fieldType.orderBy('label');
      fieldType.query();
   </g:evaluate>

   <j:while test="${fieldType.next()}">
      <j:switch on="${fieldType.name}">
        <j:case value="string">
        <option value="${fieldType.name}" selected="true">${fieldType.getDisplayValue("label")}</option>
        </j:case>
        <j:default>
        <option value="${fieldType.name}">${fieldType.getDisplayValue("label")}</option>
        </j:default>
      </j:switch>
   </j:while>
</j:jelly>
