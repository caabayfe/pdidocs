	<tr class="header">
		<td nowrap="true" width="100%" colspan="99">
                                                <img src="images/context.gifx" height="16" width="16" alt=""/>
			<!-- substitute the inner xml using insert tag-->
			<g:insert/>
			<g:label_spacing/>
		</td>
	</tr>
</j:jelly>
