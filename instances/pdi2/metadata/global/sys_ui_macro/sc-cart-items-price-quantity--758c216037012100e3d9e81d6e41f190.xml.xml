<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <j:if test="${jvar_cart_items.size() == 0}">
        <tr class="cart_items sc_cart_item_empty">
            <td class="sc_cart_empty" colspan="6">${gs.getMessage('Empty')}</td>
        </tr>
    </j:if>
    <j:if test="${jvar_cart_items.size() > 0}">
        <j:forEach var="jvar_item" items="${jvar_cart_items}">
            <j:if test="${jvar_sc_quantity == 'true' || jvar_sc_descriptions == 'true' || jvar_sc_price == 'true' || jvar_item.showRecurringPrice()}">
                <tr class="cart_item sc_cart_item_placeholder">
                    <j:choose>
                        <j:when test="${jvar_sc_quantity == 'true'}">
                            <td class="sc_item_quantity" colspan="1" title="${jvar_item.getDisplayQuantity()}" data-toggle="tooltip">
                                ${jvar_item.getDisplayQuantity()}
                            </td>
                        </j:when>
                        <j:otherwise>
                            <td class="sc_item_quantity" colspan="1">    
                            </td>
                        </j:otherwise>
                    </j:choose>
                    <j:choose>
                        <j:when test="${jvar_sc_descriptions == 'true'}">
                            <td class="sc_item_name" colspan="3" title="${jvar_item.getDisplayName()}" data-toggle="tooltip">
                                ${jvar_item.getDisplayName()}
                            </td>
                        </j:when>
                        <j:otherwise>
                            <td class="sc_item_name" colspan="3">
                            </td>
                        </j:otherwise>
                    </j:choose>
                    <j:if test="${jvar_item.showPrice()}">
                    	<td class="sc_item_price cart_price_cell" colspan="2" title="${jvar_item.getSubtotalWithCurrency()}" data-toggle="tooltip">
                            ${jvar_item.getSubtotalWithCurrency()}
                        </td>
                    </j:if>
                    <j:if test="${!jvar_item.showPrice() &amp;&amp; jvar_item.showRecurringPrice()}">
                        <td class="sc_item_price cart_price_cell sc_cart_cell_smaller sc_item_recurring_price" colspan="2" title="${jvar_item.getRecurringSubtotalWithCurrency()} ${jvar_item.getRecurringFrequencyDisplay()}" data-toggle="tooltip">
                            ${jvar_item.getRecurringSubtotalWithCurrency()} ${jvar_item.getRecurringFrequencyDisplay()}
                        </td>
                    </j:if>
                </tr>
                <j:if test="${jvar_item.showPrice() &amp;&amp; jvar_item.showRecurringPrice()}">
                    <tr class="cart_item sc_cart_item_placeholder">
                        <td colspan="6" class="sc_cart_cell_smaller sc_item_recurring_price cart_price_cell">
                            + ${jvar_item.getRecurringSubtotalWithCurrency()} ${jvar_item.getRecurringFrequencyDisplay()}
                        </td>
                    </tr>
                </j:if>
            </j:if>
        </j:forEach>
    </j:if>
</j:jelly>
