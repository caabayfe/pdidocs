<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <j:set var="jvar_use_cart_layouts" value="${new SNC.ServiceCatalogLayoutService().useSCLayout()}" />
	<div data-sn-macro-sys-id="${jvar_macro_sys_id}">
    <j:if test="${jvar_use_cart_layouts}">
        <table id="sc_cart_window" class="" style="width: 96%; margin: auto;" border="0">
            <g:com.glideapp.servicecatalog_cart target="shopping_cart" prices="true" />
        </table>
    </j:if>
    <j:if test="${!jvar_use_cart_layouts}">
        <g:requires name="styles/sc_cat.css" /> 
        <div id='cart'>${SP}</div>
        <script language='javascript' eval="true">;
            var item_list = new CartItemList();
            item_list.cartBody = gel('cart');
            item_list.get();
        </script>
    </j:if>
	</div>
</j:jelly>
