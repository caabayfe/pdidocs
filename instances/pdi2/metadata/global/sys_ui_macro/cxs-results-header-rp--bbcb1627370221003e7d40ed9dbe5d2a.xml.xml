<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_is_doctype" expression="GlideMobileExtensions.getDeviceType() == 'doctype'"/>
	<j:choose>
		<j:when test="${jvar_is_doctype}">
			<table id="cxs_results_header" class="question_spacer io_table" style="border: 0px;" width="100%">
				<tbody>
					<tr>
						<td style="padding: 0px;">
							<span style="margin-left: 1px; font-weight: bold;">${SP}${jvar_results_header_text}</span>
						</td>
						<td class="text-align-right" style="color: black">
							<g:call function="cxs_results_vcr" />
						</td>
					</tr>
				</tbody>
			</table>
		</j:when>
		<j:otherwise>
			<table id="cxs_results_header" class="question_spacer io_table" style="border: 0px;" width="100%">
				<tbody>
					<tr class="io_label">
						<td width="100%" style="padding: 0px;">
							<span style="margin-left: 1px;" oclass="">${SP}</span>
							<label>${jvar_results_header_text}</label>
						</td>
					</tr>
					<tr>
						<td class="text-align-right" style="color: black">
							<g:call function="cxs_results_vcr" />
						</td>
					</tr>
				</tbody>
			</table>
		</j:otherwise>
	</j:choose>
</j:jelly>
