<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<g:macro name="REQUIRED" selecttable="REQUIRED" leftzone="REQUIRED" rightzone="REQUIRED" move_right_button_label="${gs.getMessage('Add')}" move_left_button_label="${gs.getMessage('Remove')}"/>
  <!-- add / remove buttons -->
  <table cellSpacing="3" cellPadding="0" border="0" width="100%">
    <tr id="${jvar_name}_move_right_text">
      <td align="center">${jvar_move_right_button_label}</td>
    </tr>
    <tr id="${jvar_name}_move_right_button">
      <td align="center">
         <a class="btn btn-default icon-chevron-right"  style="margin-top: 5px; width:32px; height:32px;" onclick="${jvar_name}_moveLeftToRight();">
            <span class="sr-only">${gs.getMessage('Add')}</span>
         </a>
      </td>
    </tr>
    <tr id="${jvar_name}_move_left_button">
      <td align="center">
         <a class="btn btn-default icon-chevron-left" style="margin-top: 5px; width:32px; height:32px;" onclick="${jvar_name}_moveRightToLeft();">
            <span class="sr-only">${gs.getMessage('Remove')}</span>
         </a>
      </td>
    </tr>
    <tr id="${jvar_name}_move_left_text">
      <td align="center">${jvar_move_left_button_label}</td>
    </tr>
  </table>
  <script eval="true">
    function ${jvar_name}_moveLeftToRight() {
      ${jvar_selecttable}.copyOrMoveSelectedItems(${jvar_leftzone}, ${jvar_rightzone}, -1);
    }

    function ${jvar_name}_moveRightToLeft() {
      ${jvar_selecttable}.copyOrMoveSelectedItems(${jvar_rightzone}, ${jvar_leftzone}, -1);
    }
  </script>
</j:jelly>
