<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<div id="sc_cart_view">
        <j:if test="${jvar_cart.isEmpty() != 'true'}">
            <g:com.glideapp.servicecatalog_cart_table target="cart_view_wish_list" 
													  prices="true"
													  cartName="${sysparm_cart_name}"/>
        </j:if>
        <j:if test="${jvar_cart.isEmpty() == 'true'}">
            <j2:set var="jvar_doctype" value="$[SNC.CatalogStyleService.useDoctype()]" />
            <j2:choose>
				<g:evaluate var="sc_title" expression="gs.getMessage(jelly.jvar_title)" jelly="true"/>
                <j2:when test="$[jvar_doctype == 'true']">
                    <div class="notification notification-info">${sc_title}: ${gs.getMessage('Empty')}</div>
                </j2:when>
                <j2:otherwise>
                    <div class="outputmsg outputmsg_warning">
                        <div class="outputmsg_text">${sc_title}: ${gs.getMessage('Empty')}</div>
                    </div>
                </j2:otherwise>
            </j2:choose>
        </j:if>
    </div>
</j:jelly>
