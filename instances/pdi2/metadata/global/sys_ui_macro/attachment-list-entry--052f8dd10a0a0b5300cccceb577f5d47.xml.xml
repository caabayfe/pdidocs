<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g:macro show_link="false" attachment_id="none" search_text="" />
   <g:evaluate object="true" var="jvar_attachment_list">
      GlideStringUtil.split(${jvar_attachment_id});
   </g:evaluate>

   <j:forEach var="jvar_id" items="${jvar_attachment_list}">
     <g:evaluate var="jvar_highlight" jelly="true" expression="var att = new Attachment(); att.getTerms(jelly.jvar_id);"/>
     <g:evaluate var="jvar_attachment" jelly="true" expression="var sys_attachment = new GlideRecord('sys_attachment'); sys_attachment.get(jelly.jvar_id);"/>
     <div style="margin-top: 1em; margin-left: 3em;"><g:attachment_entry show_link="${jvar_show_link}"/></div>
     <div style="margin-left: 3em;"><g:no_escape><g:highlighter search="${jvar_search_text}">${jvar_highlight}</g:highlighter></g:no_escape></div>
   </j:forEach>
</j:jelly>
