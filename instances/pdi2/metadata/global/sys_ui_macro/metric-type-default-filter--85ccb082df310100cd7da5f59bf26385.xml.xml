<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:requires name="AssessmentClientUtils.jsdbx" />
    <g2:evaluate>
        var element = current.getElement('default_filter');
        var title = element.sys_meta.hint;
        var elementLabel = element.getLabel();
        var readOnly = false;
    </g2:evaluate>
    <tr>
        <td class="label label_spacing"
        data-type="label"
        type="choice"
        id="label.asmt_metric_type.default_filter"
        noWrap="true"
        title="$[title]"
        style="padding: 6px 5px 0px !important;">
            <span id="status.asmt_metric_type.default_filter" 
			title=""
			mandatory="false" 
			oclass="" 
			class="label_description">$[SP]</span>
			<label dir="ltr" for="asmt_metric_type.default_filter" onclick="return labelClicked(this);">$[elementLabel]:</label>
        </td>
        <td>
            <j:if test="${jvar_width == null}">
                <j:set var="jvar_width" value="" />
            </j:if>
            <j:if test="${jvar_width != ''}">
                <j:set var="jvar_choicelist_width" value="${jvar_width}" />
            </j:if>
            <j:if test="${jvar_width == ''}">
                <g:evaluate var="jvar_choicelist_width">
                 var w = gs.getProperty('glide.ui.choicelist.defaultwidth','160');
                 if (w)
                    w = "width:" + w + "px";
         
                 w;
                 </g:evaluate>
            </j:if>
    
            <j2:set var="jvar_style_content" value="${jvar_style};${jvar_choicelist_width};$[jvar_add_fieldstyle]"/>
            <select NAME="asmt_metric_type.default_filter" ID="asmt_metric_type.default_filter" onChange="onChange('asmt_metric_type.default_filter');" style="$[jvar_style_content]">
                <option value="">-- None --</option>
                <option value="$[current.default_filter + '']" selected="selected">$[current.default_filter + '']</option>
            </select>
            <a title="Refresh filter options" onclick="AssessmentClientUtils.populateDefaultFilter(); return false;">
                <img width="16" height="16" border="0" src="images/icons/refresh.gifx" alt="${gs.getMessage('Refresh for Default matrix filter')}"/> 
            </a>
            <input type="hidden" id="sys_original.asmt_metric_type.default_filter" value="$[current.default_filter]" />
            <j:set var="jvar_width" value="" />
        </td>
    </tr>
</j:jelly>
