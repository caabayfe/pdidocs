<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  <j:if test="${jvar_cart_items.size() != 0}">
    <j:if test="${jvar_show_subtotal_price == 'true'}">
        <tr class="sc_cart_subtotal_row">
            <td colspan="3"><hr/></td>    
        </tr>
        <tr class="sc_cart_subtotal">
            <td colspan="2" class="sc_cart_subtotal_text">
                <strong>${gs.getMessage('subtotal')}</strong>
            </td>
            <td style="font-size: 0.8em" class="sc_cart_subtotal_value sc_cart_cell_right">
                <strong>${jvar_subtotal_price}</strong>
            </td>
        </tr>
    </j:if>
  </j:if>
</j:jelly>
