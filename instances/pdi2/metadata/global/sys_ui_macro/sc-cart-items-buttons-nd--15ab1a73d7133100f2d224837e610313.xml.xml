<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<j:if test="${jvar_cart_items.size() > 0}">
	
    <g:evaluate jelly="true">
		var editCartAction = GlideappCatalogURLGenerator.getEditCartUrl(jelly.sysparm_catalog, jelly.sysparm_catalog_view, jelly.sysparm_processing_hint, jelly.sysparm_link_parent); 
        editCartAction = "window.location='" + editCartAction + "';CustomEvent.fireTop('cart.edit');";
        var checkoutAction = GlideappCatalogURLGenerator.getCheckoutAction(jelly.sysparm_catalog, jelly.sysparm_catalog_view, gs.getSessionToken()); 
        var continueShoppingAction = GlideappCatalogURLGenerator.getContinueShoppingAction(jelly.sysparm_catalog, jelly.sysparm_catalog_view);
    </g:evaluate>
    <tr class="sc_cart_buttons">
        <td colspan="3">
            <j:if test="${jvar_sc_edit_cart_button == 'true'}">
                <g:sc_button classes="request_catalog_button_with_icon" img="images/button_arrow_rt.gifx" id="catalog_cart_edit_button" onclick="${editCartAction}" label="${jvar_sc_edit_cart_label}" title="${jvar_sc_edit_cart_label}"/>
            </j:if>
            <j:if test="${jvar_sc_proceed_checkout_button == 'true'}">
                <g:sc_button classes="request_catalog_button_with_icon" img="images/button_arrow_rt.gifx" id="catalog_cart_proceed_checkout" onclick="if(typeof g_form !== 'undefined' ${AND} !g_form.modified) this.onclick='';${checkoutAction};" label="${jvar_sc_proceed_checkout_label}" title="${jvar_sc_proceed_checkout_label}" isPrimary="true"/>
            </j:if>
            <j:if test="${jvar_sc_continue_shopping_button == 'true'}">
                <g:sc_button classes="request_catalog_button_with_icon" img="images/button_arrow_lt.gifx" id="catalog_cart_continue_shopping" onclick="${continueShoppingAction}" label="${jvar_sc_continue_shopping_label}" title="${jvar_sc_continue_shopping_label}"/>
            </j:if>
        </td>
    </tr>
</j:if>
</j:jelly>
