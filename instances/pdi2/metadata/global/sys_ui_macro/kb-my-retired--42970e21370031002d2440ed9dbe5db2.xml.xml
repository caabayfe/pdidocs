<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate jelly="true">
        var results = jelly.jvar_results;
    </g:evaluate>
    <j:if test="${results.length != 0}">
        <j:forEach items="${results}" var="jvar_result" indexVar="jvar_index">
            <tr>
                <g:evaluate jelly="true">
                    var link = jelly.jvar_result.link;
                    var shortDescription = jelly.jvar_result.short_description.truncated;
                    var retired = jelly.jvar_result.retired;
                </g:evaluate>
                <td class="my-knowledge-cell expand">
                    <a class="my-knowledge-link" href="${link}">${shortDescription}</a>
                </td>
                <td class="my-knowledge-cell nowrap" title="${gs.getMessage('Retired on')}">${retired}</td>
            </tr>
        </j:forEach>
    </j:if>
</j:jelly>
