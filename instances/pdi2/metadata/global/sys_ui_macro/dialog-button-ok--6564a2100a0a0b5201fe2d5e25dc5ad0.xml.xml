<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:macro 
		ok="actionOK()" 
		ok_id="ok_button" 
		ok_type="submit" />
	<g:dialog_button 
		id="${jvar_ok_id}" 
		type="${jvar_ok_type}" 
		onclick="${jvar_ok}" 
		style_class="btn btn-primary"
		style="width: 5em;">${gs.getMessage('OK')}</g:dialog_button>
</j:jelly>
