<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:set var="jvar_annotation_is_empty" value="${jvar_annotation_type == 'Text' and jvar_text == ''}" />
	<j:if test="${!jvar_annotation_is_empty}">
		<tr class="annotation-row" data-is-plain-text="${jvar_annotation_is_plain_text}"
    data-annotation-name="${HTML:jvar_annotation.getValue('name')}" data-annotation-type="${HTML:jvar_annotation_type}">
			<td colspan="99" class="annotation" data-annotation-type="${HTML:jvar_annotation_type}">
				<div class="annotation-wrapper less-padding" style="${jvar_style}; ${jvar_annotation_style}" role="note" >
					<j:if test="${jvar_annotation_is_plain_text == true}">
						<g2:no_escape>${ALLOW_JELLY:jvar_text.toString().replaceAll("\n", "&lt;br/&gt;")}</g2:no_escape>
					</j:if>
					<j:if test="${jvar_annotation_is_plain_text == false}">
						<g2:no_escape>${ALLOW_JELLY:jvar_text.toString().replaceAll("&amp;amp;nbsp;", "&amp;nbsp;")}</g2:no_escape>
					</j:if>
					<j:if test="${!jvar_omit_spacer}">
						<input id="make_spacing_ok" style="visibility:hidden; width:0px;" />
					</j:if>
					<j:if test="${jvar_omit_spacer}">
						<img src="images/s.gif" alt="" />
					</j:if>
				</div>
			</td>
		</tr>
	</j:if>
</j:jelly>
