<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate jelly="true">
        var results = jelly.jvar_results;
    </g:evaluate>
    <j:if test="${results.length != 0}">
        <j:forEach items="${results}" var="jvar_result" indexVar="jvar_index">
            <tr>
                <g:evaluate jelly="true">
                    var id = jelly.jvar_result.sys_id;
                    var link = jelly.jvar_result.link;
                    var number = jelly.jvar_result.number;
                    var commentTruncated = jelly.jvar_result.comments.truncated;
                    var commentComplete = jelly.jvar_result.comments.complete;
                    var created = jelly.jvar_result.sys_created_on;
                    var user = jelly.jvar_result.user;
                </g:evaluate>
                <td class="my-knowledge-cell shrink">
                    <a class="my-knowledge-link" href="${link}">${number}</a>
                </td>
                <td class="my-knowledge-cell expand">
                    ${commentTruncated}
                </td>
                <td class="my-knowledge-cell nowrap">${user}</td>
                <td class="my-knowledge-cell nowrap" title="${gs.getMessage('Created on')}">${created}</td>
            </tr>
        </j:forEach>
    </j:if>
</j:jelly>
