<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:if test="${!empty(jvar_results_header_text)}">
		<table class="wide" style="font-family: Arial; font-size: 10pt;width: 100%;border: 0px none;margin: 0px;padding: 0px;">
			<tr class="header" style="background-color: #E6E8EA;border-bottom: 1px solid #BDC0C4;color: #485563;font-weight: bold;">
				<td class="column_head" style="color: #485563;font-weight: bold;white-space: nowrap;">
					<h3 class="form_header" style="font-size: 100%;margin: 4px 0 4px 0px;">${jvar_results_header_text}</h3>
				</td>
			</tr>
		</table>
	</j:if>
</j:jelly>
