<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<g2:evaluate var="jvar_not_important" expression="
	var displayFeedbackEntryOn = 'none';
	var displayFeedbackEntryOff = '';
	if (kbViewInfo.feedbackEntryInitialDisplay) {
		displayFeedbackEntryOn = '';
		displayFeedbackEntryOff = 'none';
	}
"/>

<j2:if test="$[kbViewInfo.showKBFeedback]">
	<j2:if test="$[RP.isInteractive()]">
		<div id="comment_link_div" class="snc-kb-comment-link" style="display: $[displayFeedbackEntryOff];">
			<span class="pointerhand" onclick="showComments()" role="button" tabindex="0" aria-label="${gs.getMessage('Leave a comment')}">
				${gs.getMessage("Leave a comment...")}
			</span>
		</div>
		<div id="comment_link_div_cancel" class="snc-kb-comment-link" style="display: $[displayFeedbackEntryOn];margin-bottom:0.3em;">
			<span class="pointerhand" onclick="hideComments()" role="button" tabindex="0" aria-label="${gs.getMessage('Hide comment box')}">
				${gs.getMessage("Leave a comment")}
			</span>
		</div>

		<div role="alert" id="commentsdiv_empty" class="snc-kb-comment-div-empty">
			$[gs.getMessage("Please type feedback before submitting")]
		</div>
		<div id="commentsdiv_done" class="snc-kb-comment-div-done" style="display:none">
			$[gs.getMessage("Your feedback has been submitted, thank you") ]
		</div>
		<div id="commentsdiv_flagmsg" class="snc-kb-comment-div-flagmsg">
			$[gs.getMessage("Please submit descriptive feedback after flagging an article, or it will not be modified") ]
		</div>

		<div id="commentsdiv" class="snc-kb-comment-div" style="display: $[displayFeedbackEntryOn];">
			<div>
				<textarea name="article_comments" id="article_comments" aria-label="${gs.getMessage('Leave a comment')}" class="snc-kb-comments-entry form-control"/>
			</div>
			<div>
				<button name="not_important" class="btn btn-primary" style="margin-top:0.3em"
						id="feedback_button" type="submit" value="sysverb_feedback" aria-label="${gs.getMessage('Comment')}"
						onClick="return kbFeedback2('article_comments');">$[gs.getMessage("Comment")]</button>
			</div>
		</div>
	</j2:if>
</j2:if>
</j:jelly>
