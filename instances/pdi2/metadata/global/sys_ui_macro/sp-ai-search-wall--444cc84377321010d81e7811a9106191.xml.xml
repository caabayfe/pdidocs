<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<style>
	body {
	  color: #2e2e2e;
	}
    .align-center {
      margin: 0;
      position: absolute;
      top: 25%;
      left: 50%;
      -ms-transform: translate(-50%, -25%);
      transform: translate(-50%, -25%);
      width: 28%;
      text-align: left;
    }
    a:hover, a:focus {
      text-decoration: underline;
    }
    a:focus {
      outline: 5px auto #1f8476;
      outline-offset: 1px;
    }
	.circle-icon {
	  color: #ff0000;
	  vertical-align: middle;
	  margin-right: 5px;
	}
	.title {
	  font-weight: bold;
	  padding-top: 3px;
	}
	.panel-content {
	  padding: 15px;
	}
	.panel-content p {
	  margin-bottom: 0;
	}
	.panel-content a {
	  display: inline-block;
	  color: #1f8476;
	}
	.panel-title {
	  display: flex;
	}
	.learn-more {
	  margin-bottom: 20px;
	}
	@media (max-width: 767px) {
	  .align-center {
	     width: auto;
	  }
	}
</style>
<div class="align-center panel panel-default">
    <div class="panel-heading" style="background-color: transparent;">
        <h1 class="h4 panel-title">
            <span class="circle-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="circle-exclamation-outline-thumbnail" width="24" height="24" viewBox="0 0 24 24" style="">
                    <g stroke="none" fill="none">
                        <path
                            d="M12 1l.288.004C18.23 1.157 23 6.02 23 12c0 6.075-4.925 11-11 11S1 18.075 1 12 5.925 1 12 1zm0 1l-.28.004C6.327 2.152 2 6.57 2 12c0 5.523 4.477 10 10 10s10-4.477 10-10S17.523 2 12 2zm1 14v2h-2v-2h2zm0-10v8h-2V6h2z"
                            fill="currentColor"></path>
                    </g>
                </svg>
            </span>
            <span class="title">${gs.getMessage('Upgrade your browser')}</span>
		</h1>
    </div>
    <div class="panel-content">
        <p>${gs.getMessage('For full site functionality and security, you must use the latest version of either Chrome, Firefox, Microsoft Edge or Safari.')}</p>
		<div class="learn-more"><a href="/api/now/v1/context_doc_url/Browser_Support" target="_blank">${gs.getMessage('Learn more')}</a></div>
    </div>
</div>
</j:jelly>
