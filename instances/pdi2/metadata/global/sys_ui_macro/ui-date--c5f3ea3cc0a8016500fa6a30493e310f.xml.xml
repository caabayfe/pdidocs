<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide">
  <g:macro name="date" value="${gs.now()}" />
  <g:if_polaris>
    <g:then>
      <label for="${jvar_name}" style="display:none">${jvar_name}</label>
      <span class="input-group">
        <input id="${jvar_name}" type="text" name="${jvar_name}" value="${jvar_value}" sn-atf-data-type="glide_date" class="form-control" aria-labelledby="${jvar_name}_label" />
        <span sn-atf-blacklist="true"/>
        <span class="input-group-btn">
          <!-- user / system date time format -->
          <a tabindex="0" onclick="new GwtDateTimePicker('${jvar_name}', '$[gs.getDateFormat()]', false);" sn-atf-blacklist="true" class="btn btn-default icon-calendar" role="button" aria-label="${gs.getMessage('Choose date...')}"></a>
        </span>
      </span>
    </g:then>
    <g:else>
      <label for="${jvar_name}" style="display:none">${jvar_name}</label>
      <input id="${jvar_name}" type="text" name="${jvar_name}" value="${jvar_value}" sn-atf-data-type="glide_date" aria-labelledby="${jvar_name}_label" />
      <span style="margin: 2px" sn-atf-blacklist="true"/>

      <!-- user / system date format -->
      <a tabindex="0" onclick="new GwtDateTimePicker('${jvar_name}', '$[gs.getDateFormat()]', false);" sn-atf-blacklist="true">
        <img height="16" width="16" class="button" src="images/small_calendar.gifx" alt="${gs.getMessage('Choose date...')}"
        title="${gs.getMessage('Choose date...')}"
        name="anchor${jvar_name}x" id="anchor${jvar_name}x" border="0" aria-label="${gs.getMessage('Choose date...')}" />
      </a>
    </g:else>
  </g:if_polaris>
</j:jelly>
