<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate var="jvar_is_doctype" expression="GlideMobileExtensions.getDeviceType() == 'doctype'" />
    <j:choose>
        <j:when test="${jvar_is_doctype}">
            <nav class="navbar navbar-default" role="navigation">
                <div class="container-fluid">
                    <div class="navbar-header">
                        <button class="btn btn-default icon-chevron-left navbar-btn" onclick="window.history.back();"></button>
                        <h1 style="display:inline-block; font-size: 115%" class="navbar-title">${gs.getMessage("My Knowledge")}</h1>
                    </div>
                    <div class="nav navbar-right">
                        <button onclick="window.location='kb_knowledge.do?sys_id=-1';" class="btn btn-primary navbar-btn">${gs.getMessage("Create content")}</button>
                        <button onclick="javascript: window.location.reload();" class="btn btn-default navbar-btn icon-refresh" title="${gs.getMessage('Refresh')}" gsft_label="${gs.getMessage('Refresh')}" />
                        <j:if test="${jvar_show_add_button and jvar_show_add_button == 'true'}">
                            <button onclick="javascript: addHomeContent(this);" class="btn btn-default navbar-btn icon-add" title="${gs.getMessage('Add content')}" gsft_label="${gs.getMessage('Add content')}" />
                        </j:if>
                    </div>
                </div>
            </nav>
        </j:when>
        <j:otherwise>
            <div class="kb-header-container">
                <table class="kb-header">
                    <tr>
                        <td class="column_head">
                            <img width="16" height="16" id="sysverb_back" title="Back" onclick="window.history.back();" src="images/green_back.gifx" />
                        </td>
                        <td class="column_head">
                            <h2 class="form_header">${gs.getMessage("My Knowledge")}</h2>
                        </td>
                        <td class="column_head" width="100%" style="text-align: right;">
                            <button type="submit" onclick="window.location = 'kb_knowledge.do?sys_id=-1';">${gs.getMessage("Create content")}</button>
                            <a onclick="javascript: window.location.reload(); return false;">
                                <img src="/images/icons/refresh.gif" width="16" height="16"  />
                            </a>
                        </td>
                    </tr>
                </table>
                <j:if test="${jvar_show_add_button and jvar_show_add_button == 'true'}">
                    <div class="kb-add-content">
                        <a class="web" onclick="javascript: addHomeContent(this); return false;">${gs.getMessage("Add content")}</a>
                    </div>
                </j:if>
            </div>
        </j:otherwise>
    </j:choose>
</j:jelly>
