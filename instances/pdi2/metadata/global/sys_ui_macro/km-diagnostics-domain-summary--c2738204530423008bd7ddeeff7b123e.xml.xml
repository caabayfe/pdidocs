<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

	<div class="diagnostics-results domain-results">
		<div class="diagnostics-summary collapsible" aria-live="assertive" aria-atomic="true">
			<h2>
				<i class="icon-add expand" aria-hidden="true" tabindex="0"></i>
				<i class="icon-sub-elements" aria-hidden="true"></i>
				<span class="summary-heading">${gs.getMessage('Domain Separation')}</span>
			</h2>
		</div>
		<div class="content">
			<p class="note">
				<g2:no_escape>${finalResults.domainResults.note}</g2:no_escape>
			</p>
			<j:if test="${!finalResults.domainResults.result}">
				<p class="note todo">
					<g2:no_escape>${finalResults.domainResults.todo}</g2:no_escape>
				</p>
			</j:if>
		</div>
	</div>


</j:jelly>
