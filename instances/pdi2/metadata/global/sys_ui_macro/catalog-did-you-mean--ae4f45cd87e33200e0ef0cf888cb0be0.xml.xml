<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_suggessions" jelly="true" object="true">
		var didYouMean = new GlideTSDidYouMean();
		answer = didYouMean.getAlternatePhrases(GlideStringUtil.escapeHTML(jelly.sysparm_search), 'sc_cat_item');
		answer;
	</g:evaluate>
	<j:if test="${jvar_suggessions.size() > 0}">
		<div>
			<i class="icon-help" style="font-size: large; padding: 0 10px"></i><span style="color: red">${gs.getMessage('Did you mean:')}</span>
			<j:forEach items="${jvar_suggessions}" var="jvar_suggession">
				<a href="javascript:void(0);"
				   onclick="$('sysparm_catalog_search').value = '${jvar_suggession}'; $('search_form').submit();" 
				   class="message_link" 
				   style="margin-left: 5px">
					${jvar_suggession}
				</a>
			</j:forEach>
		</div>
	</j:if>
</j:jelly>
