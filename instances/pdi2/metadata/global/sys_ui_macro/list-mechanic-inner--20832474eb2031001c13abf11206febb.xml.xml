<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:messages>
		Saving
		Reloading
	</g:messages>
	<form class="list-mechanic" onSubmit="return false;">
		<div>
			<g:ui_slushbucket up_down="true"/>
		</div>
		<fieldset class="input-group-checkbox">
		 <legend class="sr-only">${gs.getMessage('List Settings')}</legend>
		<div>
			<g:ui_checkbox name="wrap" id="wrap" class="checkbox_list_mechanic">
				${gs.getMessage('Wrap column text')}
			</g:ui_checkbox>

			<g:ui_checkbox name="compact" id="compact" class="checkbox_list_mechanic">
				${gs.getMessage('Compact rows')}
			</g:ui_checkbox>

			<g:ui_checkbox name="highlighting" id="highlighting" class="checkbox_list_mechanic">
				${gs.getMessage('Enable list highlighting')}
			</g:ui_checkbox>

			<g:ui_checkbox name="field_style_circles" id="field_style_circles" class="checkbox_list_mechanic">
				${gs.getMessage('Modern cell coloring')}
			</g:ui_checkbox>
		</div>

		<j:if test="${gs.getProperty('glide.ui.list_edit', 'true')}">
			<div>
				<g:ui_checkbox name="list_edit_enable" id="list_edit_enable" class="checkbox_list_mechanic">
					${gs.getMessage('Enable list edit')}
				</g:ui_checkbox>

				<g:ui_checkbox name="list_edit_double" id="list_edit_double" class="checkbox_list_mechanic">
					${gs.getMessage('Double click to edit')}
				</g:ui_checkbox>
			</div>
		</j:if>
		</fieldset>
		<div class="modal-footer">
			<span class="pull-left status_msg_update">
				<button id="reset_column_defaults" class="btn btn-default" disabled="true" onclick="actionOK(true)" type="submit">${gs.getMessage('Reset to column defaults')}</button>
			</span>
			<span class="pull-right">
				<g:dialog_buttons_ok_cancel/>
			</span>
		</div>
		<script>
			$j(".list-mechanic").keydown(function(evt) {
			    // DEF0125399: if a user were to press Enter on a non-button, non-link element it would unintentionally submit the form
				if (evt.keyCode === 13 $[AND] !["BUTTON", "A"].includes(evt.target.tagName)) {
					evt.preventDefault();
				}
			});
		</script>
	</form>
</j:jelly>
