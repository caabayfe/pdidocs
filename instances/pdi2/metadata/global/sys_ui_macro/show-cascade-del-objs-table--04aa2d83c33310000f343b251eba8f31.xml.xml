<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<div class="cascade_del_objs_table">
    <table>
    <j:set var="jvar_displayMore" value="false" />
    <j:forEach items="${jvar_obj_list.split(',')}" var="jvar_obj_pair" indexVar="jvar_n">
        <j:if test="${jvar_n > 4}">
            <j:set var="jvar_displayMore" value="true" />
            <j:break />
        </j:if>
        <tr>
        <j:forEach items="${jvar_obj_pair.split(':')}" var="jvar_obj" indexVar="jvar_i">
            <j:choose>
                 <j:when test="${jvar_i == 0}">
                    <td class="first-cell"> <p> <b> ${jvar_obj} </b></p> </td>
                </j:when>
                <j:otherwise>
                    <td> <p> <b> ${jvar_obj} </b></p> </td>
                </j:otherwise>
            </j:choose>
        </j:forEach>
        </tr>
    </j:forEach>  
    </table>
    <j:if test="${jvar_displayMore.equals('true')}">
        <p> <b>${gs.getMessage('and more')}</b> </p>
    </j:if>
</div>

</j:jelly>
