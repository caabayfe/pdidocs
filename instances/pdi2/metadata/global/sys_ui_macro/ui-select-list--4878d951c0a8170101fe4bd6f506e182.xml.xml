<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide"
	xmlns:j2="null" xmlns:g2="null">
	<g:include_script src="SelectList.jsdbx" />
	<g:macro name="selectList" header="Available" size="10" width="180" multiple_select="true" sort="true" />
	<script eval="true">
		var ${jvar_name} = new SelectList('${jvar_name}', '${jvar_sort}');
	</script>
	<table cellSpacing="0" cellPadding="0" border="0">
		<tr class="header">
			<td vAlign="bottom" align="middle">${jvar_header}</td>
		</tr>
		<tr>
			<td vAlign="top" align="middle" class="slushbody">
				<!-- select list -->
				<select id="${jvar_name}" name="${jvar_name}"
					class="slushselect" multiple="${jvar_multiple_select}" size="${jvar_size}"
					style="width:${jvar_width};" ondblclick="${jvar_name}.dblClick();">
				</select>
			</td>
		</tr>
	</table>
</j:jelly>
