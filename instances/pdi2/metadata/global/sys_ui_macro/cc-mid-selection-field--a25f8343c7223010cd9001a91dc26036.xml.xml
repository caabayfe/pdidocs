<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_field" object="true" jelly="true">
		var fields = {};
        field = jelly.jvar_cc_mid_selection_field;
        field;
	</g:evaluate>
	<g:evaluate var="jvar_field_name" object="true" jelly="true">
			var prefix = ""; 
			prefix = jelly.jvar_cc_prefix;
			var name = (gs.nil(prefix) ? "connection.mid_server" : (prefix + "-" + connection.mid_server));
			name;	
	</g:evaluate>
	<div id="mid.selection.group" class="field-bottom-padding">
	<span class="input-group-checkbox">
	
		
		<label for="connection.use_mid" style="padding-right:10px">${gs.getMessage('Use MID Server:')}</label>
		<j:if test="${jvar_value == 'true'}">
			<input type="checkbox" id="ni.connection.use_mid" name="ni.connection.use_mid" checked="checked" value="true" class="${jvar_class} checkbox" 
				title="${jvar_title}" onClick="setCheckBox(this);hideMidFields()"/>
		</j:if>
		
		 <j:if test="${jvar_value != 'true'}">
			<input type="checkbox" id="ni.connection.use_mid" name="ni.connection.use_mid" value="true" class="${jvar_class} checkbox" 
				title="${jvar_title}" onClick="setCheckBox(this);hideMidFields()"/>
		</j:if>
		<label for="ni.connection.use_mid" class="checkbox-label">
			<g:insert/>
		</label>
		<input type="hidden" id="connection.use_mid" name="connection.use_mid" value="${jvar_value}" class="${jvar_class}"/>
	</span>
		
	<div class="field-bottom-padding" id="connection.mid_server.group" style="display:none;">
		<label id="connection.mid_server-label" for="${gs.getMessage('MID Server')}" aria-label="${gs.getMessage('MID Server')}" style="padding-top:10px"><span aria-label="Mandatory - must be populated before Submit" data-dynamic-title="Mandatory - must be populated before Submit" mandatory="true" id="label_span_icon_${jvar_field_name}"></span>${gs.getMessage('MID Server:')}</label>
		<g:ui_reference class="form-control" name="${jvar_field_name}" query="${jvar_field.mid_reference_qualifier}" id="${jvar_field_name}" table="ecc_agent"/>
	</div>
	</div>
	<script>		
		function hideMidFields() {
			var midFields = gel("connection.mid_server.group");

			if(gel("connection.use_mid").value == 'true'){
				midFields.style.display="block"
			}
			else{
				midFields.style.display="none";
			}
		}
	</script>
</j:jelly>
