<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

	<input name="selected_sys_ids" id="selected_sys_ids" type="hidden" value="" />

    <div id="node_dialog_list" style="height:200px;overflow:auto;" class="col-sm-12">
        <TABLE width="100%" style="table-layout:fixed;">
            <tbody id="node_table_body">
				<h4 class="form_header">${gs.getMessage('Available Nodes')}</h4>
                <j:while test="${jvar_sys_cluster_state.next()}">
                    <TR>
                        <TD style="white-space:nowrap;">
							<div class="form-group">
								<div class="col-sm-12">
									<span class="input-group-checkbox">
										<input id="${HTML:jvar_sys_cluster_state.getValue('system_id')}" name="${HTML:jvar_sys_cluster_state.getValue('system_id')}" onclick="setDownloadButton(this);" title="Select node" value="${HTML:jvar_sys_cluster_state.getValue('system_id')}" type="checkbox" class="checkbox systemID"/>
										<label for="${HTML:jvar_sys_cluster_state.getValue('system_id')}" class="checkbox-label">${HTML:jvar_sys_cluster_state.getValue('system_id')}</label>
									</span>
								</div>
							</div>
                        </TD>
                    </TR>
                </j:while>
            </tbody>
        </TABLE>
    </div>

	<div class="form-group col-sm-12" >
		<div class="col-sm-12">
			<span class="input-group-checkbox">
				<input id="selectAll" name="selectAll" class="checkbox" type="checkbox" onchange="selectAll(this)"/>
				<label for="selectAll" class="checkbox-label">Select All</label>
			</span>
		</div>
	</div>

</j:jelly>
