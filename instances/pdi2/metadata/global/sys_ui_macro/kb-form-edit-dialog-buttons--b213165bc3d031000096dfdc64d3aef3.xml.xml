<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:macro
        cancel_display="false"
        cancel_id="cancel_button"
        cancel_type="submit"
	    cancel_name="${gs.getMessage('Cancel')}"
        cancel="GlideModal.prototype.locate(this).destroy(); return false;"
        
        create_display="true"
        create_id="create_button"
        create_type="submit"
	    create_name="${gs.getMessage('Create')}"
        create="actionCreateRevision()"

        edit_display="true"
        edit_id="edit_button"
        edit_type="submit"
	    edit_name="${gs.getMessage('Stop')}"
        edit="actionEditRevision()"
        
        view_display="true"     
        view_id="view_button"
        view_type="submit"
	    view_name="${gs.getMessage('Review')}"
        view="actionViewRevision()"
    />

    <div>
        <j:if test="${jvar_cancel_display == 'true'}">
            <g:dialog_button
                id="${jvar_cancel_id}"
                type="${jvar_cancel_type}"
                style_class="btn btn-default"
                onclick="${jvar_cancel}">
                ${jvar_cancel_name}
            </g:dialog_button>
        </j:if>

        <j:if test="${jvar_create_display == 'true'}">
            <g:dialog_button
                 id="${jvar_create_id}"
                 type="${jvar_create_type}"
                 style_class="btn btn-primary"
				 onclick="${jvar_create}">
                 ${jvar_create_name}
            </g:dialog_button>
        </j:if>
        
        <j:if test="${jvar_edit_display == 'true'}">
            <g:dialog_button
                 id="${jvar_edit_id}"
                 type="${jvar_edit_type}"
				 style_class="btn btn-destructive-subdued"
				 onclick="${jvar_edit}">
                 ${jvar_edit_name}
            </g:dialog_button>
        </j:if>

        <j:if test="${jvar_view_display == 'true'}">
            <g:dialog_button
                id="${jvar_view_id}"
                type="${jvar_view_type}"
                style_class="btn btn-primary"
                onclick="${jvar_view}">
                ${jvar_view_name}
            </g:dialog_button>
        </j:if>
    </div>
</j:jelly>
