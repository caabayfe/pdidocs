<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<div id="clone_progress_container" style="padding: 10px">
<j2:if test="$[!${ref_parent}.isNewRecord() &amp;&amp; ${ref_parent}.canRead() &amp;&amp; !${ref_parent}.getElement('execution_progress').isNil()]" >
  <h3>Execution Progress</h3>

  <div id="container" style="padding: 25px"/>

  <script>
  var test_execution = "$[${ref_parent}.getValue('execution_progress');]";
  var ctc = new TestClient(test_execution);
  ctc.start();
  </script>
</j2:if>
</div>

</j:jelly>
