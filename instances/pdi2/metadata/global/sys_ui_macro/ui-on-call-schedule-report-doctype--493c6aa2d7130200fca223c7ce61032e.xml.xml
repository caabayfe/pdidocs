<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:ui_form>
		<div class="navbar navbar-default section_zero">
			${gs.getMessage("On-call Rotation Schedule Report")}
			 <input type="hidden" id="groups" name="groups" value="" />
		</div>
		<div class="section-content form-horizontal">
			<div class="row">
				<div class="vsplit col-sm-6">
					<div id="element.schedule_report.report_style" class="form-group">
						<div type="choice">
							<label id="label.schedule_report.report_style" class="col-xs-12 col-md-3 col-lg-4 control-label" for="report_style">
								<span class="label-text">${gs.getMessage("Report style")}</span>
							</label>
						</div>
						<div class="col-xs-10 col-sm-9 col-md-6 col-lg-5 form-field input_controls">
							<select role="listbox" id="report_style" name="report_style" class="form-control">
								<option role="option" value="table" selected="true">${gs.getMessage("Table")}</option>
								<option role="option" value="formatted">${gs.getMessage("Formatted")}</option>
							</select>
						</div>
					</div>
					<g:call function="rota_date.xml" name="start_date" label="Start Date"/>
					<g:call function="rota_date.xml" name="end_date" label="End Date"/>
				</div>
			</div>
		</div>
		<div role="group" tabindex="0" aria-label="${gs.getMessage('Group filtering')}">
			<div class="navbar navbar-default section_zero">
				${gs.getMessage("Groups")}
			</div>
			<div class="section-content form-horizontal">
				<div class="row">
					<div class="vsplit col-sm-6">
						<div id="element.schedule_report.search" class="form-group">
							<div>
								<label class="col-xs-12 col-md-3 col-lg-4 control-label" for="search">
									<span class="label-text">${gs.getMessage("Name starts with")}</span>
								</label>
							</div>
							<div class="col-xs-10 col-sm-9 col-md-6 col-lg-5 form-field input_controls">
								<input id="search" class="form-control edge-input-fix" type="text"/>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="section-content">
				<div class="section-content form-horizontal">
					<div class="row">
						<div class="vsplit col-sm-6">
							<div class="col-lg-12">
								<g:ui_slushbucket up_down="false" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div>
			<button id="run" type="submit" class="btn btn-primary" onClick="return runReportDoctype(this);">${gs.getMessage("Run Report")}</button>
			<div id="status" ></div>
		</div>
	</g:ui_form>
</j:jelly>
