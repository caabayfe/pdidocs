<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:requires name="scripts/sn/common/clientScript/glideUser.js" includes="true" />
	<g2:evaluate var="jvar_user" object="true">
		gs.getUser();
	</g2:evaluate>
	<g2:evaluate var="jvar_roles">
		GlideStringUtil.join(GlideSecurityManager.get().getRoles());
	</g2:evaluate>
	<g2:evaluate var="jvar_connect_installed_and_enabled">
		GlideCollaborationCompatibility.isChatEnabled() $[AND] GlideCollaborationCompatibility.isFrameSetEnabled();
	</g2:evaluate>
	<g:evaluate var="jvar_prop_jsincludes">
		gs.getProperty("glide.ui.js_includes", "true");
	</g:evaluate>
	<title>${gs.getMessage("On-Call Schedules")}</title>
	<!-- Third Party JS -->
	<g:requires name="scripts/lib/jquery_includes.js" includes="true" />
	<g:requires name="scripts/angular_includes_1.5.11.js" includes="true" />
	<g:requires name="scripts/angular_1.5.11/angular-animate.js" includes="true" />
	<!-- SNC JS -->
	<g:requires name="scripts/sn/common/js_includes_common.js" includes="true" />
	<g:requires name="scripts/sn/common/auth/js_includes_auth.js" includes="true" />
	<g:requires name="scripts/sn/common/util/js_includes_util.js" includes="true" />
	<g:requires name="scripts/sn/common/glide/js_includes_glide.js" includes="true" />
	<g:requires name="scripts/angular_1.5.11/ui-bootstrap-tpls-2.5.0.min.js" includes="true" />

	<g:requires name="scripts/includes/js_includes_overridden_prototype_min.js" includes="true" />
	<g:requires name="scripts/lib/glide_updates/prototype.template.js" includes="true" />
	<g:requires name="scripts/lib/glide_updates/prototype.js" includes="true" />
	<g:requires name="scripts/lib/glide_updates/prototype.plugin.js" includes="true" />
	<g:requires name="scripts/doctype/functions_bootstrap14.js" includes="true" />
	<g:requires name="scripts/functions/xmlhttp.js" includes="true" />
	<g:requires name="scripts/classes/event/GwtObservable.js" includes="true" />
	<g:requires name="scripts/doctype/simpleStorage.js" includes="true" />
	<g:requires name="scripts/doctype/GwtMessage14.js" includes="true" />
	<g:requires name="scripts/formatting.js" includes="true" />
	<g:requires name="scripts/doctype/utils14.js" includes="true" />
	<g:requires name="scripts/classes/ajax/GlideURL.js" includes="true" />
	<g:requires name="scripts/ga_batch/js_includes_batchedga.js" includes="true" />
	<g:requires name="scripts/classes/ajax/GlideAjax.js" includes="true" />
	<g:requires name="scripts/classes/util/StopWatch.js" includes="true" />
	<g:requires name="scripts/classes/GlideWindow.js" includes="true" />
	<g:requires name="scripts/classes/doctype/GlideModal.js" includes="true" />
	<j:if test="${jvar_prop_jsincludes == 'false'}">
		<g:requires name="script/app_com.jsdbx" />
		<g:requires name="script/app_com.modelUtil.jsdbx"  />
		<g:requires name="script/sn_on_call_now.app.jsdbx"  />
	</j:if>
	<j:if test="${jvar_prop_jsincludes == 'true'}">
		<g:requires name="script/app_com.jsdbx" includes="true" />
		<g:requires name="script/app_com.modelUtil.jsdbx" includes="true"/>
		<g:requires name="script/sn_on_call_now.app.jsdbx" includes="true"/>
	</j:if>
	<g:requires name="scripts/incident/glide_custom_modal_accessibility.js" includes="true" />
	<g:requires name="scripts/heisenberg/heisenberg_all.js" includes="true" />

	<!-- CSS -->
	<j2:set var="jvar_theme" value="$[gs.getPreference(new GlideThemeUtil().getThemeVersion())]"/>
	<g2:requires name="styles/sn/concourse/css_includes_concourse.css" includes="true" params="c=$[gs.getProperty('css.version')]_$[GlideCacheManager.getFlushStamp('csscsscsscache')]&amp;theme=$[jvar_theme]" />
	<link href="58ea9c83d7110300532c24837e6103dc.cssdbx?v=${gs.getProperty('glide.builddate')}&amp;theme=$[jvar_theme]" rel="stylesheet" type="text/css" />
	<j:if test="${GlideAccessibility.isEnabled()}">
		<link href="8c6b50c3d7110300532c24837e610352.cssdbx?v=${gs.getProperty('glide.builddate')}&amp;theme=$[jvar_theme]" rel="stylesheet" type="text/css" />
	</j:if>
	<j:if test="${jvar_text_direction == 'rtl'}">
		<g:requires name="styles/heisenberg/heisenberg_rtl.css" includes="true" />
		<link href="145bdc83d7110300532c24837e610307.cssdbx?v=${gs.getProperty('glide.builddate')}" rel="stylesheet" type="text/css" />
	</j:if>
</j:jelly>
