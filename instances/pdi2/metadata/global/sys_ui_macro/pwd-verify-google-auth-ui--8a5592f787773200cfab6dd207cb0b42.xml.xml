<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	
  <script language="javascript">
	  addMacroEventListeners('sysparm_otp_code');
  </script>
	
<g:evaluate var="jvar_verification_label" object="true" jelly="true">
	var resetUtil = new global.PasswordResetUtil();
	resetUtil.getVerificationLabel(jelly.sysparm_verification_id);
</g:evaluate>

    <j:choose>
      <!-- Polarisberg -->
      <j:when test="${sn_ui.PolarisUI.canUsePolarisTemplates() &amp;&amp; !gs.isLoggedIn()}">

        <h1 class="pwd-title" id="google-auth-title">${jvar_verification_label}</h1>

        <div class="login-form-field is-required" id="google_auth_form_group">
          <label class="control-label" id="google-auth-label">
            ${gs.getMessage("Enter the code generated by your authenticator app :")}
            <span class="required-marker sn-tooltip-basic" title="${gs.getMessage('Required')}" data-original-title="${gs.getMessage('Required')}" role="img" aria-label="${gs.getMessage('Authenticator app code, Required')}"></span>
          </label>
          <div>
            <input id="sysparm_otp_code" maxlength="256" name="sysparm_otp_code" value="" autocomplete="off" placeholder="" class="form-control pwd-form-control" type="text" required="required" oninput="updateMandatoryMarker(this, 'google_auth_form_group'); clearFieldError('password_comment_${JS,HTML:sysparm_verification_id}', 'verification_forms');" aria-labelledby="google-auth-title google-auth-label"/>
          </div>
        </div>

      </j:when>
      <!-- Heisenberg -->
      <j:otherwise>

        <h2 class="pwd-title" id="google-auth-title">${jvar_verification_label}</h2>

        <div class="form-group is-required" id="google_auth_form_group">
          <label class="control-label col-sm-12" id="google-auth-label">
              <span class="required-marker sn-tooltip-basic" title="${gs.getMessage('Required')}" data-original-title="${gs.getMessage('Required')}" role="img" aria-label="${gs.getMessage('Authenticator app code, Required')}"></span> 
              ${gs.getMessage("Enter the code generated by your authenticator app :")}
          </label>
          <span class="col-sm-12">
              <input id="sysparm_otp_code" maxlength="256" name="sysparm_otp_code" value="" autocomplete="off" placeholder="" class="form-control pwd-form-control" type="text" required="required" oninput="updateMandatoryMarker(this, 'google_auth_form_group'); clearFieldError('password_comment_${JS,HTML:sysparm_verification_id}', 'verification_forms');" aria-labelledby="google-auth-title google-auth-label"/>
          </span>
        </div>

      </j:otherwise>
    </j:choose>

</j:jelly>
