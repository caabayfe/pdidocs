<div class="sn-navhub" role="navigation">
	<div class="sn-navhub-content">
		<div class="sn-navhub-content sn-navhub-content_static sn-navhub-content_row">
			<div class="sn-navhub-content">
				<span class="sn-navhub-title">{{groupOnCallCtrl.form.title}}</span>
				<button class="btn btn-default oc-btn" ng-class="groupOnCallCtrl.isWizardBtnPrimary ? ['btn-primary'] : ['']" ng-if="groupOnCallCtrl.showWizardBtn"
						ng-cloak="" tabindex="0" ng-click="groupOnCallCtrl.redirectWizard()">
					{{groupOnCallCtrl.form.new}}
				</button>

				<form class="oc-board-filter-search ng-pristine ng-valid" role="search">
					<div class="input-group">
						<span class="input-group-addon input-group-select">
						   <span style="position: relative; width: 100%; display: inline-block;">
							  <select ng-readonly="groupOnCallCtrl.textSearchReadOnly" id="filter_search_text" class="form-control" ng-model="groupOnCallCtrl.textSearchType" aria-label="{{groupOnCallCtrl.form.filterTitle}}" ng-change="groupOnCallCtrl.textSearchTypeChange()" ng-options="item.value as item.label for item in groupOnCallCtrl.form.filterOptions" >
							  </select>
							  <i class="select-indicator icon-vcr-down"></i>
						   </span>
						</span>
						<input id="search2" ng-model="groupOnCallCtrl.textSearch" ng-readonly="groupOnCallCtrl.textSearchReadOnly" class="form-control form-control-search ng-pristine ng-untouched ng-valid ng-empty" type="search" name="search2" placeholder="{{groupOnCallCtrl.form.filterTitle}}" sn-trim-on-blur="" aria-invalid="false" aria-label="{{groupOnCallCtrl.form.filterTitle}}"/>
					</div>

				</form>
				<div class="oc-icon-loading" ng-show="groupOnCallCtrl.isLoading">
					<div ng-show="groupOnCallCtrl.isLoading" class="icon icon-loading"></div>
				</div>
			</div>
		</div>
	</div>
	<div class="sn-navhub-content sn-navhub-content_static"><!-- content to the right of header--></div>
</div>
