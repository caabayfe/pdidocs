<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate jelly="true">
		 var style = jelly.jvar_show_subtotal_price == "true" || (jelly.jvar_sc_recurring_subtotal == 'true' &amp;&amp;jelly.jvar_show_recurring_subtotal_price == 'true' &amp;&amp; jelly.jvar_recurring_frequency != null) ? "" : "display: none;";
		 var subtotal_style = jelly.jvar_show_subtotal_price == "true" ? "" : "display: none;";
		 var subtotal_rev_style = jelly.jvar_show_subtotal_price != "true" ? "" : "display: none;";
		 var recurring_subtotal_style = (jelly.jvar_sc_recurring_subtotal == 'true' &amp;&amp;jelly.jvar_show_recurring_subtotal_price == 'true' &amp;&amp; jelly.jvar_recurring_frequency != null) ? "" : "display: none;";
	</g:evaluate>

        <tr id="item_subtotal" style="${style}">
            <td colspan="2">
                <hr />
            </td>
        </tr>
        <tr id="subtotal_price" style="${subtotal_style}">
            <td style="vertical-align: top;">
                <span id="price_subtotal_label_span" style="${subtotal_style}">
                    <strong>
                        ${gs.getMessage('Subtotal')}
                    </strong>
                </span>
            </td>
            <td class="cart_price_cell">
                <span id="price_subtotal_span" style="${subtotal_style}">
                    ${jvar_display_subtotal}
                </span>
            </td>
        </tr>
        <tr id="recurring_subtotal_price" style="${recurring_subtotal_style}">
            <td style="vertical-align: top;">
                   <span id="price_subtotal_label_span subtotal_rev_price" style="${subtotal_rev_style}">
                       <strong>${gs.getMessage('Subtotal')}</strong>
                   </span>
            </td>
            <td class="cart_price_cell">
                <span id="recurring_price_subtotal_span" style="${jvar_recurring_display} font-size: smaller;">
                    + ${jvar_display_subtotal_recurring_price}
                </span>
                <span id="recurring_frequency_subtotal_span" style="${jvar_recurring_display} font-size: smaller;">
                    ${jvar_recurring_frequency}
                </span>
            </td>
        </tr>
</j:jelly>
