<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide"
	xmlns:j2="null" xmlns:g2="null">
	<script language="javascript" src="scripts/classes/SelectListIndent.jsx?v=${gs.getProperty('glide.builddate')}" />
	<g:macro name="selectListIndent" header="Available" sort="true" size="30" width="250" />
	<script eval="true">
		var ${jvar_name} = new SelectListIndent('${jvar_name}', '${jvar_sort}');
	</script>
	<table cellSpacing="0" cellPadding="0" border="0">
		<tr class="header">
			<td vAlign="bottom" align="middle">${jvar_header}</td>
		</tr>
		<tr>
			<td vAlign="top" align="middle" class="slushbody">
				<!-- select list -->
				<select id="${jvar_name}" name="${jvar_name}"
					class="slushselect" size="${jvar_size}"
					style="width:${jvar_width};" ondblclick="${jvar_name}.dblClick();">
				</select>
			</td>
		</tr>
	</table>
</j:jelly>
