<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:evaluate var="jvar_guid" expression="gs.generateGUID(new Object())" />
	<j:if test="${HTML,JS:gs.getPreference('glide.ui.accessibility', 'false')}">
		<div>
			<button tabindex="0" onclick="HOME_SCROLL_SPEED = HOME_SCROLL_SPEED != HOME_PAUSE_SPEED ? HOME_PAUSE_SPEED : HOME_RESUME_SPEED">${gs.getMessage("Pause/Resume scroller")}</button>
		</div>
	</j:if>
	<div id="${jvar_guid}_wrap" style="width:100%;height:${jvar_height};overflow:hidden;"
			 onmouseover="HOME_SCROLL_SPEED=HOME_PAUSE_SPEED"
			 onmouseout="HOME_SCROLL_SPEED=HOME_RESUME_SPEED">
		
		<div id="${jvar_guid}" style="position:relative;left:0px;top:0px;width:100%;">
			<g:insert />
		</div>
	</div>
	<script language="javascript" eval="true">
		setInterval("scroller('${jvar_guid}')", 100);
	</script>
</j:jelly>
