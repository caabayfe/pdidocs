<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:requires name="IndicatorTagControl.jsdbx" />
    <g:evaluate var="jvar_color_accent">
        var map = CSSPropertiesRepository.getSessionProperties();
        map["$color-accent"];
    </g:evaluate>

    <tr>
        <td class="indicatortag_wrapper">
            <div class="indicatortag_control" id="indicatortag_control_container">
            </div>
        </td>
    </tr>
        
    <script>
        new IndicatorTagControl($("indicatortag_control_container"),"$[${ref_parent}.sys_id]");
    </script>
<style>
    .indicatortag_left{
        float: left;
    }
    
    .indicatortag_tags{
        float: left;
    }
    
    .indicatortag_clear{
        clear: both;
    }
    .input-group-transparent {
        float: left;
        margin: 2px;
    }
    #indicatortag_complete{
        float: left;
        padding: 6px 9px 6px 30px;
        height: 32px;
        font-size: 13px;
    }
    
    .indicatortag_control{
        border-bottom: 1px solid #bdc0c4;
        padding-bottom: 5px;
    }
    
    .indicatortag_delete_button{
        margin-left: .4em;
    }
    
    .indicatortag_control_tag:hover {
        box-shadow: 0 6px 18px -9px #000000;
        transition: box-shadow 0.2s;
    }

	.indicatortag_control_tag {
        float: left;
        vertical-align: middle;
        border: 0.07em solid ${jvar_color_accent};
        border-radius: 0.23em;
        margin: 0.153em;
        margin-left: 0.38em;
        height: 2.46em;
        padding: 0.46em 0.69em;
        font-size: 13px;
        line-height: 1.42857;
    }	
    .compact .input-group-transparent .input-group-addon-transparent.icon-search {
        left: 6px;
        top: 2px;
        font-size: 18px;
    }

    .indicatortag_tag_name {
        white-space: nowrap;
    }
    
    .indicatortag_wrapper{
        border-bottom: solid 20px transparent;
    }
</style>
</j:jelly>
