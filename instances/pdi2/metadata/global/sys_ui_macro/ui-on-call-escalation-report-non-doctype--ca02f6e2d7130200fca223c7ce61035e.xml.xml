<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:requires name="styles/rota.css" includes="false"/>
	<g:ui_form>
		<table class="wide">
			<tr class="header">
				<td class="column_head">
					${gs.getMessage("On-call Notification Report")}
					<input type="hidden" id="groups" name="groups" value="" />
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("Date:")}</td>
						</tr>
						<tr>
							<td>
								<g:ui_date_time name="start_date"/>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("Groups:")}</td>
						</tr>
						<tr>
							<td>
							   <label for="search">${gs.getMessage("Name starts with:")}</label>
							   <input id="search" 
								   type="text" 
								   style="width:150px;" 
								   autocomplete="off" 
								   onKeyUp="ac.query=getFilteredQuery(ROTA_JOIN);ac.onKeyUp(event)" />
							   <g:ui_spacer pixels="20" />
							</td>
						</tr>
						<tr>
							<td>
								<g:ui_slushbucket up_down="false" />
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>For each group, show:</td>
						</tr>
						<tr>
							<td>
								<select id="show_type_on_call_person" name="show_type_on_call_person" onchange="showTypeChanged()">
								   <option value="false">${gs.getMessage("Active Escalation members")}</option>
								   <option value="true">${gs.getMessage("On call person")}</option>
								</select>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
				   <button type="submit" id="run" onClick="reportSubmit(this);">${gs.getMessage("Run Report")}</button>
				</td>
			</tr>
			<tr>
				<td id="on_call_status" ></td>
			</tr>
		</table>
	</g:ui_form>
</j:jelly>
