<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j2:set var="jvar_isDoctype" value="$[GlideMobileExtensions.getDeviceType()]" />
	<j2:if test="$[jvar_isDoctype == 'doctype']">
		<tr>
			<td>
				<div style="width:100%;">
					<g:form_label for="${jvar_element_id}">
						${jvar_element_label}
					</g:form_label>
					<div class="${jvar_cols_field} input_controls">
					     <style>
                                                      .-polaris .change-template-form-controls {
                                                          flex-grow: 1;
                                                      }
                                                      .-polaris .change-template-form-controls .condition-row__field-cell {
                                                          width: 245px;
                                                      }
                                                      .-polaris .change-template-form-controls .filter_row_condition {
                                                          table-layout: fixed;
                                                          width: 100%;
                                                      }
                                                      .-polaris .change-template-form-controls .filerTableInput {
                                                          max-width: 100%;
                                                          min-width: 50%;
                                                      }
                                          </style>
						<div class="form-control-static change-template-form-controls">
							<g:insert />
						</div>
					</div>
				</div>
			</td>
		</tr>
	</j2:if>
</j:jelly>
