<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide">
   <g:macro name="date_time" value="${gs.nowDateTime()}" />
   <label for="${jvar_name}" style="display:none">${jvar_name}</label>

   <j:if test="${jvar_readonly == 'true'}">
      <input id="${jvar_name}" type="text" name="${jvar_name}" value="${jvar_value}" onchange="${jvar_onchange}" readonly="true" sn-atf-data-type="glide_date_time"/>
   </j:if>
   <j:if test="${jvar_readonly != 'true'}">
      <g:inline template="element_ui_date_time.xml" />
   </j:if>
  
</j:jelly>
