<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  <g:macro ok="actionOK()" cancel="parent.gel('FormDialog').gWindow.destroy()" 
ok_id="ok_button" cancel_id="cancel_button"/>
  <g:dialog_button id="${jvar_ok_id}" onclick="${jvar_ok}" style="width: 5em;">${gs.getMessage('OK')}</g:dialog_button>
  <g:dialog_button id="${jvar_cancel_id}" onclick="${jvar_cancel}" >${gs.getMessage('Cancel')}</g:dialog_button>
</j:jelly>
