<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<tbody data-sn-macro-sys-id="${jvar_macro_sys_id}">
    <g:requires name="scripts/js_includes_catalog.js" includes="true"/>
    <tr>
        <td class="label_left" width="100%">
            Summary of Task being approved:
            <g:label_spacing />
        </td>
    </tr>
    <g:evaluate var="jvar_ni" expression="var task = ${ref}.sysapproval;" />
    <tr>
        <td>
            <table class="table" width="100%">
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Short Description:
                    </td>
                    <td>
                        ${task.short_description}
                        <g:label_spacing />
                    </td>
                </tr>
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Assigned To:
                    </td>
                    <td>
                        ${task.assigned_to.getDisplayValue()}
                        <g:label_spacing />
                    </td>
                </tr>
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Priority:
                    </td>
                    <td>
                        ${task.priority.getDisplayValue()}
                        <g:label_spacing />
                    </td>
                </tr>
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Requested By
                    </td>
                    <td>
                        ${task.request_item.request.opened_by.getDisplayValue()}
                        <g:label_spacing />
                    </td>
                </tr>
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Requested For
                    </td>
                    <td>
                        ${task.request_item.request.requested_for.getDisplayValue()}
                        <g:label_spacing />
                    </td>
                </tr>
                <tr>
                    <td class="label_left" width="150px">
                        <g:label_spacing />
                        Description:
                    </td>
                    <td class="tdwrap"> ${task.description} </td>
                </tr>
                <tr>
                    <j:set var="jvar_old_ref" value="${ref}" />
                    <g:evaluate>var sc_task = new GlideRecord('sc_task'); sc_task.get(task);</g:evaluate>
                    <j:set var="ref" value="sc_task" />
                    <j:set var="jvar_questionset_read_only" value="true" />
                    <td colspan="2">
                        <g:render_component componentName="com.glideapp.servicecatalog.variables.VEditor" />
                    </td>
                    <j:set var="ref" value="${jvar_old_ref}" />
                </tr>
            </table>
        </td>
    </tr>
	</tbody>
</j:jelly>
