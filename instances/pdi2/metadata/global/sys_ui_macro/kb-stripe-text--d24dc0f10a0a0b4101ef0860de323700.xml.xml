<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
				<td>
				<input type="HIDDEN" id="sysverb_back" />
				</td>
				<td width="100%">
					
					<div class="caption" style="margin-top: 2px;">
<j2:if test="$[jvar_valid_article]">
<g2:evaluate object="true">
		var ka = new KnowledgeAccess();
		ka;
</g2:evaluate>
<j2:if test="$[ka.managerRights(kb, gs)]">
	<a title="$[gs.getMessage('View all articles in this knowledge base')]" href="kb_knowledge_base.do?sys_id=$[kb.kb_knowledge_base]">$[NS:kb.kb_knowledge_base.getDisplayValue()]</a>$[SP]&gt;
</j2:if>
<j2:if test="$[!ka.managerRights(kb, gs)]">
	$[NS:kb.kb_knowledge_base.getDisplayValue()]$[SP]&gt;$[SP]
</j2:if>

<a href="kb_list.do?jvar_view_topic=$[URL:kb.topic]$[AMP]sysparm_kb_search_table=${sysparm_kb_search_table}$[AMP]sysparm_language=$[sysparm_language]$[AMP]sysparm_nameofstack=$[sysparm_nameofstack]$[AMP]sysparm_refer=$[sysparm_this_url]" class="caption_link_chevron" title="$[NS:kb.topic.sys_meta.label]: $[NS:kb.topic.getDisplayValue()]">$[NS:kb.topic.getDisplayValue()]</a>$[SP]&gt;
<j2:if test="$[kb.category != '']">
<a href="kb_list.do?jvar_view_topic=$[URL:kb.topic]$[AMP]jvar_view_category=$[URL:kb.category]$[AMP]sysparm_kb_search_table=${sysparm_kb_search_table}$[AMP]sysparm_language=$[sysparm_language]$[AMP]sysparm_nameofstack=$[sysparm_nameofstack]$[AMP]sysparm_refer=$[sysparm_this_url]" class="caption_link_chevron" title="$[NS:kb.category.sys_meta.label]: 
$[NS:kb.category.getDisplayValue()]">$[NS:kb.category.getDisplayValue()]</a>$[SP]&gt;
</j2:if>
					    <g2:evaluate var="jvar_stripe_desc">
					        var answer;
					        if (GlideXMLUtil.isValidHTML(kb.short_description.getDisplayValue()))
					            answer = kb.short_description.getDisplayValue();
					        else
					            answer = kb.short_description.getHTMLValue();
					        if (answer == "")
					            answer = kb.number;
					        answer;
					    </g2:evaluate>
					    $[NS:jvar_stripe_desc]
</j2:if>
<j2:if test="$[!jvar_valid_article]">
$[gs.getMessage("ARTICLE NOT FOUND")]
</j2:if>
					</div>
				</td>

</j:jelly>
