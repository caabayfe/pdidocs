<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<span data-sn-macro-sys-id="${jvar_macro_sys_id}">
	<j:if test="${jvar_is_ui16}">
		<g:evaluate jelly="true">
			var elemClass = "icon icon-star";
			var isFavorite = true;
			if (jelly.jvar_favorite_id == ""){
				elemClass += "-empty";
				isFavorite = false;
			}
			elemClass;
			isFavorite;
		</g:evaluate>
		<g:evaluate var="jvar_is_pressed" jelly="true">
			!jelly.jvar_favorite_id;
		</g:evaluate>
		<g:evaluate var="jvar_order_status" jelly="true">
			gs.getMessage('Order Status: {0}', jelly.jvar_request_number);
		</g:evaluate>
		${SP}
		<a data-id="${jvar_favorite_id}" id="${jvar_request_id}" role="button" aria-pressed="${isFavorite}" aria-label="${gs.getMessage('Update Favorite')}" title="${gs.getMessage('Update favorite')}" href="" class="${elemClass}" onkeypress="catalogHistory.updateFavoriteKeyHandler(event, '${jvar_request_id}', '${HTML: jvar_order_status}', '${jvar_checkout_url}'); return false;" onclick="catalogHistory.updateFavorite('${jvar_request_id}', '${HTML: jvar_order_status}', '${jvar_checkout_url}'); return false;"></a>
	</j:if>
	<j:if test="${!jvar_is_ui16}">
		${SP}${SP}
		<g:evaluate jelly="true">
			var permalink = GlideappCatalogURLGenerator.escapeForNavTo(jelly.jvar_checkout_url);
		</g:evaluate>
		<a id="permalink" class="linked" style="color:#003366;" target="${jvar_target_frame}" title="${gs.getMessage('bookmark_link_help_note')}" href="nav_to.do?uri=${permalink}">
			${gs.getMessage('Bookmark request')}
		</a>
	</j:if>
	</span>
</j:jelly>
