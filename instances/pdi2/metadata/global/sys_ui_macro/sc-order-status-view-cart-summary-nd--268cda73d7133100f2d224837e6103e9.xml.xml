<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <div id="sc_cart_view">
        <j:if test="${jvar_sc_request.hasRequestItems() == 'true'}">
            <g:com.glideapp.servicecatalog_cart_table target="order_status" prices="true" />
        </j:if>
        <j:if test="${jvar_sc_request.hasRequestItems() != 'true'}">
			<div class="notification notification-warning">${gs.getMessage('Order')}: ${gs.getMessage('Empty')}<button data-dismiss="alert" class="sc_warning_notification_close_btn sc_notification_close_btn btn btn-icon btn-close close icon-cross"><span class="sr-only">Close</span></button></div>
        </j:if>
    </div>
</j:jelly>
