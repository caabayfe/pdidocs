<div ng-if="groupOnCallCtrl.showPinnedNotification" class="alert alert-success oc-notification" role="alert" ng-show="groupOnCallCtrl.showGroupPinnedMsg">
	<span class="notification-icon icon-check-circle"></span>
	<span class="oc-notification-msg" tabindex="0">{{groupOnCallCtrl.form.onCallSchedulePinnedMsg}}</span>
	<button class="btn-icon close icon-cross" tabindex="0" ng-click="groupOnCallCtrl.showGroupPinnedMsg=false" data-dismiss="alert">
		<span class="sr-only">{{groupOnCallCtrl.form.close}}</span>
	</button>
</div>
