<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <j:if test="${jvar_cart.isEmpty() != 'true' &amp;&amp; jvar_has_item == 'true'}">
        <j:if test="${jvar_sc_special_instructions == 'true'}">
			<g:include_script src="CartCheckoutFunctionsV2.jsdbx" />
	        
			<j:if test="${RP.isPopup()}">
				<g:requires inline="true" name="scripts/elements/textarea_sizer.js" />
				<g:requires inline="true" name="scripts/elements/textarea_autosizer.js" />
			</j:if>
			<j:if test="${!RP.isPopup()}">
				<g:requires position="last" inline="true" name="scripts/elements/textarea_sizer.js" />
				<g:requires position="last" inline="true" name="scripts/elements/textarea_autosizer.js" />
			</j:if>
        	<div class="container">
				<div class="row col-xs-12 sc_cv_info_row">
					<label class="col-xs-2 sc_requested_label" for="special_instructions">
						${gs.getMessage('Special instructions')}
					</label>
					<div class="col-xs-8">
						<script language="javascript">
							addLoadEvent(
							function() {
							if (window["textareaResize"])
							textareaResize("special_instructions");
							}
							);
						</script>
						<textarea id="special_instructions" class="question_textarea_input cat_item_option form-control" rows="5" name="special_instructions" wrap="soft" onChange="catSpecialInstructions('', 'special_instructions','$[sysparm_cart_name]');">
							${HTML:jvar_cart.getSpecialInstructions()}
						</textarea>
					</div>
				</div>
			</div>
        </j:if>
    </j:if>
</j:jelly>
