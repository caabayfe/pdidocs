<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
  
  <g:evaluate var="jvar_section_1_title" jelly="true">
    section_1_title = "${gs.getMessage('System Configuration')}";
    if (typeof jelly.jvar_section_1_title !== "undefined")
      section_1_title = jelly.jvar_section_1_title;

    section_1_title;
  </g:evaluate>

  <g:evaluate var="jvar_section_2_title" jelly="true">
    section_2_title = "${gs.getMessage('Application Administration - Configure Behavior and User Interface')}";
    if (typeof jelly.jvar_section_2_title !== "undefined")
      section_2_title = jelly.jvar_section_2_title;

    section_2_title;      
  </g:evaluate>
	
  <table border="0" cellspacing="6" id="${jvar_name}" width="100%">
    <tr class="header">
      <td colspan="3"><g:inline template="catalog_title_simple.xml" title="${jvar_section_1_title}"/></td>
    </tr>
    <tr>
      <td id="dropzone1" dropzone="true" valign="top" width="33%"/>
      <td id="dropzone2" dropzone="true" valign="top" width="33%"/>
      <td id="dropzone3" dropzone="true" valign="top" width="33%"/>
    </tr>
    <tr class="header">
      <td colspan="3"><g:inline template="catalog_title_simple.xml" title="${jvar_section_2_title}"/></td>
    </tr>
    <tr>
      <td id="dropzone501" dropzone="true" valign="top" width="33%"/>
      <td id="dropzone502" dropzone="true" valign="top" width="33%"/>
      <td id="dropzone503" dropzone="true" valign="top" width="33%"/>
    </tr>
  </table>
</j:jelly>
