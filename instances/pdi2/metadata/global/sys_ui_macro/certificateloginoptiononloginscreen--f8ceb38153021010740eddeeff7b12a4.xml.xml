<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
		<style>
			a.cert{
				text-decoration: none;
				position: relative;
				display: inline-block;
				width: 100%;
				font-size: 14px;
				border: 1px solid #b3bac7;
				border-radius: 3px;
				cursor: pointer;
				text-align: center;
				line-height: 30px;
				height: 32px;
				margin-top: 9px;
				font-style: var(--now-button--font-style, var(--now-actionable--font-style, normal));
    			font-weight: var(--now-button--font-weight, var(--now-actionable--font-weight, normal));
			}

			a.cert:hover {
				background: #F4F6F9;
			}

			a.cert img {
				height: 20px;
				width: 20px;
				margin-bottom: 3px;
				margin-right: 9px;
			}

			a.cert span {
				overflow-wrap: break-word;
			}
		</style>
        <!-- Polarisberg -->
        <j:if test="${sn_ui.PolarisUI.canUsePolarisTemplates()}">
          <style>
            a.cert {
				font-size: var(--now-global-font-size--md, 14px);
				border: 1px solid RGB(var(--now-button--secondary--border-color,var(--now-color--neutral-4, 188,195,199)));
				border-radius: var(--now-global-border-radius--md, 6px);
				background: RGB(var(--now-color_background--primary, var(--now-color--neutral-0, 255, 255, 255)));
				color: RGB(var(--now-button--secondary--color, var(--now-color--primary-1, 0,128,163)));
			}

            .login-amb a.cert { color: unset; }
			
			a.cert:hover {
				background: RGB(var(--now-color_surface--neutral-2, 241, 242, 243));
				border-color: RGB(var(--now-button--secondary--border-color--hover,var(--now-color--neutral-5, 170,178,182)));
				color: RGB(var(--now-button--secondary--color--hover, 0,86,110));
				box-shadow: 0px 2px 4px 0px RGBA(56,56,56,0.4);
			}
			a.cert:active {
				background: RGB(var(--now-color_surface--neutral-4, 219, 223, 225));
				border-color: RGB(var(--now-button--secondary--border-color--active,var(--now-color--neutral-7,133,144,149)));
				color: RGB(var(--now-button--secondary--color--active, var(--now-color--primary-3, 0,45,57)));
			}
          </style>
			<div>
				<a href="login_with_certificate.do?sys_action=sysverb_login_with_certificate" class="cert">
				<span>${gs.getMessage('PIV/CAC card')}</span>
				</a>
			</div>
        </j:if>
		<j:if test="${!sn_ui.PolarisUI.canUsePolarisTemplates()}">
			<div>
				<a href="login_with_certificate.do?sys_action=sysverb_login_with_certificate" class="cert">
				<img alt="icon" src="certLoginLogo.svg"/>
				<span>${gs.getMessage('PIV/CAC card')}</span>
				</a>
			</div>
		</j:if>
			
</j:jelly>
