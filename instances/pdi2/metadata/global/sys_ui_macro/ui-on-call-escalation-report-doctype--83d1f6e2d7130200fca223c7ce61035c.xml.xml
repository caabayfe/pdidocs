<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:ui_form>
		<div class="navbar navbar-default section_zero">
			${gs.getMessage("On-call Notification Report")}
			<input type="hidden" id="groups" name="groups" value="" />
		</div>
		<div class="section-content form-horizontal">
			<div class="row">
				<div class="vsplit col-sm-6">
					<div id="element.schedule_report.show_type" class="form-group">
						<div type="choice">
							<label id="label.schedule_report.show_type" class="col-xs-12 col-md-3 col-lg-4 control-label" for="show_type">
								<span class="label-text">${gs.getMessage("For each group, show")}</span>
							</label>
						</div>
						<div class="col-xs-10 col-sm-9 col-md-6 col-lg-5 form-field input_controls">
							<select id="show_type_on_call_person" name="show_type_on_call_person" onchange="showTypeChanged()" class="form-control">
								<option value="false">${gs.getMessage("Active Escalation members")}</option>
								<option value="true">${gs.getMessage("On call person")}</option>
							</select>
						</div>
					</div>
					<g:call function="rota_date_time.xml" name="start_date" label="Start Date"/>
				</div>
			</div>
		</div>
		<div class="navbar navbar-default section_zero">
			${gs.getMessage("Groups")}
		</div>
		<div class="section-content form-horizontal">
			<div class="row">
				<div class="vsplit col-sm-6">
					<div id="element.schedule_report.search" class="form-group">
						<div>
							<label id="label.schedule_report.group" class="col-xs-12 col-md-3 col-lg-4 control-label" for="search">
								<span class="label-text">${gs.getMessage("Name starts with")}</span>
							</label>
						</div>
						<div class="col-xs-10 col-sm-9 col-md-6 col-lg-5 form-field input_controls">
							<input id="search" class="form-control" type="text"/>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="section-content">
			<div class="section-content form-horizontal">
				<div class="row">
					<div class="vsplit col-sm-6">
						<div class="col-lg-12">
							<g:ui_slushbucket up_down="false" />
						</div>
					</div>
				</div>
			</div>
		</div>
		<div id="report_button">
			<button id="run" type="submit" class="btn btn-primary" onClick="return reportSubmitDoctype(this);">${gs.getMessage("Run Report")}</button>
			<div id="on_call_status" ></div>
		</div>
	</g:ui_form>
</j:jelly>
