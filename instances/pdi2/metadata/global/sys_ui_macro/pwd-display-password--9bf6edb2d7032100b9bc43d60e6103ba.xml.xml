<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<script type="text/javascript">

  addLoadEvent(showPhoneticPassword);

  function showPhoneticPassword() {
    gel('phonetic_password').innerHTML = gel('password').innerText;
  }
</script>

  ${gs.getMessage('The new password is')}
  <g:evaluate var="jvar_new_pwd" object="true"  jelly="true">
    new PwdResetStageHandler().getPasswordWithPhonetics();
  </g:evaluate>
  <g:evaluate var="jvar_auto_pwd" object="true" jelly="true">
    var autoGenPasswordPhonetic = jelly.jvar_new_pwd.phoneticPassword;
	  var autoGenPassword = jelly.jvar_new_pwd.password + "";
	  var autoGenPasswordHTML = "<p>";
	  for (var index = 0; index &lt; autoGenPassword.length; index++) {
		  var pwdChar = autoGenPassword.charAt(index);
		  if (autoGenPasswordPhonetic.hasOwnProperty(pwdChar)) {
			  autoGenPasswordHTML += autoGenPasswordPhonetic[pwdChar] + "<br/>";
		  }
	  }
	  autoGenPasswordHTML += "</p>";
    autoGenPasswordHTML;
  </g:evaluate>
  <br />
  <j:choose>
	<!-- Polarisberg -->
	<j:when test="${sn_ui.PolarisUI.canUsePolarisTemplates() &amp;&amp; !gs.isLoggedIn()}">
	    <div style="display: flex; flex-direction: row; margin-top: 5px; margin-bottom: 20px;">
    		<input type="password" id="new_autogenerate_password" name="new_autogenerate_password" class="form-control" value="${jvar_new_pwd.password}" disabled="true" style="margin-right: 4px;"/>
    		<button
		    id="mask_icon_retype"
		    type="button"
		    class="btn btn-default icon-preview input-group-append mask_btn sn-tooltip-basic"
		    onClick="renderMaskIcon(this, 'new_autogenerate_password'); showHidePhoneticReading();"
		    aria-label="${gs.getMessage('Show password')}"
		    data-original-title="${gs.getMessage('Show password')}"/>
  	    </div>
	</j:when>
	<!-- Heisenberg -->
	<j:otherwise>
	    <div style="display: flex; flex-direction: row; margin-top: 1rem; margin-left: auto; margin-right: auto; width: 300px;">
                <input type="password" id="new_autogenerate_password" name="new_autogenerate_password" class="form-control pwd-form-control pwd-reset-sub-body-new" value="${jvar_new_pwd.password}" disabled="true" style="margin-right: 4px;"/>
        	<button
        	    id="mask_icon_retype"
            	    type="button"
            	    class="btn btn-default icon-preview input-group-append mask_btn sn-tooltip-basic pwd-reset-mask-button"
            	    onClick="renderMaskIcon(this, 'new_autogenerate_password'); showHidePhoneticReading();"
            	    aria-label="${gs.getMessage('Show password')}"
		    data-original-title="${gs.getMessage('Show password')}"/>
      	   </div>
	</j:otherwise>
  </j:choose>
  <div id="password" hidden="true">${jvar_auto_pwd}</div>
  <div id="phonetic_view" hidden="false">
    <h4>${gs.getMessage('Phonetic Reading:')}</h4>
    <div id="phonetic_password" style="line-height:10px;"></div>
  </div>
</j:jelly>
