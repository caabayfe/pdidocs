<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <j:set var="jvar_search_label" value="${gs.getMessage('Search')}"/>
    <label for="sysparm_search" style="display:none">${jvar_search_label}</label>
    <input size="${jvar_size}" 
        id="sysparm_search" 
        name="sysparm_search" 
        autocomplete="off"
        onfocus="this.select();this.style.color = '#000';if (!this.ac) { addLoadEvent(function() {var e = $('sysparm_search'); 
            if (!e.ac) new AJAXTextSearchCompleter('global_search_completer', 'sysparm_search', 'right', 
                $$('span.globalSearch')[0]);}) } else this.ac.cacheClear();"
        onblur="this.style.color = '#999';" 
        accesskey="s"
        onkeydown="return acReferenceKeyDown(this, event);"
        onkeypress="return acReferenceKeyPress(this, event);"
        onkeyup="return acReferenceKeyUp(this, event);"
        function="$('textsearch').submit()" 
        style="color:#999; border:solid 0px;"
        title="${jvar_search_label}" alt="${jvar_search_label}"
        placeholder="${gs.getMessage('Search')}" />
    <input type="image" class="searchGlass" src="images/search_glass.gifx" width="14" height="18" title="${jvar_search_label}" alt="${jvar_search_label}"/>
    <a style="margin-left:4px" tabindex="0" onkeypress="contextShow(event, 'search', 200, grabOffsetTop(this) + 20, 0, grabOffsetLeft(this) + 12);event.cancelBubble=true;" onclick="contextShow(event, 'search', 200, grabOffsetTop(this) + 20, 0, grabOffsetLeft(this) + 12);event.cancelBubble=true;" title="${gs.getMessage('Recent searches')}">
        <img border="0" id="imgText2" src="images/drop_down.gifx" alt="${gs.getMessage('Recent searches')}"/>
    </a>
</j:jelly>
