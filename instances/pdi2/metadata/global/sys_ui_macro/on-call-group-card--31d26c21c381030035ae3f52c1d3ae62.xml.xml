<div class="oc-card-component" ng-if="group.rota" id="{{group.id}}_{{group.rota.id}}">
	<div class="groupname oc-truncate" uib-tooltip="{{group.name}}" show-tooltip-on-text-overflow="" tooltip-class="oc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="false">
		<span ng-bind-html="groupOnCallCtrl.highlight(group.name, groupOnCallCtrl.textSearch, groupOnCallCtrl.textSearchType !== 'group_schedule')"></span>
	</div>
	<div ng-if="group.rota.name &amp;&amp; !groupOnCallCtrl.isRTL" class="rotaname oc-truncate" uib-tooltip="{{group.rota.name + ' ' + groupOnCallCtrl.form.to.withValues([group.rota.start, group.rota.end]) + ' - ' + groupOnCallCtrl.getMembers(group.rota)}}" show-tooltip-on-text-overflow="" tooltip-class="oc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="false">
		<span ng-bind-html="groupOnCallCtrl.highlight(group.rota.name, groupOnCallCtrl.textSearch, groupOnCallCtrl.textSearchType !== 'group_schedule')"></span>
		<span class="rotatimes" ng-if="group.rota.start &amp;&amp; group.rota.end">{{groupOnCallCtrl.form.to.withValues([group.rota.startTime, group.rota.endTime])}}</span>
		<span class="rotamembers" ng-if="group.rota.rosters.length > 0">
			<span class="card-small-dot-ltr"></span>
			{{groupOnCallCtrl.getMembers(group.rota)}}
		</span>
		<span class="rotatimes" ng-if="!group.rota.start &amp;&amp; !group.rota.end"></span>
	</div>
	<div ng-if="group.rota.name &amp;&amp; groupOnCallCtrl.isRTL" class="rotaname oc-truncate" uib-tooltip-html="'${AMP}lrm;{{groupOnCallCtrl.getMembers(group.rota) + ' - ' + groupOnCallCtrl.form.to.withValues([group.rota.end, group.rota.start]) + ' ' + group.rota.name}}'" show-tooltip-on-text-overflow="" tooltip-class="oc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="true">
		<span class="rotamembers" ng-if="group.rota.rosters.length > 0">
			${AMP}lrm;<span class="card-small-dot-rtl"></span>
			{{groupOnCallCtrl.getMembers(group.rota)}}
		</span>
		<span class="rotatimes" ng-if="group.rota.start &amp;&amp; group.rota.end">{{groupOnCallCtrl.form.to.withValues([group.rota.endTime, group.rota.startTime])}}</span>
		<span class="rotatimes" ng-if="!group.rota.start &amp;&amp; !group.rota.end"></span>
		<span ng-bind-html="groupOnCallCtrl.highlight(group.rota.name, groupOnCallCtrl.textSearch, groupOnCallCtrl.textSearchType !== 'group_schedule')"></span>
	</div>
	<div ng-if="group.rota" ng-repeat="roster in group.rota.rosters | limitTo:groupOnCallCtrl.quantity track by roster.id">
		<div ng-if="roster.member" class="oc-roster-member" id="{{roster.id}}_{{roster.member.user.id}}">
			<div class="user-avatar">
				<div ng-click="groupOnCallCtrl.togglePopover($event, roster)" class="user-presence" uib-popover-template="groupOnCallCtrl.getPopoverTemplate(roster.member)" popover-trigger="outsideClick" popover-is-open="groupOnCallCtrl.openPopover(roster)" popover-placement="{{groupOnCallCtrl.profilePlacement}}" popover-animation="true" popover-append-to-body="true" aria-label="{{roster.member.user.name}} ${gs.getMessage('avatar')}">
					<sn-avatar primary="roster.member.user.sys_id" enable-context-menu="false" nopopover="true">
						<sn-presence user="primary"></sn-presence>
					</sn-avatar>
				</div>
				<div class="user-info">
					<span class="user-name" ng-bind-html="groupOnCallCtrl.highlight(roster.member.user.name, groupOnCallCtrl.textSearch, groupOnCallCtrl.textSearchType !== 'user')"></span>
					<span class="info">
						<span class="roster oc-truncate" uib-tooltip="{{roster.name}}" show-tooltip-on-text-overflow="" tooltip-class="oc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="false" aria-label="{{roster.name}}" ng-if="roster.name">{{roster.name}}</span>
					</span>
				</div>
				<div style="clear: both"></div>
			</div>
		</div>
	</div>
	<div class="oc-pin-action-count">
		
		<div class="oc-pinned pinned" ng-click="tooltipPinnedIsOpen=false; groupOnCallCtrl.togglePinned($event, group)" tabindex="0" uib-tooltip="{{groupOnCallCtrl.form.unpinOnCallSchedule}}" tooltip-placement="bottom" tooltip-is-open="tooltipPinnedIsOpen" tooltip-class="oc-pinned-tooltip" role="button" aria-label="{{groupOnCallCtrl.form.unpinOnCallSchedule}}" ng-focus="group.showPin = true; tooltipPinnedIsOpen=true" ng-blur="group.showPin=false; tooltipPinnedIsOpen=false" ng-if="groupOnCallCtrl.isPinned(group.sys_id)">
			<i class="icon-tack oc-icon-tack" />
		</div>
		
		<div class="oc-pinned unpinned" ng-click="tooltipUnpinnedIsOpen=false; groupOnCallCtrl.togglePinned($event, group)" tabindex="0" uib-tooltip="{{groupOnCallCtrl.form.pinOnCallSchedule}}" tooltip-placement="bottom" tooltip-is-open="tooltipUnpinnedIsOpen" tooltip-class="oc-pinned-tooltip" role="button" aria-label="{{groupOnCallCtrl.form.pinOnCallSchedule}}" ng-focus="group.showPin = true; tooltipUnpinnedIsOpen=true; tooltipUnpinnedIsOpen=true" ng-blur="group.showPin=false; tooltipUnpinnedIsOpen=false" ng-if="!groupOnCallCtrl.isPinned(group.sys_id)">
			<i class="icon-tack" ng-class="group.showPin ? 'oc-icon-tack' : 'oc-icon-tack-hidden'" />
		</div>
		
		<div class="oc-card-actions-count" ng-if="group.actionsCount" uib-tooltip-html="'{{groupOnCallCtrl.pendingActionMsg(group.actionsCount)}}'" tooltip-class="oc-pinned-tooltip" tooltip-placement="bottom" aria-label="{{groupOnCallCtrl.getActionCountAriaMessage(group.actionsCount)}}" tooltip-append-to-body="true">
			<span>{{group.actionsCount.gaps + group.actionsCount.oddities + group.actionsCount.timeOffRequests}}</span>
		</div>
	</div>
	<div ng-if="group.rota.rosters.length > 0" class="rosters-escalation-details">
		<div class="oc-modal-popover" ng-controller="ModalRostersCtrl as modalRostersCtrl" id="modalShowRosters_{{$index}}" name="modalShowRosters">
			<button class="btn btn-link oc-btn-link" tabindex="0" ng-click="groupOnCallCtrl.closeMemberDialogs('');modalRostersCtrl.open($event, group);" ng-keydown="modalRostersCtrl.handleKeyAction($event, group, groupOnCallCtrl);">{{groupOnCallCtrl.form.showRosterEscalationPath}}</button>
		</div>
	</div>
</div>
