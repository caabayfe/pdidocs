<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
   <g:evaluate>
     var def_id = members.graph.jrobin_definition + '';
     var source = new GlideRecord('jrobin_graph_line');
     source.addQuery('jrobin_graph', members.graph);
     source.orderBy('jrobin_datasource.name');
     source.query();
   </g:evaluate>

     <table id="controls_$[jvar_guid]_$[members.graph]">
     <tr>
     <j:while test="${source.next()}">       
       <td>
         <table cellspacing="0" cellpadding="0" style="border:1px solid black">
            <tr>
              <td style="width:12px;height:12px;background-color:${source.color};background-image:url(./images/checked12.pngx)"
                onclick="graphChange(event, '$[jvar_guid]', '$[members.graph]')"
                gsft_checked="true" gsft_base_color="${source.color}" id="$[source.sys_id]">

              </td>
            </tr>
         </table>
       </td>
       <td>
         <g:evaluate>
            var haveLabel = (source.jrobin_datasource.label != '');
         </g:evaluate>
         <j:if test="${haveLabel}">
            ${source.jrobin_datasource.label}
         </j:if>
         <j:if test="${!haveLabel}">
            ${source.jrobin_datasource.name}
         </j:if>
       </td>
     </j:while>
     </tr>
  </table>

</j:jelly>
