<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="true" xmlns:g="glide" xmlns:g2="null" xmlns:j="jelly:core" xmlns:j2="null">
	<j2:if test="$[jvar_wish_list_cart_edit]">
		<!-- Table is alwys sc_cart_item for a wish list item -->
		<g2:attachment_list table="sc_cart_item" sys_id="$[attachment_cat_id]">
			<j2:set var="jvar_attachment_url"
				value="javascript:saveCatAttachment(gel('sysparm_attachment_cart_id').value, 'sc_cart_item')" />
			<g:inline template="attachment_list_body.xml" />
		</g2:attachment_list>
	</j2:if>
	<j2:if test="$[!jvar_wish_list_cart_edit]">
		<g2:attachment_list table="$[item_table]" sys_id="$[item_guid]">
			<j2:set var="jvar_attachment_url"
				value="javascript:saveCatAttachment(gel('sysparm_item_guid').value, '$[item_table]')" />
			<g:inline template="attachment_list_body.xml" />
		</g2:attachment_list>
	</j2:if>
</j:jelly>
