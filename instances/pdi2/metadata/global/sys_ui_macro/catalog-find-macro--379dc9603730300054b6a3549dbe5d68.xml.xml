<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <div data-sn-macro-sys-id="${jvar_macro_sys_id}">
        <j2:set var="jvar_is_catalog" value="${true}" />
        <j:set var="jvar_aria_page_title" value="${gs.getMessage('Catalog Search Results')}" />
        <div role="navigation" aria-label="${jvar_aria_page_title}">
            <table border="0" cellpadding="0" cellspacing="0" style="width: 100%" role="presentation">
                <tbody>
                    <g2:sc_header useAddButton="false" search="$[sysparm_search]" catalog="$[sysparm_catalog]" view="$[sysparm_view]" catalogView="$[sysparm_catalog_view]" processingHint="$[sysparm_processing_hint]" category="$[sysparm_parent]" noCheckout="$[sysparm_no_checkout]" isSearch="true" isBrowse="false" isItem="false" useSearch="true" ignore="true" st="true" currentRow="$[sysparm_current_row]" baseForm="$[sysparm_base_form]" />
                </tbody>
            </table>
        </div>
        <table border="0" cellpadding="0" cellspacing="0" style="width: 100%" role="presentation">
            <tbody>
                <tr>
                    <td style="width: 100%">
                        <table class="wide" cellspacing="0" cellpadding="0" role="main" aria-label="${jvar_aria_page_title}">
                            <tbody>
                                <g2:com.glideapp.servicecatalog_search type="catalogFind" term="$[sysparm_search]" catalog="$[sysparm_catalog]" view="$[sysparm_catalog_view]" hint="$[sysparm_processing_hint]" category="$[sysparm_parent]" />
                            </tbody>
                        </table>
                    </td>
                    <j2:if test="$[jvar_printed_some &amp;&amp; !jvar_streammode]">
                        <td style="vertical-align: top; padding: 5px;">
                            <table class="sc_cat_set_window" role="region" aria-label="${gs.getMessage('Found In')}">
                                <tbody>
                                    <tr class="sc_cat_set_window_header_row">
                                        <td>
                                            <table class="drag_section_header" style="width: 100%;" role="presentation">
                                                <tbody>
                                                    <tr>
                                                        <td class="sc_cat_set_window_header_cell_left">
                                                        </td>
                                                        <td class="drag_section_movearea" style="vertical-align: top; padding:5px">
                                                            ${gs.getMessage("Found In")}
                                                        </td>
                                                        <td class="drag_section_debug">
                                                        </td>
                                                        <td class="sc_cat_set_window_header_cell_right">
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr style="height: 100%; vertical-align: top; ">
                                        <td style="padding: 5px;">
                                            <table role="presentation" cellspacing="0" cellpadding="0" style="width: 200px; min-width: 200px; max-width: 200px; border-collapse: 0px;">
                                                <tbody>
                                                    <g2:com.glideapp.servicecatalog_search_categories_set category="$[sysparm_parent]" ck="$[gs.getSessionToken()]" search="$[sysparm_safe_search]" categories="$[sysparm_categories]" />
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </j2:if>
                </tr>
                <g2:inline template="catalog_search_messages.xml" />
            </tbody>
        </table>
    </div>
</j:jelly>
