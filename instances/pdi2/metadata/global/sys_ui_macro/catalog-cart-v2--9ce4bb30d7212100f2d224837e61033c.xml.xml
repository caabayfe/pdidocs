<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <!-- Invoke a template that writes catalog and view to page -->
    <g:inline template="sc_catalog_view.xml" />
    <input type="hidden" id="cart_v2" value="${new SNC.ServiceCatalogLayoutService().useSCLayout()}" />
    <j:if test="${sysparm_cartless == 'true'}">
        <j:set var="jvar_cart_style" value="display: none;"/>
    </j:if>
    <div id="sc_cart_contents" style="margin: 5px; ${jvar_cart_style}" data-sn-macro-sys-id="${jvar_macro_sys_id}">
        <table id="qty" class="sc_cart_window" style="min-width: 200px; max-width: 200px; margin: 0px; margin-bottom: 2px; ${jvar_cart_style}" border="0" role="region" aria-labelledby="order_item_title">
            <g:com.glideapp.servicecatalog_cart target="order_item" 
												prices="false" 
												cartName="${sysparm_cart_name}"/>
        </table>
        <table id="sc_cart_item_list" class="sc_cart_window" style="min-width: 200px; max-width: 200px; margin: 0px; margin-bottom: 2px; display: none;" border="0" role="region" aria-labelledby="shopping_cart_title" aria-live="assertive">
            <g:com.glideapp.servicecatalog_cart target="shopping_cart" 
												prices="true" 
												cartName="DEFAULT"/>
        </table>
    </div>
</j:jelly>
