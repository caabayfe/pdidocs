<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<div id="dropzones_container">
		<div id="content_container">
			<table border="0" cellspacing="6" id="${jvar_name}" width="100%">
				<tr>
					<td id="dropzone1" dropzone="true" valign="top" width="50%">
					</td>
					<td id="dropzone2" dropzone="true" valign="top" width="50%">
					</td>
				</tr>
				<tr>
					<td id="dropzone3" dropzone="true" valign="top" width="50%">
					</td>
					<td id="dropzone4" dropzone="true" valign="top" width="50%">
					</td>
				</tr>
			</table>
		</div>
		<div id="dropzone5" dropzone="true"></div>
	</div>
	<style>
			#content_container {
				display: inline-block;
				min-width: 79%;
			}

			#dropzone5 {
				display: inline-block;
				height: 100%;
				position: absolute;
				min-width: 19%;
				border-left: 1px solid lightgrey;
				padding-left: 10px;
			}

			#dropzones_container {
				position: absolute;
				width: 100%;
			}

			/**
			 * Prevent css styles on the rest of the page to size the mutliple select filters on the
			 * right side as it causes the elements to be too small and adds scrollbars.
			 */
			.compact .form-control {
				height: auto;
			}

			/**
			 * Styles for the layout preview
			 */
			.layout_edit_preview #dropzones_container {
				text-align: left;
				position: static;
			}

			.layout_edit_preview #dropzone5 {
				height: 34%;
				min-width: 12%;
			}

			/**
			 * Styles for the layout in the add content dialog from the homepage / dashboard
			 */
			#render_layout_preview #dropzones_container {
				position: static;
				text-align: left;
			}

			#render_layout_preview #dropzone5 {
				height: 10%;
			}

			#render_layout_preview #dropzone5 a.web{
				line-height: 4;
				height: 100%;
			}

			/**
			 * Styles for the layout in the add content dialog from the report builder
			 */
			#body_dialog_add_gauge #dropzone5 {
				height: 14%;
			}
	</style>
</j:jelly>
