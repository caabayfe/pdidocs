<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<div for_cat="${jvar_category.getID()}" style="padding-bottom: 5px; display: block;" data-sn-macro-sys-id="${jvar_macro_sys_id}">
		<span>
			<img style="vertical-align: top; width: 24px; height: 24px;" src="${jvar_iconsrc}" alt="${jvar_subcat.getTitle()}"></img>
		</span>
		<j:if test="${!RP.isInteractive()}">
			<span> ${jvar_subcat.getTitle()} </span>
		</j:if>
		<j:if test="${RP.isInteractive()}">
			<a href="${jvar_href}">${jvar_subcat.getTitle()}</a>
		</j:if>
		<j:if test="${jvar_use_popup_desc}">
			<span tabindex="0"  class="icon-info" onclick="event.stopPropagation(); popCatDiv(event, '${jvar_subcat.getID()}')" ></span>
		</j:if>
	</div>
</j:jelly>
