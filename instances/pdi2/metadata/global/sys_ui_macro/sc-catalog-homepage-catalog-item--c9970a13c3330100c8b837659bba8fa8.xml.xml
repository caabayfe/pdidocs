<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:evaluate var="jvar_link_url" jelly="true">
        var jvar_link_url = GlideappCatalogURLGenerator.getHomepageCatalogLink("${jvar_catalog.getID()}", "${jvar_catalog_view}");
        jvar_link_url;
    </g:evaluate>
    <div style="white-space: nowrap;" class="homepage_category_only" data-sn-macro-sys-id="${jvar_macro_sys_id}">
      <a style="color:#000;" target="_self" href="${jvar_link_url}">
        <table style="width: 100%; height: 100%;">
          <tr>
            <j:if test="${jvar_catalog.getDesktopImageSRC() != ''}">
              <td class="homepage_category_only_image_cell" style="text-align: center; vertical-align: middle;">
                <span style="margin: 0px 10px 0px 0px; padding:10px 10px 10px 10px;">
                  <img alt="${jvar_catalog.getTitle()}" style="height:100px; width:100px;" src='${jvar_catalog.getDesktopImageSRC()}' onclick="document.location.href='${jvar_link_url}'; return false;"/>
                </span>
              </td>
	    </j:if>
            <td class="homepage_category_only_description_cell" style="width: 100%; vertical-align: top;" onclick="document.location.href='${jvar_link_url}'; return false;">
              <a style="color:#000;" target="_self" href="${jvar_link_url}">
                <span>
                  <h2 style="margin: 10px 0px 0px 0px; font-size:larger; font-weight:normal;">
                    ${jvar_catalog.getTitle()}
                  </h2>
                </span>
              </a>
              <span style="color:#888; white-space:normal;">
                ${jvar_catalog.getDescription()}	
              </span>
            </td>
          </tr>
        </table>
      </a>
    </div>
</j:jelly>
