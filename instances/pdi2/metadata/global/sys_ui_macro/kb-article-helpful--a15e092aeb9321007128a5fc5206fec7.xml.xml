<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	
	<!-- ratings and options -->
<j2:if test="$[kbViewInfo.showKBHelpfullRating]">
	<span>
		<span id="articlerating">
			<span id="yesarticlerating" class="kb_link" >
			        <span id="wasThisHelpful" class="snc-article-header-toolbar-left" title="${i18n('Was this article helpful?')}" >
					<span id="wasThisHelpfulText">${gs.getMessage('Was this helpful?')}</span>$[SP]
					<span id="wasThisHelpfulUncheckedIcon" class="icon-checkbox-empty" onclick="changeWasThisHelpfulToOn(this, '$[JS:knowledgeRecord.sys_id]')" style="display: inline;"></span>
					<span id="wasThisHelpfulCheckedIcon" class="icon-checkbox-checked" onclick="changeWasThisHelpfulToOff(this, '$[JS:knowledgeRecord.sys_id]')" style="display:none"></span>

					<span id="articleratingsubmitted" style="display: none;">
						<b>${gs.getMessage('Thank you for your feedback')}</b>
					</span>
		        	</span>
			</span>
		</span>
	</span>
	
</j2:if>

</j:jelly>
