<?xml version="1.0" encoding="utf-8"?>
<!-- slushbucket creates its own table -->
<j:jelly trim="true" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:macro name="slush" left_header="${gs.getMessage('Available')}" right_header="${gs.getMessage('Selected')}" up_down="false"/>
    <script eval="true">
       var ${jvar_name};
       addLoadEvent(function() {
          ${jvar_name} = new SlushBucket('${jvar_name}');
       });
    </script>
    <TABLE id="${jvar_name}" cellSpacing="10" cellPadding="0" border="0">
        <TR>
            <TD>
                <TABLE cellSpacing="0" cellPadding="1" border="0">
                    <TR class="header">
                        <TD vAlign="bottom" align="middle">
                            <label for="${jvar_name}_left">${jvar_left_header}</label>
                        </TD>
                    </TR>
                    <TR>
                        <TD vAlign="top" align="middle" class="slushbody">
                            <!-- left selection -->
                            <SELECT id="${jvar_name}_left"
                                name="${jvar_name}_left" class="slushselect"
                                multiple="yes" size="10" width="120"
                                ondblclick="${jvar_name}.moveLeftToRight();">
		                <!-- you can build your options list inline... -->
		                <g:insert/>
                            </SELECT>
                        </TD>
                    </TR>
                </TABLE>
            </TD>
            <TD>
                <!-- add / remove buttons -->
                <TABLE  id="addRemoveButtons"  cellSpacing="3" cellPadding="0" border="0">
                    <TR>
                        <TD align="middle"> ${gs.getMessage('Add')} </TD>
                    </TR>
                    <TR>
                        <TD align="middle">
                            <a onclick="${jvar_name}.moveLeftToRight();" href="javascript:void(0)">
                                <img src="images/arrow_rt.gifx?v=2" class="h_flip_content" border="0" alt="${gs.getMessage('Add')}"/>
                            </a>
                        </TD>
                    </TR>
                    <TR>
                        <TD align="middle">
                            <a onclick="${jvar_name}.moveRightToLeft();" href="javascript:void(0)">
                                <img src="images/arrow_lt.gifx?v=2" class="h_flip_content" border="0" alt="${gs.getMessage('Remove')}"/>
                            </a>
                        </TD>
                    </TR>
                    <TR>
                        <TD align="middle"> ${gs.getMessage('Remove')} </TD>
                    </TR>
                </TABLE>
            </TD>
            <TD VALIGN="middle">
                <TABLE cellSpacing="0" cellPadding="1" border="0">
                    <TR class="header">
                        <TD vAlign="bottom" align="middle">
                            <label for="${jvar_name}_right">${jvar_right_header}</label>
                        </TD>
                    </TR>
                    <TR>
                        <TD vAlign="top" align="middle" class="slushbody">
                            <!-- right selection -->
                            <SELECT id="${jvar_name}_right"
                                name="${jvar_name}_right" class="slushselect"
                                multiple="yes" size="10" width="120"
                                ondblclick="${jvar_name}.moveRightToLeft();" >
                            </SELECT>
<!-- up / down buttons -->
<j:if test="${jvar_up_down != 'false'}"> 
  <TD class="bodySmall" vAlign="center" align="middle">
    <TABLE id="upDownButtons" cellSpacing="0" cellPadding="0" border="0">
     <TR>
<TD class="bodySmall" vAlign="bottom" align="middle"> ${gs.getMessage('Up')} </TD>
</TR>
<TR>
<TD align="middle">
<A onclick="${jvar_name}.moveUp();" ondblclick="${jvar_name}.moveUp();">
<IMG height="23" alt="${gs.getMessage('Up')}" src="images/arrow_up.gifx?v=2" width="23" border="0" />
</A>
</TD>
</TR>
<TR>
<TD></TD>
</TR>
<TR>
<TD align="middle">
<A onclick="${jvar_name}.moveDown();" ondblclick="${jvar_name}.moveDown();" >
<IMG height="23" alt="${gs.getMessage('Down')}" src="images/arrow_dwn.gifx?v=2" width="23" border="0" />
</A>
</TD>
</TR>
<TR>
<TD class="bodySmall" vAlign="top" align="middle"> ${gs.getMessage('Down')} </TD>
</TR>
</TABLE>
</TD>
</j:if>
                        </TD>
                    </TR>
                </TABLE>
            </TD>
        </TR>
        
    </TABLE>
</j:jelly>
