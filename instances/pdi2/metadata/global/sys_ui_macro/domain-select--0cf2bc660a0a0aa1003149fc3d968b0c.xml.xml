<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null">
    <j:if test="${gs.getProperty('glide.sys.domain.enabled') == 'true' || gs.getProperty('glide.sys.domain.partitioning') == 'true' || gs.getProperty('glide.sys.domain.delegated_administration') == 'true'}">
        <span id="gsft_domain" style="display: inline">
            <label for="gsft_domain_select">${gs.getMessage('Domain')}<j2:if test="$[GlideMobileExtensions.getDeviceType() != 'doctype']">:</j2:if></label>$[SP]
            <SELECT id="gsft_domain_select" name="gsft_domain_select" onchange="ds.changeChoice();">
                <option value="">${gs.getMessage("Loading...")}</option>
            </SELECT>
            <g:include_script src="WelcomeWidgetSelectControl.jsdbx"/>
            <g:include_script src="DomainSelectControl.jsdbx"/>
            <script language="javascript">
                var ds = new DomainSelectControl("gsft_domain", "itil", "Domain","Domain");
            </script>
            <span style="margin-left:2px"></span>
        </span>
    </j:if>
</j:jelly>
