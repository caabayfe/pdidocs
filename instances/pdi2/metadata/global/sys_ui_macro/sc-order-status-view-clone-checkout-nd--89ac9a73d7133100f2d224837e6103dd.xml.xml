<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <j:if test="${jvar_sc_clone_checkout_button == 'true'}">
        <br />
        <div style="padding-left: 5px; padding-right: 5px;">
            <form method="POST" name="clone_form" id="clone_form" action="service_catalog.do">
                <input name="sysparm_action" type="HIDDEN" value="request_clone" />
                <input name="requestID" type="HIDDEN" value="${jvar_sc_request.getID()}" />
                <input name="request_number" type="HIDDEN" value="${jvar_sc_request.getRequestNumber()}" />
                <input name="sysparm_catalog" type="HIDDEN" value="$[sysparm_catalog]" />
                <input name="sysparm_catalog_view" type="HIDDEN" value="$[sysparm_catalog_view]" />
                <input name="sysparm_referring_url" type="HIDDEN" value="${sysparm_referring_url}" />
                <table width="100%" cellspacing="0">
                    <thead class="checkout_title">
                        <th class="checkout_left">${gs.getMessage('catalog_clone')}</th>
                    </thead>
                    <j:set var="jvar_row" value="0" />
                    <j:set var="jvar_max_rows" value="10" />
                    <j:set var="ref" value="sys_user" />
                    <j:set var="jvar_question_reference" value="sys_user" />
                    <j:set var="jvar_ref_filter" value="active=true" />
                    <j:set var="jvar_question_reference_qual" value="QUERY:active=true" />
                    <j:set var="jvar_question_label" value="${gs.getMessage('catalog_clone')}" />
                    <g:evaluate var="not_important" expression="var jsrow=0;" />
                    <j:while test="${jvar_row &lt; jvar_max_rows}">
                        <j:set var="jvar_row" value="${jvar_row + 1}" />
                        <g:evaluate var="jvar_question_name" expression="jsrow++; 'sys_user:ZZYYXXclone_row'+jsrow;" />
                        <tr>
                            <td>
                                <g:inline template="lightweight_reference.xml" />
                            </td>
                        </tr>
                    </j:while>
                    <tr>
                        <td>
                            <g:sc_button img="" classes="request_catalog_button header_button" id="sc_order_now_button"
                                onclick="document.getElementById('clone_form').submit();" label="${jvar_sc_order_now_label}" title="${jvar_sc_order_now_label}" />
                        </td>
                    </tr>
                </table>
            </form>
        </div>
    </j:if>
</j:jelly>
