<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<div class="diagnostics-results final-results">
		<div class="diagnostics-summary collapsible" aria-live="assertive" aria-atomic="true">
			<h2 >
				<i class="icon-add expand" tabindex="0"></i>
				<j:if test="${finalResults.summary == 3 || finalResults.summary == 4 || finalResults.summary == 5 }">
					<i id="summary_icon" class="icon-clear" aria-hidden="true"></i>
				</j:if>
				<j:if test="${finalResults.summary == 0 || finalResults.summary == 2}">
					<i id="summary_icon" class=" icon-edit" aria-hidden="true"></i>
				</j:if>
				<j:if test="${finalResults.summary == 1 }">
					<i id="summary_icon" class="icon-book" aria-hidden="true" style="margin-left:-2px"></i>
				</j:if>
				<span class="summary-heading">${finalResults.summary_header}</span>
			</h2>
		</div>

		<div class="content">
			<p class="note">
				<g2:no_escape>${finalResults.note}</g2:no_escape>		
			</p>
			
			
			<j:if test="${finalResults.isDomainSeparationActive}">
				<div class="diagnostics-table" aria-live="polite" aria-atomic="true">
					
					<table class="results-table table table-hover summary-table">

						<tr>
							<th>${gs.getMessage('Type')}</th>
							<th>${gs.getMessage('Result')}</th>
						</tr>
						<tr>
							<td>${gs.getMessage('Domain Separation')}</td>
							<td>${finalResults.domainResults.summary_header}</td>
						</tr>

						<tr>
							<td>${gs.getMessage('User Criteria')}</td>
							<td>${ucResults.summary_header}</td>
						</tr>
					</table>

					<span class="no-rows">${gs.getMessage('1 to 2 of 2 results');}</span>		

				</div>
			</j:if>
			
			<j:if test="${isArticle=='true'}">
				<p class="text">
					<i class="icon icon-alert-triangle" aria-hidden="true"></i>
					${gs.getMessage('If ACLs were applied to this Article, the ACLs will override the permissions defined by user criteria')}
				</p>


				<j:if test="${ucResults.summary == '1'}">
					<p class="text">
						<i class="icon-alert-triangle" aria-hidden="true"></i>
						<g:no_escape>${gs.getMessage('The article\'s publication status may also impact the user\'s access to it. If diagnostic results conflict with the user\'s access, please check the publication status of the article.')}</g:no_escape>
					</p>
				</j:if>


			</j:if>
			<j:if test="${isArticle=='false'}">
				<p class="text">
				<i class="icon icon-alert-triangle" aria-hidden="true"></i>
				${gs.getMessage('If ACLs were applied to this Knowledge Base, the ACLs will override the permissions defined by user criteria')}
				</p>
			</j:if>
		</div>

	</div>
</j:jelly>
