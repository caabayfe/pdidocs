<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:ui_form>
	   <table class="wide">
			<tr class="header">
				<td class="column_head">
					${gs.getMessage("On-call Rotation Schedule Report")}
					<input type="hidden" id="groups" name="groups" value="" />
				</td>
			</tr>
		   <tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("Start Date:")}</td>
						</tr>
						<tr>
							<td>
								<g:ui_date name="start_date"/>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("End Date:")}</td>
						</tr>
						<tr>
							<td>
								<g:ui_date name="end_date"/>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("Groups:")}</td>
						</tr>
						<tr>
							<td>
							   <label for="search">${gs.getMessage("Name starts with:")}</label>
							   <input id="search"
								   type="text"
								   style="width:150px;" />
							   <g:ui_spacer pixels="20" />
							</td>
						</tr>
						<tr>
							<td>
								<g:ui_slushbucket up_down="false" />
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr id="spacer_" name="spacer">
				<td height="10"/>
			</tr>
			<tr>
				<td>
					<table class="io_table" width="100%">
						<tr class="io_label">
							<td>${gs.getMessage("Report style:")}</td>
						</tr>
						<tr>
							<td>
								<select id="report_style" name="report_style">
								   <option value="table">${gs.getMessage("Table")}</option>
								   <option value="formatted">${gs.getMessage("Formatted")}</option>
								</select>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			<tr>
				<td>
				   <button type="submit" id="run" onClick="runReport();">${gs.getMessage("Run Report")}</button>
				</td>
			</tr>
			<tr>
				<td id="status" ></td>
			</tr>
		</table>
	</g:ui_form>
</j:jelly>
