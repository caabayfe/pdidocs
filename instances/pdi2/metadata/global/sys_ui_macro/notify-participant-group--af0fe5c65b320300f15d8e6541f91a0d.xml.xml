<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g2:evaluate jelly="true" var="jvar_msg">
		var msg = new global.IncidentAlertNotifyUtils().getGroupMessage(jelly.sys_id);
		msg;
	</g2:evaluate>
	<g2:evaluate var="jvar_escape_text" jelly="true">
		gs.getProperty('glide.ui.escape_text') == 'true';
	</g2:evaluate>
	<div id="notify_participant_group_macro">
		<j2:if test="$[jvar_msg!='']">
			<div class="label_spacing" nowrap="true" type="glide_list" choice="0">
				<label class="col-xs-12 col-md-1_5 col-lg-2 control-label">
					<span class="read_only required-marker"></span>
					<span class="label-text">$[gs.getMessage('Groups')]</span>
				</label>
			</div>
			<div class="col-xs-10 col-md-9 col-lg-8 form-field input_controls">
				<p class="form-control-static disabled" readonly="readonly">
					<j2:if test="$[jvar_escape_text]">
						$[msg]
					</j2:if>
					<j2:if test="$[!jvar_escape_text]">
						$[HTML,JS:msg]
					</j2:if>
				</p>
			</div>
			<div class="col-xs-2 col-md-1_5 col-lg-2 form-field-addons"></div>
		</j2:if>
	</div>

</j:jelly>
