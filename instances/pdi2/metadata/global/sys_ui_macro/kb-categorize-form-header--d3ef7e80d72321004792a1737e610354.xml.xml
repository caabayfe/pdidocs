<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

	<g:inline template="ie_checker.xml" />

	<j2:choose>
		<j2:when test="$[jvar_isMSIE8 || jvar_isMSIE7]">
			<div id="kb-action-bar-top" class="kb-categorize-form-header">
				<j:if test="${RP.getParameterValue('sysparm_popup') != 'true'}">
					<button id="back" class="btn btn-default" onclick="utils.goBack();">&lt;</button>
				</j:if>
				<g2:set_if var="jvar_title" test="$[empty(sysparm_title)]" true="$[gs.getMessage('Create New Knowledge')]" false="$[sysparm_title]" />
				<h4 id="kb-navbar-title" class="kb-navbar-title">$[jvar_title]</h4>
				<div class="kb-right-no-texture">
					<j2:if test="$[isNewRevision]">
						<button id="next-new-top" type="button" class="btn btn-primary">${gs.getMessage("Next")}</button>
					</j2:if>
					<j2:if test="$[!isNewRevision]">
						<button id="next-reassign-top" type="button" class="btn btn-primary">${gs.getMessage("Next")}</button>
					</j2:if>
				</div>
			</div>
		</j2:when>
		<j2:otherwise>
			<g2:set_if var="jvar_title" test="$[empty(sysparm_title)]" true="$[gs.getMessage('Create New Knowledge')]" false="$[sysparm_title]" />
			<div class="navbar navbar-default" role="navigation" style="margin:0;">
				<div class="container-fluid">
					<div class="navbar-header">
						<j:if test="${RP.getParameterValue('sysparm_popup') != 'true'}">
							<button id="back" class="btn btn-default icon-chevron-left navbar-btn" onclick="utils.goBack();"></button>
						</j:if>
						<h1 style="display:inline-block;" class="navbar-title">$[jvar_title]</h1>
					</div>
					<div class="nav navbar-right">
						<j2:if test="$[isNewRevision]">
							<button id="next-new-top" type="button" class="btn btn-primary" disabled="true">${gs.getMessage("Next")}</button>
						</j2:if>
						<j2:if test="$[!isNewRevision]">
							<button id="next-reassign-top" type="button" class="btn btn-primary" disabled="true">${gs.getMessage("Next")}</button>
						</j2:if>
					</div>
				</div>
			</div>
		</j2:otherwise>
	</j2:choose>

</j:jelly>
