<SOAP-ENV:Envelope xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:m="http://www.service-now.com/InstanceCloneSchedule" xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"  SOAP-ENV:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
  <SOAP-ENV:Body>
    <execute xmlns="http://www.service-now.com/InstanceCloneSchedule">
      <!-- optional -->
      <clone_id xsi:type="xsd:string">${clone_id}</clone_id>
      <!-- optional -->
      <date xsi:type="xsd:string">${date}</date>
      <!-- optional -->
      <state xsi:type="xsd:string">${state}</state>
      <!-- optional -->
      <source_instance_id xsi:type="xsd:string">${source_instance_id}</source_instance_id>
      <!-- optional -->
      <source_instance_name xsi:type="xsd:string">${source_instance_name}</source_instance_name>
      <!-- optional -->
      <source_instance_url xsi:type="xsd:string">${source_instance_url}</source_instance_url>
      <!-- optional -->
      <target_instance_id xsi:type="xsd:string">${target_instance_id}</target_instance_id>
      <!-- optional -->
      <target_instance_name xsi:type="xsd:string">${target_instance_name}</target_instance_name>
      <!-- optional -->
      <target_instance_url xsi:type="xsd:string">${target_instance_url}</target_instance_url>
      <!-- optional -->
      <source_version xsi:type="xsd:string">${source_version}</source_version>
      <!-- optional -->
      <target_version xsi:type="xsd:string">${target_version}</target_version>
      <!-- optional -->
      <source_db_server xsi:type="xsd:string">${source_db_server}</source_db_server>
      <!-- optional -->
      <source_jdbc_url xsi:type="xsd:string">${source_jdbc_url}</source_jdbc_url>
      <!-- optional -->
      <target_db_server xsi:type="xsd:string">${target_db_server}</target_db_server>
      <!-- optional -->
      <target_jdbc_url xsi:type="xsd:string">${target_jdbc_url}</target_jdbc_url>
      <!-- optional -->
      <standby_db_server xsi:type="xsd:string">${standby_db_server}</standby_db_server>
      <!-- optional -->
      <standby_jdbc_url xsi:type="xsd:string">${standby_jdbc_url}</standby_jdbc_url>
      <!-- optional -->
      <source_db_name xsi:type="xsd:string">${source_db_name}</source_db_name>
      <!-- optional -->
      <target_db_name xsi:type="xsd:string">${target_db_name}</target_db_name>
      <!-- optional -->
      <standby_db_name xsi:type="xsd:string">${standby_db_name}</standby_db_name>
      <!-- optional -->
      <validation_error xsi:type="xsd:string">${validation_error}</validation_error>
      <!-- optional -->
      <started xsi:type="xsd:string">${started}</started>
      <!-- optional -->
      <completed xsi:type="xsd:string">${completed}</completed>
	  <!-- optional -->
     <exclude_tables_specified_in_exclusion_list xsi:type="xsd:string">${exclude_tables_specified_in_exclusion_list}</exclude_tables_specified_in_exclusion_list>
     <!-- optional -->
     <exclude_audit_and_log_data xsi:type="xsd:string">${exclude_audit_and_log_data}</exclude_audit_and_log_data>
     <!-- optional -->
     <exclude_large_attachment_data xsi:type="xsd:string">${exclude_large_attachment_data}</exclude_large_attachment_data>
     <!-- optional -->
     <preserve_in_progress_update_sets xsi:type="xsd:string">${preserve_in_progress_update_sets}</preserve_in_progress_update_sets>
     <!-- optional -->
     <amount_of_data_copied_from_large_tables xsi:type="xsd:string">${amount_of_data_copied_from_large_tables}</amount_of_data_copied_from_large_tables>
     <!-- optional -->
     <preserve_theme xsi:type="xsd:string">${preserve_theme}</preserve_theme>
      <!-- optional -->
      <cancelled xsi:type="xsd:string">${cancelled}</cancelled>
      <!-- optional -->
      <user_name xsi:type="xsd:string">${user_name}</user_name>
      <!-- optional -->
      <user_email xsi:type="xsd:string">${user_email}</user_email>
      <!-- optional -->
      <cluster_node xsi:type="xsd:string">${cluster_node}</cluster_node>
      <!-- optional -->
      <mb_to_copy xsi:type="xsd:string">${mb_to_copy}</mb_to_copy>
      <!-- optional -->
      <mb_copied xsi:type="xsd:string">${mb_copied}</mb_copied>
      <!-- optional -->
      <kb_per_second xsi:type="xsd:string">${kb_per_second}</kb_per_second>
      <!-- optional -->
      <duration xsi:type="xsd:string">${duration}</duration>
      <!-- optional -->
      <user_maint xsi:type="xsd:string">${user_maint}</user_maint>
      <!-- optional -->
      <security_token xsi:type="xsd:string">${security_token}</security_token>
      <!-- optional -->
      <check_for_available_reservation xsi:type="xsd:string">${check_for_available_reservation}</check_for_available_reservation>
      <!-- optional -->
      <request_for_rollback xsi:type="xsd:string">${request_for_rollback}</request_for_rollback>
		<!-- optional -->
      <request_for_clone_status xsi:type="xsd:string">${request_for_clone_status}</request_for_clone_status>
	 <!-- optional -->
      <action xsi:type="xsd:string">${action}</action>
	 <!-- optional -->
      <telemetry xsi:type="xsd:string">${telemetry}</telemetry>
	 <!-- optional -->
      <parent_clone_id xsi:type="xsd:string">${parent_clone_id}</parent_clone_id>
     <!-- optional -->
      <profile xsi:type="xsd:string">${profile}</profile>
     <!-- optional -->
      <lock_clone_config xsi:type="xsd:string">${lock_clone_config}</lock_clone_config>
     <!-- optional -->
      <quebecPlus xsi:type="xsd:string">${quebecPlus}</quebecPlus>
     <!-- optional -->
      <user xsi:type="xsd:string">${user}</user>
     <!-- optional -->
      <password xsi:type="xsd:string">${password}</password>
    </execute>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
