<SOAP-ENV:Envelope xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" xmlns:m="http://webservices.amazon.com/AWSECommerceService/2009-11-01"  SOAP-ENV:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
  <SOAP-ENV:Header xmlns:aws="http://security.amazonaws.com/doc/2007-01-01/">
   <aws:AWSAccessKeyId>${access_key}</aws:AWSAccessKeyId>
   <aws:Timestamp>${timestamp}</aws:Timestamp>
   <aws:Signature>${signature}</aws:Signature>
  </SOAP-ENV:Header>
  <SOAP-ENV:Body>
    <ItemSearch xmlns="http://webservices.amazon.com/AWSECommerceService/2009-11-01">
      <Shared xsi:type="m:ItemSearchRequest">
        <Keywords xsi:type="xsd:string">${keyword}</Keywords>
      </Shared>
    </ItemSearch>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
