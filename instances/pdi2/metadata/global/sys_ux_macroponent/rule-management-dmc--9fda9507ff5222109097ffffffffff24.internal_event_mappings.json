            "broker": null,
            "clientScript": null,
            "clientTransformScript": "javascript(/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar { reference } = event.payload;\n\tif(!reference) return;\n  \tvar [table, element, relationship] = reference.split('.');\n\n\tvar { referenceForRelatedRecords, filteredReferenceRules } = api.state;\n\tif(!referenceForRelatedRecords) return;\n\t\n\tvar { archiveRules } = referenceForRelatedRecords;\n\tif(!archiveRules.length) return;\n\tvar filteredArchiveRules = archiveRules.filter(rule => rule.table == table);\n\treturn {\n\t\tpropName: \"filteredReferenceRules\",\n\t\tvalue: filteredArchiveRules\n\t};\n})",
