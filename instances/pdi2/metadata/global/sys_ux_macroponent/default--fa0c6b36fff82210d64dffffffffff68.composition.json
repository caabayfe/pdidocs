                                                    "value": {
                                                        "code": null,
                                                        "comment": "",
                                                        "message": "<p data-end=\"233\" data-start=\"206\">MFA protects against:</p>\n<ul>\n<li data-end=\"233\" data-start=\"206\"><strong>Phishing</strong>: Prevents attackers from accessing accounts even if credentials are stolen.</li>\n<li data-end=\"233\" data-start=\"206\"><strong>Credential Stuffing</strong>: Blocks automated login attempts using leaked username-password pairs.</li>\n<li data-end=\"233\" data-start=\"206\"><strong>Man-in-the-Middle (MitM) Attacks</strong>: Adds a second layer of verification that can't be intercepted.</li>\n<li data-end=\"233\" data-start=\"206\"><strong>Brute Force Attacks</strong>: Makes password-guessing techniques ineffective without the second factor.</li>\n</ul>"
                                                    }
                                                }
                                            },
                                            "slot": "content",
