                    "preset": null,
                    "propertyValues": {
                        "html": {
                            "type": "TRANSLATION_LITERAL",
                            "value": {
                                "code": null,
                                "comment": "",
                                "message": "<p data-end=\"337\" data-start=\"235\"><span style=\"font-size: 10pt;\">When logging in, a user must provide authentication based on at least two of the following categories:</span></p>\n<ul>\n<li style=\"font-size: 10pt;\" data-end=\"337\" data-start=\"235\"><strong>Something You Know </strong>&ndash; A password</li>\n<li style=\"font-size: 10pt;\" data-end=\"337\" data-start=\"235\"><strong>Something You Have </strong>&ndash; A mobile device, security key, or one-time passcode (OTP)</li>\n<li style=\"font-size: 10pt;\" data-end=\"337\" data-start=\"235\"><strong>Something You Are </strong>&ndash; A fingerprint or facial recognition</li>\n</ul>\n<p data-end=\"632\" data-start=\"531\"><span style=\"font-size: 10pt;\">To successfully authenticate, users must present at least two distinct factors from these categories.</span></p>\n<p data-end=\"856\" data-start=\"634\"><span style=\"font-size: 10pt;\">The ServiceNow platform supports a wide range of second-factor authentication methods, including FIDO2 passkeys, biometric authentication, hardware security keys, authenticator apps, and email/SMS OTPs.</span></p>\n<p data-end=\"1108\" data-start=\"858\"><span style=\"font-size: 10pt;\">MFA ensures that even if a password is compromised, unauthorized access is still prevented without the additional verification factor. It is a simple yet effective way to safeguard your organization&rsquo;s data and protect users from modern cyber threats.</span></p>"
                            }
                        }
                    },
                    "slot": null,
                    "styles": null
                }
