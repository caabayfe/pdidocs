                            "payload": {
                                "script": {
                                    "apiVersion": "1.0.0",
                                    "controllerElementId": null,
                                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    const payload = event.payload.data.output;\n    const translations = api.state.translations || {};\n    const failureLabel = translations.failureLabel;\n    const successLabel = translations.successLabel;\n    const dtTurnOnLabel = translations.dtTurnOnLabel;\n\n    if (payload === true) {\n        return {\n            items: [{\n                id: 'turn_off_on_alert',\n                status: 'positive',\n                icon: 'circle-check-outline',\n                content: api.state.DTValue == false ? successLabel : dtTurnOnLabel,\n                action: {\n                    type: 'dismiss'\n                }\n            }]\n        };\n    }\n    else if (!(payload === true || payload === false)) {\n        return {\n            items: [{\n                id: 'failure_alert',\n                status: 'critical',\n                icon: 'circle-check-outline',\n                content: failureLabel,\n                action: {\n                    type: 'dismiss'\n                }\n            }]\n        };\n    } \n\n}",
                                    "scriptSysId": null,
