<html lang="en">
<head>
    <meta charset="utf-8">
    </meta>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    </meta>
    <style type="text/css">
        * {
            -webkit-text-size-adjust: none;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            font-family: Lato, Arial, sans-serif;
        }

        p.footer {
            margin: 0;
            font-size: 12px;
            line-height: 18px;
            color: #CFD5D7;
        }

        #snc_notification_unsubscribe,
        #snc_notification_preference {
            color: #1955BE;
            font-size: 16px;
            line-height: 19px;
        }

        #snc_notification_unsubscribe {
            padding-right: 8px;
        }

        #snc_notification_preference {
            padding-left: 8px;
        }

        body,
        table,
        td,
        p,
        a {
            -ms-text-size-adjust: 100% !important;
            -webkit-text-size-adjust: 100% !important;
        }

        table,
        tr,
        td {
            border-spacing: 0 !important;
            mso-table-lspace: 0 !important;
            mso-table-rspace: 0 !important;
            border-collapse: collapse !important;
            mso-line-height-rule: exactly !important;
        }

        .mobile-link a,
        .mobile-link span {
            text-decoration: none !important;
            color: inherit !important;
            border: none !important;
        }
        .sidebar {
            width: 16px;
        }

        .middle-container {
            border-radius: 6px;
            text-align: left;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 24px;
            padding-bottom: 24px;
            background-color: #FFFFFF;
        }

        @media only screen and (min-width: 600px) {
            .sidebar {
                width: 32px;
            }

            .middle-container {
                border-radius: 6px;
                text-align: left;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 40px;
                padding-bottom: 40px;
                background-color: #FFFFFF;
            }
        }
    </style>
</head>

<body style="margin: 0 auto !important;">
    <table class="w100" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" bgcolor="#032D42" style="width:100%; max-width: 600px; background-color:#032D42; margin: 0 auto; padding: 0px;">
        <tr>
            <td width="140" height="140">
                <img src="sn_ex_emp_fd.email_template_banner_top_left.png" width="140" height="140" style="display: block; min-height: 140px;" alt="" />
            </td>

            <td align="center" height="140">
                <table width="100%" style="height: 140px;">
                    <tr height="64">
                        <td align="center"></td>
                    </tr>
                    <tr>
                        <td align="center">
                            <img src="sn_ex_emp_fd.email_template_servicenow_header_logo.png" height="50px" style="max-width: 174px; min-width: 174px; width: 100%; height: auto; object-fit: contain; display: block;" alt="Servicenow logo" />
                        </td>
                    </tr>
                    <tr height="24">
                        <td align="center"></td>
                    </tr>
                </table>
            </td>

            <td width="140" height="140">
                <img src="sn_ex_emp_fd.email_template_banner_top_right.png" width="140" height="140" style="display: block; min-height: 140px;" alt="" />
            </td>
        </tr>
    </table>
    <table width="100%" style="max-width: 600px; background-color:#F5F6F7;" cellspacing="0" cellpadding="0" border="0" align="center">
        <tbody>
            <tr>
                <!-- Left-->
                <td valign="top" class="sidebar">
                    <table width="100%">
                        <tr height="70" style="background: #032D42;">
                            <td></td>
                        </tr>
                    </table>
                </td>

                <!-- Main Content -->
                <td width="100%" style="width: auto;">
                    <table class="w100" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" style="background-image: linear-gradient(to bottom , rgba(39,40,74,1), rgba(247,247,249,0)); margin:0px; padding:0px; 
                    box-shadow: 0px 2px 10px rgba(23, 40, 52, 0.08);">
                        <tbody>
                            <tr>
                                <td align="center" style="border-radius:6px;" class="middle-container">
                                    ${notification:body}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>

                <td valign="top" class="sidebar">
                    <table width="100%">
                        <tr height="70" style="background: #032D42;">
                            <td></td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr height="24px">
                <td></td>
            </tr>
        </tbody>
    </table>
    <table class="w100" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" bgcolor="#F5F6F7" style="width:100%; max-width: 600px; background-color:#F5F6F7; margin: 0 auto; padding: 0px;">
        <tbody>

            <tr>
                <td align="center" style="background-color: #F5F6F7; padding-bottom: 24px;">
                    ${NOTIF_UNSUB} | ${NOTIF_PREFS}
                </td>
            </tr>
            <tr>
                <td height="12px" style="background-color: #10171A;"></td>
            </tr>
            <tr>
                <td valign="top" align="center" style="background-color: #10171A;">
                    <img src="sn_ex_emp_fd.email_template_servicenow_footer_logo.png" width="174px" height="48px" alt="Servicenow logo" />
                </td>
            </tr>
            <tr>
                <td style="background-color: #10171A; color: #CFD5D7;">
                    <table width="100%" cellspacing="0" style="color: #CFD5D7;">
                        <tr align="center">
                            <td>
                                <p class="footer">
                                    2225 Lawson Lane, Santa Clara, CA 95054, United States
                                </p>
                            </td>
                        </tr>
                        <tr align="center">
                            <td>
                                <p class="footer">
                                    &#169; ${mail_script:ec_mail_current_year} ServiceNow Inc. All rights reserved.
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td height="24px" style="background-color: #10171A;"></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
