<?xml version="1.0" encoding="utf-8" ?>
<div class="sn-aside-body">
	<div ng-if="canCreate" class="sn-widget sn-widget-button sn-widget-button_row">
		<span class="sn-widget-list-content">
			<div class="btn btn-default icon"
				 aria-label="{{::messages['Add Span Style']}}"
				 tabindex="0"
				 role="button"
				 ng-click="openStyle();" >
				<span class="icon-add-circle-empty"/>
				<span>{{::messages['Add Span Style']}}</span>
			</div>
		</span>
	</div>
	<div class="sn-aside-group-title" ng-show="styles.schedule.length > 0">
		<span>{{::messages['Schedules']}}</span>
	</div>
	<ul class="sn-widget-list_v2" ng-show="styles.schedule.length > 0">
		<div soc-aside-style-item="" ng-repeat="style in styles.schedule | orderBy:['name.display_value']" soc-style="style" soc-def-id="socDefId"></div>
	</ul>
	<div class="sn-aside-group-title" ng-show="styles.chg_soc_style_rule.length > 0 || styles.chg_soc_definition_style_rule.length > 0">
		<span>{{::messages['Style rules']}}</span>
	</div>
	<ul class="sn-widget-list_v2" ng-show="styles.chg_soc_style_rule.length > 0 || styles.chg_soc_definition_style_rule.length > 0">
		<div soc-aside-style-item="" ng-repeat="style in styles.chg_soc_definition_style_rule | orderBy:['-order.display_value','name.display_value']" soc-style="style" soc-def-id="socDefId"></div>
		<div soc-aside-style-item="" ng-repeat="style in styles.chg_soc_style_rule | orderBy:['-order.display_value','name.display_value']" soc-style="style" soc-def-id="socDefId"> </div>
	</ul>
	<div class="sn-aside-group-title" ng-show="styles.chg_soc_def_child_style_rule.length > 0">
		<span>{{::messages['Related style rules']}}</span>
	</div>
	<ul class="sn-widget-list_v2" ng-show="styles.chg_soc_def_child_style_rule.length > 0">
		<div soc-aside-style-item="" ng-repeat="style in styles.chg_soc_def_child_style_rule | orderBy:['-order.display_value','name.display_value']" soc-style="style" soc-def-id="socDefId"></div>
	</ul>
</div>
