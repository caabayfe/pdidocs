<div class="sn-navhub sn-navhub_transparent">
    <div class="sn-navhub-content" role="tablist">
      <div ng-class="{'state-active':scheduleSoCCtrl.filter == 'pinned'}"
        ng-click="scheduleSoCCtrl.filterBy('pinned')"
        role="tab"
        aria-label="{{scheduleSoCCtrl.form.pinned.title}}"
        class="btn sn-navhub-btn sn-navhub-btn_text"
        tabindex="0">{{scheduleSoCCtrl.form.pinned.title}}
      </div>
      <div ng-class="{'state-active':scheduleSoCCtrl.filter == 'own_belong'}"
        ng-click="scheduleSoCCtrl.filterBy('own_belong')"
        role="tab"
        aria-label="{{scheduleSoCCtrl.form.own_belong.title}}"
        class="btn sn-navhub-btn sn-navhub-btn_text"
        tabindex="0">{{scheduleSoCCtrl.form.own_belong.title}}
      </div>
      <div ng-class="{'state-active':scheduleSoCCtrl.filter == 'all'}"
        ng-click="scheduleSoCCtrl.filterBy('all')"
        role="tab"
        aria-label="{{scheduleSoCCtrl.form.all.title}}"
        class="btn sn-navhub-btn sn-navhub-btn_text"
        tabindex="0">{{scheduleSoCCtrl.form.all.title}}
      </div>
    </div>
    <sn-landing-sort />
  </div>
