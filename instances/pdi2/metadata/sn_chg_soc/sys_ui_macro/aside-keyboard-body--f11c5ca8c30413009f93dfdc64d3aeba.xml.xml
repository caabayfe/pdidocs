<?xml version="1.0" encoding="utf-8" ?>
<div class="sn-aside-body" aria-live="polite">
	<div ng-repeat="category in keyboardShortcuts">
		<!-- Show Child Records -->
		<h3 class="sn-aside-group-title" ng-class="$index !== 0 ? 'soc-aside-group-title' : ''" ng-show="category.shortcuts.length > 0">
			<span>{{::category.label}}</span>
		</h3>
		<dl>
			<div ng-repeat="shortcut in category.shortcuts" class="soc-aside-shortcut">
				<dt ng-if="!shortcut.template" class="soc-aside-shortcut-label" ng-class="shortcut.icon">
					<span aria-label="{{::shortcut.screen_reader}}">{{::shortcut.label}}</span>
				</dt>
				<dt ng-if="shortcut.template" class="soc-aside-shortcut-label"  >
					<span aria-label="{{::shortcut.screen_reader}}" ng-bind-html="shortcut.template"></span>
				</dt>
				<dd class="soc-aside-shortcut-desc">
					{{::shortcut.desc}}
				</dd>
			</div>
		</dl>
	</div>
</div>
