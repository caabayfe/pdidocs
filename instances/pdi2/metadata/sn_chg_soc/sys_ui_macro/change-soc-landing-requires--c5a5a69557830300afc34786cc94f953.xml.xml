<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g2:evaluate var="jvar_user" object="true">
		gs.getUser();
	</g2:evaluate>
	<g2:evaluate var="jvar_roles">
		new global.ChangeSoCUtil().getRoles();
	</g2:evaluate>
	<g2:evaluate var="jvar_connect_installed_and_enabled">
		new global.ChangeSoCUtil().isConnectAvailable();
	</g2:evaluate>
	<g:evaluate var="jvar_accessibility_enable">
		new global.ChangeSoCUtil().isAccessibilityEnabled();
	</g:evaluate>

	<j:set var="jvar_cssCacheTheme" value="c=$[gs.getCssCacheVersionString()]" />
	
	<g:requires name="styles/dist/common/sn_common.css" params="${jvar_cssCacheTheme}" />
	<g:requires name="styles/sn_notification.css" params="${jvar_cssCacheTheme}" />
	<g:requires name="styles/sn_stream.css" params="${jvar_cssCacheTheme}" />
	<g:requires name="/styles/thirdparty/datetimepicker.css" params="${jvar_cssCacheTheme}" />
	<g:requires name="styles/css_includes_ng_form_elements.css" includes="true" params="${jvar_cssCacheTheme}" />

	<!-- CSS includes for New Change Schedule Wizard -->
	<g:inline template="sn_chg_soc_change_soc_landing_wizard_css_includes.xml" />

	<link href="e9d128b057070300afc34786cc94f93b.cssdbx?${jvar_cssCacheTheme}" rel="stylesheet" type="text/css" />

	<j:if test="${jvar_text_direction == 'rtl'}">
		<g:requires name="styles/heisenberg/heisenberg_rtl.css" includes="true" params="${jvar_cssCacheTheme}" />
		<link href="24e128b057070300afc34786cc94f986.cssdbx?${jvar_cssCacheTheme}" rel="stylesheet" type="text/css" /> <!-- Change Schedules Landing - RTL -->
	</j:if>


	<!-- Change Schedules Landing - Accessibility -->
	<j:if test="${jvar_accessibility_enable == true}">
		<link href="63fd82a457f70300afc34786cc94f947.cssdbx?${jvar_cssCacheTheme}" rel="stylesheet" type="text/css" />
	</j:if>

	<!-- JS includes for New Change Schedule Wizard -->
	<g:inline template="sn_chg_soc_change_soc_landing_wizard_js_includes.xml" />

	<g:requires name="scripts/sn/common/clientScript/glideUser.js" />

	<g:requires name="script/sn_chg_soc.landing.app.jsdbx" />
	<g:requires name="script/sn_chg_soc.sn_soc_now.scheduleService.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_page_header.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_tabs.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_card.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_decoration.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_notifications.jsdbx" />
	<g:requires name="script/sn_chg_soc.sn.app_itsm.now.iscroll.jsdbx" />
	<g:requires name="script/sn_chg_soc.filter_widget.jsdbx" />
	<g:requires name="script/sn_chg_soc.change_soc_filter.jsdbx" />
	<g:requires name="script/sn_chg_soc.tooltip_overflow.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_splash_screens.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_wizard.jsdbx" />
	<g:requires name="script/sn_chg_soc.landing_sort.jsdbx" />
	<g:requires name="script/sn_chg_soc.notification.jsdbx" />
</j:jelly>
