<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j2:if test="$[!jvar_has_rights]">
		<html>
			<head>
				<title>${gs.getMessage('Record not found');}</title>
				<g:requires name="styles/heisenberg/source_sans_pro.css" />
				<g:requires name="styles/theme_main.css" includes="true" />
				<link href="styles/heisenberg/heisenberg_all.cssx?v=${gs.getProperty('glide.builddate')}" rel="stylesheet" type="text/css" />
			</head>
			<body>
				<div id="output_messages" class="outputmsg_container">
					<h2 class="sr-only">${gs.getMessage('Notifications')}</h2>
					<div class="outputmsg_div" aria-live="polite" role="region">
						<div class="outputmsg outputmsg_info notification notification-info">
							<span class="notification-icon icon-info">
								<span class="sr-only">${gs.getMessage('Info Message')}</span>
							</span>
							<div class="outputmsg_text">${gs.getMessage('Record not found')}</div>
						</div>
					</div>
				</div>
			</body>
		</html>
	</j2:if>
</j:jelly>
