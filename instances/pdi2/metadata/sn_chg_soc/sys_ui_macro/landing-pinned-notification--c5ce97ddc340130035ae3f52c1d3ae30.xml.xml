<div ng-if="scheduleSoCCtrl.showPinnedNotification" class="alert alert-success soc-notification" role="alert" ng-show="scheduleSoCCtrl.showSchedulePinnedMsg" ng-animate="'fade'">
	<span class="notification-icon icon-check-circle"></span>
	<span class="soc-notification-msg" tabindex="0">{{scheduleSoCCtrl.form.schedulePinnedMsg}}</span>
	<button class="btn-icon close icon-cross soc-close-notification" tabindex="0" ng-click="scheduleSoCCtrl.showSchedulePinnedMsg=false" data-dismiss="alert">
		<span class="sr-only">{{scheduleSoCCtrl.form.close}}</span>
	</button>
</div>
