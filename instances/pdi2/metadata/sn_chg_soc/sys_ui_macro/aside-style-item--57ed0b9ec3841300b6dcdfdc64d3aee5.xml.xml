<?xml version="1.0" encoding="utf-8" ?>
<li class="sn-widget-list-item_hidden-action" data-id="{{::socStyle.sys_id.value}}" ng-click="openStyle($event);" aria-label="{{::socStyle.name.display_value}}">
	<div class="sn-widget-list-content sn-widget-list-content_static">
		<div ng-if="socStyle.__security.canWrite" class="soc-style-list-color-btn" ng-style="{'background-color': socStyle.event_color.value}" aria-label="{{::messages['Select span color']}}" uib-tooltip="{{::messages['Select span color']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true">
			<button class="btn soc-style-list-color-btn" sn-color-picker="" picker-color="socStyle.event_color.value" picker-options="{'saveCancel': true, 'view': 'pallet'}" picker-save-action="updateStyleColor(color)" picker-label="{{::messages['Select span color']}}">
			</button>
		</div>
		<span ng-if="!socStyle.__security.canWrite" ng-style="{'background-color': socStyle.event_color.value}" class="soc-style-list-color"></span>
	</div>
	<div class="sn-widget-list-content">
		<form ng-if="socStyle.__security.canWrite &amp;&amp; socStyle.__type !== 'schedule'" ng-submit="updateStyleName($event)" class="sn-navhub-title soc-style-form" on-save="updateStyleName($event)">
			<label tabindex="0" ng-focus="editName($event)" ng-show="!editMode" ng-class="{'soc-style-edit': (socStyle.__security.canWrite &amp;&amp; socStyle.__type !== 'schedule')}" class="sn-widget-list-title">{{socStyle.name.display_value}}</label>
			<div ng-if="editMode">
				<input ng-init="setFocus()" ng-show="editMode" class="span-style-name form-control" maxlength="200" name="spanStyleName" ng-model="socStyle.name.display_value" ng-disabled="!socStyle.__security.canWrite || socStyle.__type === 'schedule'" autocomplete="off" type="text" ng-blur="updateStyleName($event)" />
			</div>
		</form>
		<label ng-if="!socStyle.__security.canWrite || socStyle.__type === 'schedule'" tabindex="0" class="sn-widget-list-title">
			{{socStyle.name.display_value}}
		</label>
	</div>
	<div ng-show="!editMode" ng-if="socStyle.__security.canDelete &amp;&amp; socStyle.__type !== 'schedule'" class="sn-widget-list-content sn-widget-list-content_static sn-widget-list-content_hidden sn-widget-list-content_actions">
		<div ng-click="deleteStyle($event)" aria-label="{{::messages['Delete span style']}}" uib-tooltip="{{::messages['Delete span style']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true" class="sn-widget-list-action sn-widget-list-action_negative icon-delete" role="button" tabindex="0">
		</div>
	</div>
	<div ng-show="!editMode" class="sn-widget-list-content sn-widget-list-content_static sn-widget-list-content_drill" aria-label="{{::messages['More details']}}" uib-tooltip="{{::messages['More details']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true"  tabindex="-1">
		<span class="sn-widget-list-action icon-chevron-right" />
	</div>
</li>
