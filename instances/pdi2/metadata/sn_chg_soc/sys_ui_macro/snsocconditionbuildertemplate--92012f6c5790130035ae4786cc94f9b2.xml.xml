<!-- Condition builder modal template -->
<div id="soc-condition-builder" class="soc-condition-builder-modal">
	<header class="modal-header soc-condition-builder-modal-header">
		<h4 class="modal-title soc-condition-builder-modal-title">{{::messages['Title']}}</h4>
		<button ng-click="cancel()" class="btn-icon close icon-cross soc-condition-builder-modal-close" tabindex="0">
			<span class="sr-only">{{::messages['Close']}}</span>
		</button>
	</header>
	<div class="soc-condition-builder-modal-message" />
	<div class="modal-body soc-condition-builder-modal-body">
		<div class="row soc-filter-wrapper">
			<soc-filter-widget table="{{table}}" filter-config="filterConfig"/>
		</div>
	</div>
	<div class="modal-footer soc-condition-builder-modal-footer">
		<button class="btn btn-default" type="button" ng-click="cancel()">{{::messages['Cancel']}}</button>
		<button ng-if="showSubmit" ng-disabled="!enableSubmit()" class="btn btn-primary" type="button" ng-click="submit()">{{::messages['Submit']}}</button>
		<button ng-if="!showSubmit" ng-disabled="!enableRun()" class="btn btn-primary" type="button" ng-click="run()">{{::messages['Run']}}</button>
	</div>
</div>
