<?xml version="1.0" encoding="utf-8" ?>
<div id="soc-remove-style" class="soc-destructive-modal">
	<header class="modal-header">
		<h4 id="modal1_title" class="modal-title">{{::messages['Remove access']}}</h4>
	</header>
	<div class="modal-body">
		<p>{{removeAccessMsg}}</p>
	</div>
	<footer class="modal-footer flex">
		<button data-dismiss="modal" class="btn btn-default" ng-click="cancel()">{{::messages['Cancel']}}</button>
		<button data-dismiss="modal" class="btn btn-danger" ng-click="delete()">{{::messages['Remove']}}</button>
	</footer>
</div>
