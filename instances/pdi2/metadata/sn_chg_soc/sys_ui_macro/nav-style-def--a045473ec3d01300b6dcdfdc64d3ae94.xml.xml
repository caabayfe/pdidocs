<?xml version="1.0" encoding="utf-8" ?>
<div id="soc_nav_style" class="soc-modal-style">
	<header class="modal-header">
		<button ng-click="dismiss()" class="btn btn-icon close icon-cross">
			<span class="sr-only">Close</span>
		</button>
		<h4 class="modal-title">{{::messages['Save changes']}}</h4>
	</header>
	<div class="modal-body">
		<p>{{::bodyMsg}}</p>
	</div>
	<footer class="modal-footer flex">
		<button data-dismiss="modal" class="btn btn-destructive-subdued" ng-click="discard()">{{::messages['Discard']}}</button>
		<button data-dismiss="modal" class="btn btn-primary" ng-click="save()">{{::messages['Save']}}</button>
	</footer>
</div>
