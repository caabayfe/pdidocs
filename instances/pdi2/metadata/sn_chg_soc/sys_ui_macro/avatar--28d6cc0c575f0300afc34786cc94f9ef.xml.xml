<div class="soc-user-profile-container">
	<div id="soc-user-profile" class="soc-user-profile" sn-popover-accessibility-focus="{{profile.user.userID}}" >
		<div ng-class="{'soc-avatar': isChatEnabled(profile.user)}">
			<div class="soc-widget-profile-avatar">
				<div class="sn-widget-profile-avatar">
					<div class="sn-avatar_lg sn-avatar_v2">
						<div class="sn-avatar-container" aria-hidden="true">
							<span class="sn-avatar-initials">{{profile.user.initials}}</span>
							<span class="sn-avatar-image" ng-style="getBackgroundStyle()"></span>
						</div>
					</div>
				</div>
			</div>
			<h2 class="soc-user-name" aria-label="{{scheduleSoCCtrl.form.userNameLabel}} {{profile.user.name}}">{{profile.user.name}}</h2>
			<div ng-if="profile.user.title != ''" class="soc-user-details" aria-label="{{scheduleSoCCtrl.form.userTitleLabel}} {{profile.user.title}}">{{profile.user.title}}</div>
		</div>
		<div class="soc-avatar-info-container">
			<ul class="avatar-info">
				<li ng-if="scheduleSoCCtrl.userID != profile.user.userID" class="icon icon-mail defaultCursor">
					<span class="avatar-info-item soc-truncate" uib-tooltip="{{profile.user.email || scheduleSoCCtrl.form.notAvailable}}" show-tooltip-on-text-overflow="" tooltip-class="soc-truncate-tooltip" tooltip-placement="bottom" tooltip-enable="false">
						<a tabindex="0" aria-label="{{scheduleSoCCtrl.form.emailLabel}} {{profile.user.email || scheduleSoCCtrl.form.notAvailable}}" href="mailto:{{profile.user.email}}">{{profile.user.email || scheduleSoCCtrl.form.notAvailable}}</a>
					</span>
				</li>
				<li ng-if="isChatEnabled(profile.user)" class="soc-message-container">
					<button tabindex="0" focus-me="true" id="direct-message-popover-trigger" ng-click="openDirectMessageConversation($event)" ng-keydown="openDirectMessageConversation($event)" class="btn btn-primary soc-btn-message icon-collaboration" aria-label="{{scheduleSoCCtrl.form.sendDirectMsg}}">
						{{scheduleSoCCtrl.form.sendDirectMsg}}
					</button>
				</li>
			</ul>
		</div>
	</div>
</div>
