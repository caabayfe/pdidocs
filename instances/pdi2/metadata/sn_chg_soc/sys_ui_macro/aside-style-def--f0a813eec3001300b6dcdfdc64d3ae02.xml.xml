<?xml version="1.0" encoding="utf-8" ?>
<div class="soc-style-def-container" trap-tab-focus="">
	<div class="sn-aside-header">
		<div focus-here="" ng-click="historyBack($event)" class="sn-aside-btn sn-aside-back-btn icon-chevron-left" aria-label="{{::messages['Back to span styles']}}" uib-tooltip="{{::messages['Back to span styles']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true"/>
		<span>{{::messages['Span Style']}}</span>
		<div ng-click="closeStyleSide($event)" class="sn-aside-btn icon-cross" aria-label="{{::messages['Back to span styles']}}" uib-tooltip="{{::messages['Back to span styles']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true"/>
	</div>
	<div class="soc-aside-body-container">
		<div class="sn-aside-body">
			<div class="sn-aside-group-title">
				<span>{{::messages['The Basics']}}</span>
			</div>
			<ul class="sn-widget sn-widget_padding-top sn-widget_padding-bottom sn-widget-list sn-widget-list-table">
				<li>
					<div>
						<label class="control-label" for="spanStyleName_{{::socStyle.sys_id.value}}">{{::messages['Name']}}</label>
						<input ng-model="socStyle.name.display_value" ng-disabled="!socStyle.__security.canWrite || socStyle.__type === 'schedule'" class="form-control" maxlength="200" id="spanStyleName_{{::socStyle.sys_id.value}}" name="spanStyleName"  autocomplete="off" type="text" />
					</div>
				</li>
				<li>
					<div class="soc-style-field-color">
						<label class="control-label" for="spanColor_{{::socStyle.sys_id.value}}">{{::messages['Span color']}}</label>
						<div class="soc-style-field-holder">
							<span id="spanColor_{{::socStyle.sys_id.value}}" ng-style="{'background-color': socStyle.event_color.value}" class="soc-style-field-color-display">
							</span>
							<span ng-if="socStyle.__security.canWrite" uib-tooltip="{{::messages['Select span color']}}" tooltip-placement="auto bottom" tooltip-append-to-body="true">
								<button class="btn btn-icon soc-btn-color" sn-color-picker="" picker-color="socStyle.event_color.value" picker-label="{{::messages['Select span color']}}">
									<img alt="" class="icon-bucket" src="styles/sn_chg_soc/Fill-color.svg" />
								</button>
							</span>
							<button ng-if="!socStyle.__security.canWrite" class="btn btn-icon soc-btn-color" disabled="disabled" aria-label="{{::messages['Select span color']}}">
								<img alt="" class="icon-bucket" src="styles/sn_chg_soc/Fill-color.svg" />
							</button>
						</div>
					</div>
				</li>
			</ul>
			<div ng-if="socStyle.__type !== 'schedule'" class="sn-aside-group-title soc-aside-border-top">
				<span>{{::messages['Applied filter']}}</span>
			</div>
			<ul ng-if="socStyle.__type !== 'schedule'" class="sn-widget sn-widget_padding-top sn-widget_padding-bottom sn-widget-list sn-widget-list-table">
				<li>
					<div class="soc-style-cond-holder">
						<label class="control-label cond-label" for="spanCondition">{{socStyle.condition.display_value}}</label>
						<button ng-if="socStyle.__security.canWrite" id="spanFilterBtn_{{::socStyle.sys_id.value}}" class="btn btn-default soc-style-button" ng-click="openFilterControl($event)">{{getFilterBtnLabel()}}</button>
					</div>
				</li>
			</ul>
		</div>
		<div class="sn-aside-footer">
			<div ng-if="socStyle.__security.canWrite || socStyle.__security.canDelete" class="sn-widget sn-widget_padding-top sn-widget_padding-bottom sn-widget-list sn-widget-list-table">
				<div class="soc-style-button-holder">
					<button ng-if="socStyle.__security.canWrite" class="btn btn-default soc-style-button soc-style-button-cancel" ng-click="historyBack($event)" aria-label="{{::messages['Cancel']}}">{{::messages['Cancel']}}</button>
					<button ng-if="socStyle.__security.canWrite" id="styleSaveBtn_{{::socStyle.sys_id.value}}" class="btn btn-primary soc-style-button" ng-disabled="!saveEnabled()" ng-click="updateStyle($event);" aria-label="{{::messages['Save']}}">{{::messages['Save']}}</button>
				</div>
				<div ng-if="socStyle.__type !== 'schedule' &amp;&amp; socStyle.__security.canDelete &amp;&amp; socStyle.sys_id.value !== '-1'" class="soc-style-button-holder">
					<button class="btn btn-default soc-style-button soc-style-button-delete" ng-click="deleteStyle($event);" aria-label="{{::messages['Delete']}}">{{::messages['Delete']}}</button>
				</div>
			</div>
		</div>
	</div>
</div>
