<div id="soc-edit-change-schedule-panel" class="soc-condition-builder-modal">
	<header class="modal-header soc-condition-builder-modal-header">
		<h4 id="edit-change-schedule-title" class="modal-title soc-condition-builder-modal-title">{{::editChangeModelCtrl.messages['Title']}}</h4>
		<button ng-click="editChangeModelCtrl.cancel()" class="btn-icon close icon-cross soc-popup-change-schedule-close" tabindex="0">
			<span class="sr-only">{{::editChangeModelCtrl.messages['Close']}}</span>
		</button>
	</header>
	<div class="soc-condition-builder-modal-message" />
	<div id="edit-change-schedule-modal-body" class="modal-body soc-condition-builder-modal-body">
		<div class="row">
			<div class="form-horizontal">
				<div class="form-group">
					<div ng-class="{'is-filled': editChangeModelCtrl.field.name}">
						<label for="name" class="col-sm-3 col-sm-offset-1 control-label required-marker">{{::editChangeModelCtrl.messages['Name']}}</label>
					</div>
					<div class="col-sm-6">
						<input id="name" type="text" class="soc-edit-schedule form-control" ng-maxlength="200" ng-model="editChangeModelCtrl.field.name" />
					</div>
				</div>
				<div class="form-group">
					<label for="start-date-field" class="col-sm-3 col-sm-offset-1 control-label">{{::editChangeModelCtrl.messages['Start date field']}}</label>
					<div class="col-sm-6">
						<select id="start-date-field" class="soc-edit-schedule form-control select2" ng-model="editChangeModelCtrl.field.selectedStartDate" ng-options="option.value as option.label for option in editChangeModelCtrl.field.startDateOptions"></select>
					</div>
				</div>
				<div class="form-group">
					<label for="end-date-field" class="col-sm-3 col-sm-offset-1 control-label">{{::editChangeModelCtrl.messages['End date field']}}</label>
					<div class="col-sm-6">
						<select id="end-date-field" class="soc-edit-schedule form-control select2" ng-model="editChangeModelCtrl.field.selectedEndDate" ng-options="option.value as option.label for option in editChangeModelCtrl.field.endDateOptions"></select>
					</div>
				</div>
				<div class="form-group">
					<label for="conditions-field" class="col-sm-3 col-sm-offset-1 control-label">{{::editChangeModelCtrl.messages['Conditions']}}</label>
					<div class="col-sm-6">
						<div class="soc-filter-icon-conditions">
							<button id="conditions-field" class="btn btn-default icon-filter control-btn filter-btn" ng-click="editChangeModelCtrl.field.expandFilter=!editChangeModelCtrl.field.expandFilter" aria-expanded="{{::editChangeModelCtrl.field.expandFilter}}" aria-label="{{::editChangeModelCtrl.messages['Filter']}}">
								<span class="sr-only">{{::editChangeModelCtrl.messages['Show or hide filter']}}</span>
							</button>
						</div>
						<div class="soc-conditions-compressed">
							{{editChangeModelCtrl.field.conditionDisplayValue}}
						</div>
					</div>
				</div>
			</div>
		</div>
		<div ng-show="editChangeModelCtrl.field.expandFilter" class="row soc-filter-wrapper">
			<soc-filter-widget table="{{table}}" filter-config="filterConfig"/>
		</div>
	</div>
	<div class="modal-footer soc-condition-builder-modal-footer">
		<button class="btn btn-default" type="button" ng-click="editChangeModelCtrl.cancel()">{{::editChangeModelCtrl.messages['Cancel']}}</button>
		<button ng-if="editChangeModelCtrl.showSubmit" ng-disabled="!editChangeModelCtrl.enableSubmit()" class="btn btn-primary" type="button" ng-click="editChangeModelCtrl.submit()">{{::editChangeModelCtrl.messages['Submit']}}</button>
	</div>
</div>
