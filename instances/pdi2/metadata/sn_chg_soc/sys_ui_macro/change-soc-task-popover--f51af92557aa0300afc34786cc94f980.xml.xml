<div class="soc-popover-wrapper">
	<div class="soc-popover-row">
		<div class="soc-popover-left-column soc-popover-column">
			<div ng-repeat="leftField in leftFields">
				<div class="col-xs-12 soc-popover-field soc-popover-left"
					aria-label="{{ leftField.label }} {{ leftField.display_value || emptyValue }}">
					<label class="col-xs-6 soc-popover-label">{{ leftField.label }}</label>
					<div id="{{ leftField.column_name }}_left" name="{{ leftField.column_name }}_left"
						class="col-xs-6 soc-popover-value" check-overflow=""
						ng-attr-uib-tooltip="{{ overflows ? leftField.display_value : undefined }}"
						tooltip-placement="auto" tooltip-append-to-body="true" tooltip-popup-delay="1000"
						tooltip-class="soc-tooltip">
						{{ leftField.display_value || emptyValue }}
					</div>
				</div>
			</div>
		</div>

		<div class="soc-popover-right-column soc-popover-column">
			<div ng-repeat="rightField in rightFields">
				<div class="col-xs-12 soc-popover-field soc-popover-right"
					aria-label="{{ rightField.label }} {{ rightField.display_value || emptyValue }}">
					<label class="col-xs-6 soc-popover-label">{{ rightField.label }}</label>
					<div id="{{ rightField.column_name }}_right" name="{{ rightField.column_name }}_right"
						class="col-xs-6 soc-popover-value" check-overflow=""
						ng-attr-uib-tooltip="{{ overflows ? rightField.display_value : undefined }}"
						tooltip-placement="auto" tooltip-append-to-body="true" tooltip-popup-delay="1000"
						tooltip-class="soc-tooltip">
						{{ rightField.display_value || emptyValue }}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
