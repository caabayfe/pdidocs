<?xml version="1.0" encoding="utf-8" ?>
<div ng-class="{'soc-sharing-search-active' : shareCtrl.suggestions.query}">
	<div class="soc-sharing-invitation-search">
		<div class="soc-sharing-invitation-search-label">
			<div id="soc-sharing-invitation-search-label">{{::messages['To:']}}</div>
		</div>
		<div id="recipient-list" class="soc-sharing-invitation-search-content">
			<div class="sn-add-users-user" ng-repeat="recipient in pendingRecipients track by recipient.sys_id">
				<span>{{recipient.name}}</span>
				<div class="icon icon-cross" ng-click="removeRecipient($event, $index)" ng-keypress="removeRecipient($event, $index)" tabindex="0" aria-label="{{i18n.format(messages['Remove {0}'], recipient.name)}}" role="button" />
			</div>
			<div class="sn-add-users-search-container">
				<div class="sn-add-users-search">
					<div class="sn-navhub-title">
						<suggestion-input />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
