<?xml version="1.0" encoding="utf-8" ?>
<div class="popover soc-task-popover" role="tooltip" sn-popover-accessibility-focus="true">
	<div class="arrow soc-popover-arrow"></div>
	<div class="soc-task-popover-inner">
		<div class="soc-popover-title">
			<h2 class="popover-title"></h2>
			<button id="soc-open-record" class="btn btn-default soc-btn-open-record" ng-click="handleOpenRecord()">{{openRecord}}</button>
		</div>
		<div class="popover-content soc-popover-content"></div>
	</div>
</div>
