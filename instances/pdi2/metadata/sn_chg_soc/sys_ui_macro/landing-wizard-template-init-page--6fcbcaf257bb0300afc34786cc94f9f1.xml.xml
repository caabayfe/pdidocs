<!-- First page -->
<div class="row" ng-show="isInitPage()">
	<div class="form-horizontal">
		<div class="form-group">
			<div ng-class="{'is-filled': data.name}">
				<label for="name" class="col-sm-3 col-sm-offset-1 control-label required-marker">{{::messages['Name']}}</label>
			</div>
			<div class="col-sm-6">
				<input id="name" type="text" class="form-control" ng-maxlength="200" ng-model="data.name" />
			</div>
		</div>
		<div class="form-group">
			<label for="start-date-field" class="col-sm-3 col-sm-offset-1 control-label">{{::messages['Start date field']}}</label>
			<div class="col-sm-6">
				<select id="start-date-field" class="form-control select2" ng-model="selectedStart" ng-options="field.columnName as field.label for field in startDateFields"></select>
			</div>
		</div>
		<div class="form-group">
			<label for="end-date-field" class="col-sm-3 col-sm-offset-1 control-label">{{::messages['End date field']}}</label>
			<div class="col-sm-6">
				<select id="end-date-field" class="form-control select2" ng-model="selectedEnd" ng-options="field.columnName as field.label for field in endDateFields"></select>
			</div>
		</div>
	</div>
</div>
