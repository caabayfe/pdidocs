<div>
	<div ng-if="scheduleSoCCtrl.showSplashMsg" class="soc-splash-msg-container">
		<div class="soc-splash-msg-card">
			<div class="soc-splash-icon-container">
				<div class="soc-splash-icon">
					<i class="icon-calendar soc-splash-calendar" />
				</div>
			</div>
			<div class="soc-splash-title">{{scheduleSoCCtrl.getTitle()}}</div>
			<div class="soc-splash-msg">{{scheduleSoCCtrl.getDescription()}}</div>
			<div ng-if="scheduleSoCCtrl.getInstruction() != ''" class="soc-splash-msg" style="padding-top: 10px;">{{scheduleSoCCtrl.getInstruction()}}</div>
		</div>
	</div>
</div>
