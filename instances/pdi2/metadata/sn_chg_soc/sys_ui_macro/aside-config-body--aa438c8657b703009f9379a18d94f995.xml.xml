<?xml version="1.0" encoding="utf-8" ?>
<div class="sn-aside-body">
	<!-- Configure Labels -->
	<div class="sn-aside-group-title">
		<span>{{messages['Columns']}}</span>
	</div>
	<ul ng-class="showBlackoutOption || showMaintOption ? 'sn-widget_border-bottom' : ''" class="sn-widget-list_v2 sn-widget-list_dense sn-widget-list_borderless sn-widget">
		<!-- Show Config Item column -->
		<li class="state-disable-bg">
			<div class="sn-widget-list-content">
				<label class="sn-widget-list-title" for="configItemColumnOption">{{messages['Configuration Item']}}</label>
			</div>
			<div class="sn-widget-list-content sn-widget-list-content_static">
				<span class="input-switch">
					<input id="configItemColumnOption" type="checkbox" name="configItemColumn" ng-model="showConfigItem" ng-change="updateColumnLayout('config_item')"/>
					<label aria-hidden="true" class="switch" for="configItemColumnOption"/>
				</span>
			</div>
		</li>
		<!-- Show Duration column -->
		<li class="state-disable-bg">
			<div class="sn-widget-list-content">
				<label class="sn-widget-list-title" for="durationColumnOption">{{messages['Duration']}}</label>
			</div>
			<div class="sn-widget-list-content sn-widget-list-content_static">
				<span class="input-switch">
					<input id="durationColumnOption" type="checkbox" name="durationColumn" ng-model="showDuration" ng-change="updateColumnLayout('duration')"/>
					<label aria-hidden="true" class="switch" for="durationColumnOption"/>
				</span>
			</div>
		</li>
	</ul>
	<!-- Configure Labels -->
	<div class="sn-aside-group-title" ng-show="showBlackoutOption || showMaintOption">
		<span>{{messages['Schedules']}}</span>
	</div>
	<ul ng-class="objectKeysLengthFilter(childRecords) > 0 ? 'sn-widget_border-bottom' : ''" class="sn-widget-list_v2 sn-widget-list_dense sn-widget-list_borderless sn-widget" ng-show="showBlackoutOption || showMaintOption">
		<!-- Show Blackout Schedules -->
		<li class="state-disable-bg" ng-show="showBlackoutOption">
			<div class="sn-widget-list-content">
				<label class="sn-widget-list-title" for="showBlackoutSchedulesOption">{{messages['Blackout']}}</label>
			</div>
			<div class="sn-widget-list-content sn-widget-list-content_static">
				<span class="input-switch">
					<input id="showBlackoutSchedulesOption" type="checkbox" name="showBlackoutSchedules" ng-model="showBlackoutSchedules" ng-change="updateScheduleLayer()"/>
					<label aria-hidden="true" class="switch" for="showBlackoutSchedulesOption"/>
				</span>
			</div>
		</li>
		<!-- Show Maintenance Schedules -->
		<li class="state-disable-bg" ng-show="showMaintOption">
			<div class="sn-widget-list-content">
				<label class="sn-widget-list-title" for="showMaintSchedulesOption">{{messages['Maintenance']}}</label>
			</div>
			<div class="sn-widget-list-content sn-widget-list-content_static">
				<span class="input-switch">
					<input id="showMaintSchedulesOption" type="checkbox" name="showMaintSchedules" ng-model="showMaintSchedules" ng-change="updateScheduleLayer()"/>
					<label aria-hidden="true" class="switch" for="showMaintSchedulesOption"/>
				</span>
			</div>
		</li>
	</ul>
	<!-- Show Child Records -->
	<div class="sn-aside-group-title" ng-show="objectKeysLengthFilter(childRecords) > 0">
		<span>{{messages['Related Records']}}</span>
	</div>
	<ul class="sn-widget-list_v2 sn-widget-list_dense sn-widget-list_borderless sn-widget" ng-show="objectKeysLengthFilter(childRecords) > 0">
		<li ng-repeat="(tableName, childRecord) in childRecords" class="state-disable-bg">
			<div class="sn-widget-list-content">
				<label class="sn-widget-list-title" for="{{childRecord.inputId}}">{{childRecord.label}}</label>
			</div>
			<div class="sn-widget-list-content sn-widget-list-content_static">
				<span class="input-switch">
					<input id="{{childRecord.inputId}}" type="checkbox" name="{{childRecord.name}}" ng-model="childRecord.show" ng-change="childRecord.change(tableName)"/>
					<label aria-hidden="true" class="switch" for="{{childRecord.inputId}}"/>
				</span>
			</div>
		</li>
	</ul>
</div>
