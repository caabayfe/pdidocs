<div role="region" aria-live="polite" aria-relevant="additions" aria-atomic="true">
	<div id="no-results-found" ng-if="scheduleSoCCtrl.showNoResultsFound()" class="soc-search-results">
		{{::scheduleSoCCtrl.messages['No results found']}}
	</div>
	<div ng-if="isLoading() &amp;&amp; !scheduleSoCCtrl.isSearching()" class="soc-loading-msg-container">
		<div class="soc-splash-msg">{{::scheduleSoCCtrl.messages['Loading...']}}</div>
	</div>
	<div ng-if="scheduleSoCCtrl.isSearching()" class="soc-loading-msg-container">
		<div class="soc-splash-msg">{{::scheduleSoCCtrl.messages['Searching...']}}</div>
	</div>
	<div ng-if="scheduleSoCCtrl.limitReached" class="soc-limit-msg-container">
		<div class="soc-splash-msg">{{::scheduleSoCCtrl.messages['Limit Reached']}}</div>
	</div>
</div>
