<div id="soc-copy-change-schedule-panel" class="soc-copy-change-schedule-panel">
	<header class="modal-header soc-copy-change-schedule-header">
		<h4 class="modal-title copy-change-schedule-title">{{::copyChangeModelCtrl.messages["Copy change schedule"]}}</h4>
		<button ng-click="copyChangeModelCtrl.close()" class="btn-icon close icon-cross soc-popup-change-schedule-close" tabindex="0">
			<span class="sr-only">{{::copyChangeModelCtrl.messages["Close"]}}</span>
		</button>
	</header>
	<div class="modal-body copy-change-schedule-body">
		<div class="row">
			<div class="form-horizontal">
				<div class="form-group">
					<div ng-class="{'is-filled': copyChangeModelCtrl.form.name}">
						<label for="name" class="col-sm-3 col-sm-offset-1 control-label required-marker">{{::copyChangeModelCtrl.messages['Name']}}</label>
					</div>
					<div class="col-sm-6">
						<input id="name" type="text" class="form-control" ng-maxlength="200" ng-model="copyChangeModelCtrl.form.name" placeholder="{{::copyChangeModelCtrl.form.placeholder}}"/>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="modal-footer soc-copy-change-schedule-footer">
		<button class="btn btn-default" type="button" ng-click="copyChangeModelCtrl.close()">{{::copyChangeModelCtrl.messages["Cancel"]}}</button>
		<button class="btn btn-primary" type="button" ng-click="copyChangeModelCtrl.copy()">{{::copyChangeModelCtrl.messages["Copy"]}}</button>
	</div>
</div>
