<!-- Create new Change Schedule modal -->
<div id="soc-wizard" class="wizard-modal" ng-class="{'soc-is-init': isInitPage()}" sn-popover-accessibility-focus="">
  <header class="modal-header wizard-modal-header">
    <button ng-if="!isInitPage()" class="soc-wizard-back btn-icon btn-back icon-chevron-left" ng-click="back()" tabindex="0"><span class="sr-only">{{::messages['Back']}}</span></button>
    <h4 id="new-change-schedule" class="modal-title wizard-modal-title">{{::messages['Create New Change Schedule']}}</h4>
    <button ng-click="cancel()" class="btn-icon close icon-cross wizard-modal-close" tabindex="0">
      <span class="sr-only">{{::messages['Close']}}</span>
    </button>
  </header>
  <div class="soc-condition-builder-modal-message" />
  <div class="modal-body wizard-modal-body">
    <sn-landing-wizard-init-page />
    <sn-landing-wizard-condition-page />
  </div>
  <div class="modal-footer wizard-modal-footer">
    <div class="row">
      <div class="col-md-12">
        <button class="btn btn-default" type="button" ng-click="cancel()">{{::messages['Cancel']}}</button>
        <button ng-if="isInitPage()" class="btn btn-primary" type="button" ng-click="next()" ng-disabled="!data.name" tabindex="0">{{::messages['Next']}}</button>
        <button ng-if="!isInitPage()" class="btn btn-primary" type="button" ng-click="submit()" tabindex="0">{{::messages['Submit']}}</button>
      </div>
    </div>
  </div>
</div>
