<div id="soc-sort" class="sort-wrapper">
    <label for="landing-sort" class="soc-sort-label">
      <span class="label-text">{{::messages['Sort By']}}</span>
    </label>
    <select id="landing-sort"
      class="soc-sort-select select2 form-control"
