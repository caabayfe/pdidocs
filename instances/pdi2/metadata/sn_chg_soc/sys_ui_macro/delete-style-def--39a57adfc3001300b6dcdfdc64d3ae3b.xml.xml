<?xml version="1.0" encoding="utf-8" ?>
<div id="soc_delete_style" class="soc-modal-style">
	<header class="modal-header">
		<h4 class="modal-title">{{::messages['Delete span style']}}</h4>
	</header>
	<div class="modal-body">
		<p>{{deleteStyleMsg}}</p>
	</div>
	<footer class="modal-footer flex">
		<button data-dismiss="modal" class="btn btn-default" ng-click="cancel()">{{::messages['Cancel']}}</button>
		<button data-dismiss="modal" class="btn btn-danger" ng-click="delete()">{{::messages['Delete']}}</button>
	</footer>
</div>
