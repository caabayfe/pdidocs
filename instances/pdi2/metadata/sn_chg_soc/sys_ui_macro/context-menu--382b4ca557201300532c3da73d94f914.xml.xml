<div id="soc_context_menu_panel" class="soc-context-menu-panel" popover-trigger="'focus'">
	<ul class="soc-context-menu" role="menu" trap-focus="" focus-menu-item="true">
		<span ng-if="contextMenuCtrl.contextMenu.showCreate">
			<sn-landing-wizard template="sn_chg_soc_context_menu_item_new.xml" label="{{::contextMenuCtrl.messages['Create New Schedule']}}" />
		</span>
		<li class="soc-context-menu-item" ng-click="contextMenuCtrl.toggleEditSchedule()" ng-if="contextMenuCtrl.contextMenu.showEdit" role="menuitem">{{::contextMenuCtrl.messages["Edit Schedule"]}}</li>
		<li class="soc-context-menu-item" ng-click="contextMenuCtrl.toggleCopySchedule()" ng-if="contextMenuCtrl.contextMenu.showCopy" role="menuitem">{{::contextMenuCtrl.messages["Copy Schedule"]}}</li>
		<li class="soc-context-menu-item" ng-click="contextMenuCtrl.redirectToChangeScheduleDef()" role="menuitem">{{::contextMenuCtrl.messages["View Schedule Definition"]}}</li>
		<li class="soc-context-menu-item" ng-click="contextMenuCtrl.deleteChangeSchedules()" ng-if="contextMenuCtrl.contextMenu.showDelete" role="menuitem">{{::contextMenuCtrl.messages["Delete"]}}</li>
	</ul>
</div>
