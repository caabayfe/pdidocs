<div class="schedule-left-controls">
	<button ng-click="contextMenuCtrl.backToChangeSchedules()" 
			ng-disabled="isLoading()" 
			aria-label="{{::contextMenuCtrl.messages['Back to change schedules']}}" 
			uib-tooltip="{{::contextMenuCtrl.messages['Back to change schedules']}}" 
			tooltip-placement="auto bottom" 
			tooltip-trigger="'focus mouseenter'"
			class="soc-back-btn btn btn-icon icon-chevron-left pull-left"></button>
	<button ng-click="contextMenuCtrl.toggleContextMenu()"
		id="btnContextMenu"
			ng-disabled="isLoading()"
			popover-is-open="contextMenuCtrl.contextMenu.open"
			uib-popover-template="contextMenuCtrl.contextMenu.template"
			popover-trigger="'outsideClick'"
			popover-placement="bottom-left"
			popover-class="soc-context-menu-popover"
			aria-label="{{::contextMenuCtrl.messages['Open context menu']}}"
			uib-tooltip="{{::contextMenuCtrl.messages['Open context menu']}}"
			tooltip-placement="auto bottom"
			tooltip-trigger="'focus mouseenter'"
			class="context-menu btn btn-icon icon-menu pull-left" />
</div>
