    "runManualAIWrapUp": {
        "operation": {
            "operand": {
                "operation": {
                    "left": {
                        "binding": {
                            "address": [
                                "omnichannel_get_system_properties",
                                "output",
                                "properties",
                                "com.glide.interaction.auto_generate_ai_wrap_up"
                            ]
                        },
                        "type": "DATA_OUTPUT_BINDING"
                    },
                    "operator": "EQUAL",
                    "right": {
                        "type": "JSON_LITERAL",
                        "value": "true"
                    }
                },
                "type": "BINARY"
            },
            "operator": "NOT"
        },
        "type": "UNARY"
    },
