                                "overrides": null,
                                "propertyValues": {
                                    "color": {
                                        "script": {
                                            "apiVersion": "2.0.0",
                                            "controllerElementId": null,
                                            "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    var state = api.context.props.payload.props_details.compliance_state;\n    if (state == \"Compliant\") {\n        return \"green\";\n    } else if (state == \"Not compliant\") {\n        return \"warning\";\n    }\n}",
                                            "scriptSysId": "4e740cce43b73110d0881f062bb8f26f",
                                            "target": null
                                        },
                                        "type": "CLIENT_TRANSFORM_SCRIPT"
                                    },
                                    "icon": {
                                        "script": {
                                            "apiVersion": "2.0.0",
                                            "controllerElementId": null,
                                            "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    var state = api.context.props.payload.props_details.compliance_state;\n    if (state == \"Compliant\") {\n        return \"Circle Check Outline\";\n    } else if (state == \"Not compliant\") {\n        return \"Diamond Exclamation Outline\";\n    }\n}",
                                            "scriptSysId": "0e740cce43b73110d0881f062bb8f26f",
                                            "target": null
                                        },
                                        "type": "CLIENT_TRANSFORM_SCRIPT"
                                    },
                                    "label": {
                                        "script": {
                                            "apiVersion": "2.0.0",
                                            "controllerElementId": null,
                                            "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    var state = api.context.props.payload.props_details.compliance_state;\n    return state == \"Compliant\" ? \"Configured\" : \"Not configured\";\n}",
                                            "scriptSysId": "f19b931943c40210d0881f062bb8f2eb",
                                            "target": null
                                        },
                                        "type": "CLIENT_TRANSFORM_SCRIPT"
                                    },
                                    "variant": {
                                        "type": "JSON_LITERAL",
                                        "value": "tertiary"
                                    }
