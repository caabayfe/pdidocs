<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g2:evaluate var="jvar_user" object="true">
		gs.getUser();
	</g2:evaluate>
	<g2:evaluate var="jvar_roles">
		global.ChangeCommon.getRoles();
	</g2:evaluate>
	<g:evaluate var="jvar_accessibility_enable">
		global.ChangeCommon.isAccessibilityEnabled();
	</g:evaluate>

	<g2:set_if var="jvar_cssCacheTheme" test="$[sn_ui.PolarisUI.canUsePolarisCSS()]" true="$[jvar_css_cache_key]" false="c=$[gs.getCssCacheVersionString()]" />

	<g:if_polaris>
		<g:then>
			<g:inline template="polarisberg_output.xml"/>
			<g:requires name="styles/dist/common/sn_common.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/sn_notification.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/sn_stream.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="/styles/thirdparty/datetimepicker.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/css_includes_ng_form_elements.css" includes="true" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/heisenberg/source_sans_pro.css" params="$[jvar_cssCacheTheme]" />
		</g:then>
		<g:else>
			<g:requires name="styles/dist/common/sn_common.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/sn_notification.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/sn_stream.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="/styles/thirdparty/datetimepicker.css" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/css_includes_ng_form_elements.css" includes="true" params="$[jvar_cssCacheTheme]" />
			<g:requires name="styles/heisenberg/source_sans_pro.css" params="$[jvar_cssCacheTheme]" />
			<g:inline template="heisenberg_output.xml" type="css"/>
		</g:else>
	</g:if_polaris>

	<g:requires name="styles/filter.css" params="$[jvar_cssCacheTheme]" />

	<link href="8e83838553db10100999ddeeff7b1219.cssdbx?$[jvar_cssCacheTheme]" rel="stylesheet" type="text/css" />
	<j:if test="${jvar_text_direction == 'rtl'}">
		<g:requires name="styles/heisenberg/heisenberg_rtl.css" includes="true" params="$[jvar_cssCacheTheme]" />
		<link href="4093838553db10100999ddeeff7b1293.cssdbx?$[jvar_cssCacheTheme]" rel="stylesheet" type="text/css" />
	</j:if>

	<!-- Change Schedules Landing - Accessibility -->
	<j:if test="${jvar_accessibility_enable == true}">
		<link href="1b83438553db10100999ddeeff7b12d0.cssdbx?$[jvar_cssCacheTheme]" rel="stylesheet" type="text/css" />
	</j:if>

	<!-- JS includes for New Change Schedule Wizard -->
	<g:requires name="scripts/lib/jquery2_includes.js" includes="true" />
	<g:requires name="scripts/jquery-ui-supported.js" />
	<g:requires name="scripts/angular_includes_1.5.11.js" includes="true" />
	<g:requires name="scripts/sn_chg_model_ui/edited_tooltip.js" />
	<g:requires name="scripts/heisenberg/bootstrap/popover.js" />
	<g:requires name="scripts/select2_doctype/select2.min.js" />
	<g:requires name="scripts/js_includes_ng_form_elements.js" includes="true"/>
	<g:requires name="scripts/sn/common/js_includes_common.js" includes="true" />
	<g:requires name="scripts/js_includes_filter_widget.js" includes="true"/>
	<g:requires name="scripts/sn_chg_model_ui/thirdparty/ui-bootstrap-tpls-2.5.0.min.js" />
	<g:requires name="scripts/sn_chg_model_ui/thirdparty/moment.min.js" />
	<g:requires name="script/app_com.jsdbx" />
	<g:requires name="script/app_com.modelUtil.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_accessibility.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.filter_widget.jsdbx" />

	<g:requires name="scripts/sn/common/clientScript/glideUser.js" />

	<g:requires name="script/sn_chg_model_ui.landing.app.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.chgModelService.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_page_header.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_tabs.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_card.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_decoration.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_notifications.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.sn.app_itsm.now.iscroll.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.filter_widget.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_filter.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.tooltip_overflow.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_splash_screens.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.landing_sort.jsdbx" />
	<g:requires name="script/sn_chg_model_ui.notification.jsdbx" />
</j:jelly>
