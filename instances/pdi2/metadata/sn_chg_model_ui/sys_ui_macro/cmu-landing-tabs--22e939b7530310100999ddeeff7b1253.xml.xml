<div class="sn-navhub sn-navhub_transparent">
	<ul class="sn-navhub-content" role="tablist" add-uib-tab-accessibility="">
		<li id="pinned"
			ng-class="{'state-active':chgModelLandingCtrl.filter == 'pinned'}"
			ng-click="chgModelLandingCtrl.filterBy('pinned')"
			focus-me="{{chgModelLandingCtrl.filter == 'pinned'}}"
			role="tab"
			aria-label="{{chgModelLandingCtrl.form.pinned.title}}"
			aria-selected="{{chgModelLandingCtrl.filter == 'pinned'}}"
			aria-controls="change-model-tabpanel"
			class="btn sn-navhub-btn sn-navhub-btn_text"
			tabindex="0">{{chgModelLandingCtrl.form.pinned.title}}
		</li>
		<li id="change_models"
			ng-if="chgModelLandingCtrl.isStdChgCatalogActive"
			ng-class="{'state-active':chgModelLandingCtrl.filter == 'change_models'}"
			focus-me="{{chgModelLandingCtrl.filter == 'change_models'}}"
			ng-click="chgModelLandingCtrl.filterBy('change_models')"
			role="tab"
			aria-label="{{chgModelLandingCtrl.form.change_models.title}}"
			aria-selected="{{chgModelLandingCtrl.filter == 'change_models'}}"
			aria-controls="change-model-tabpanel"
			class="btn sn-navhub-btn sn-navhub-btn_text"
			tabindex="0">{{chgModelLandingCtrl.form.change_models.title}}
		</li>
		<li id="preapproved"
			ng-if="chgModelLandingCtrl.isStdChgCatalogActive"
			ng-class="{'state-active':chgModelLandingCtrl.filter == 'preapproved'}"
			focus-me="{{chgModelLandingCtrl.filter == 'preapproved'}}"
			ng-click="chgModelLandingCtrl.filterBy('preapproved')"
			role="tab"
			aria-label="{{chgModelLandingCtrl.form.preapproved.title}}"
			aria-selected="{{chgModelLandingCtrl.filter == 'preapproved'}}"
			aria-controls="change-model-tabpanel"
			class="btn sn-navhub-btn sn-navhub-btn_text"
			tabindex="0">{{chgModelLandingCtrl.form.preapproved.title}}
		</li>
		<li id="change_templates"
			ng-class="{'state-active':chgModelLandingCtrl.filter == 'change_templates'}"
			focus-me="{{chgModelLandingCtrl.filter == 'change_templates'}}"
			ng-click="chgModelLandingCtrl.filterBy('change_templates')"
			role="tab"
			aria-label="{{chgModelLandingCtrl.form.change_templates.title}}"
			aria-selected="{{chgModelLandingCtrl.filter == 'change_templates'}}"
			aria-controls="change-model-tabpanel"
			class="btn sn-navhub-btn sn-navhub-btn_text"
			tabindex="0">{{chgModelLandingCtrl.form.change_templates.title}}
		</li>
		<li id="all"
			ng-class="{'state-active':chgModelLandingCtrl.filter == 'all'}"
			focus-me="{{chgModelLandingCtrl.filter == 'all'}}"
			ng-click="chgModelLandingCtrl.filterBy('all')"
			role="tab"
			aria-label="{{chgModelLandingCtrl.form.all.title}}"
			aria-selected="{{chgModelLandingCtrl.filter == 'all'}}"
			aria-controls="change-model-tabpanel"
			class="btn sn-navhub-btn sn-navhub-btn_text"
			tabindex="0">{{chgModelLandingCtrl.form.all.title}}
		</li>
	</ul>
	<!-- search disabled -->
	<sn-landing-sort ng-if="false"/>
</div>
