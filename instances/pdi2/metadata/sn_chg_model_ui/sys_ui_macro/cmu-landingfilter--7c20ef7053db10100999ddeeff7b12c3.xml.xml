
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<now-message key="Filter" value="${gs.getMessage('Filter')}" />
	<form class="change-model-board-filter-search ng-pristine ng-valid"
		role="search">
	    <div class="input-group-transparent">
			<span ng-disabled="isLoading()"
				class="input-group-addon-transparent icon-filter"
				ng-class="{'icon-filter-active': !searchText || searchText === ''}">
			</span>
			<input id="search2"
				name="search2"
				placeholder="{{placeholder}}"
				aria-label="{{ariaLabel}}"
				ng-readonly="isDisabled()"
				ng-model="searchText.value"
				class="form-control form-control-search ng-pristine ng-untouched ng-valid ng-empty"
				type="search"
				sn-trim-on-blur=""
				aria-invalid="false">
			</input>
	    </div>
	</form>
</j:jelly>
