<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core">
<div class="change-model-sort-filter-widget-wrapper" ng-show="showSortSection()">
	<now-message key="A to Z" value="${gs.getMessage('A to Z')}"/>
	<now-message key="Z to A" value="${gs.getMessage('Z to A')}"/>

	<div name="sortFilter" aria-labelledby="{{uid}}-sort-filter-title" class="change-model-wizard-sort">
		<div class="ng-cloak">
			<div id="{{uid}}-sort-filter-title" class="change-model-wizard-sort-title">${gs.getMessage('Sorting Order')}</div>
			<div class="sort-set">
				<div class="sort-row" ng-repeat="sortItem in sortItems">
					<!-- field selector -->
					<span class="count-col col-md-1">
						{{$index + 1}}
					</span>
					<span class="field-col form-group col-md-5">
						<label for="cond_operator_{{$index}}" class="sr-only">
							${gs.getMessage('Sort Field')}
						</label>
						<select id="{{table}}_sort_field_{{$index}}"
							ng-model="sortItem.column_name"
							ng-options="sortField.field as sortField.field_label for sortField in sortFields"
							class="form-control">
							<option value="" default="default">${gs.getMessage('-- None --')}</option>
						</select>
					</span>

					<!-- operator selector -->
					<span class="operator-col form-group col-md-4">
						<label for="cond_operator_{{$index}}" class="sr-only">
							${gs.getMessage('Sort Direction')}
						</label>
						<select id="{{table}}_sort_type_{{$index}}"
							ng-model="sortItem.ascending"
							ng-options="sortDirection.value as sortDirection.label for sortDirection in sortDirections"
							class="form-control">
							<option value="" default="default">${gs.getMessage('-- None --')}</option>
						</select>
					</span>

					<!-- row buttons -->
					<span class="btn-col col-md-2">
						<button id="{{table}}_remove_sort_{{$index}}"
							class="btn btn-icon btn-default icon-delete remove-sort-row sn-filter-tooltip"
							ng-click="removeSortItem($index)"
							type="button"
							data-original-title="${gs.getMessage('Remove Sort Order')}"
							data-placement="top">
							<span class="sr-only">
								${gs.getMessage('Remove Sort Order')}
							</span>
						</button>
						<button id="{{table}}_add_sort_{{$index}}"
							class="btn btn-icon btn-default icon-add-circle-empty sn-filter-tooltip"
							ng-click="addSortItem()" type="button"
							data-original-title="${gs.getMessage('Add Sort Order')}"
							data-placement="top">
								<span class="sr-only">
									${gs.getMessage('Add Sort Order')}
								</span>
						</button>
					</span>
				</div>
			</div>
		</div>
	</div>
</div>

</j:jelly>
