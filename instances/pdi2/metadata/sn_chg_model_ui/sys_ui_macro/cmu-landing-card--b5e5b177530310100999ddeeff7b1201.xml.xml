<div class="change-model-card" ng-click="createChangeRequest(chgModel.link)" role="presentation" tabindex="-1">
<button type="button" class="change-model-card__trigger-button default-focus-outline" ng-click="createChangeRequest(chgModel.link)" aria-label="{{chgModel.name.display_value}}" aria-describedby="chg-model-pill-{{chgModel.sys_id.value}} chg-model-description-{{chgModel.sys_id.value}} chg-model-type-{{chgModel.sys_id.value}}"></button>
<div class="change-model-card__accent-bar" ng-style="chgModelLandingCtrl.getAccentStyle(chgModel.color.value)" />
<div ng-show="chgModel.name.display_value"
	class="change-model-card-component"
	id="{{chgModel.sys_id.value}}">
	<div class="change-model-card__row">
		<div class="chg-model-model-name change-model-truncate"
			uib-tooltip="{{chgModel.name.display_value}}"
			show-tooltip-on-text-overflow=""
			tooltip-class="change-model-truncate-tooltip"
			tooltip-placement="auto top"
			tooltip-enable="false">
			<span ng-bind-html="chgModelLandingCtrl.highlight(chgModel.name.display_value, chgModelLandingCtrl.textSearch)"></span>
		</div>
		<div class="change-model-card__row__cell">
			<div class="chg-model__pill" id="chg-model-pill-{{chgModel.sys_id.value}}" ng-if="chgModel.isPreapproved" ng-bind="chgModelLandingCtrl.form.preapproved.title" ></div>
			<button class="change-model-card__button btn btn-icon change-model-btn-color"
				ng-click="tooltipIsOpen=false; chgModelLandingCtrl.togglePinned($event, chgModel)"
				ng-keypress="$event.stopPropagation();"
				aria-label="{{chgModelLandingCtrl.getPinA11yLabel(chgModel.name.display_value, chgModel.sys_id.value)}}"
				uib-tooltip="{{chgModelLandingCtrl.isPinned(chgModel.sys_id.value) ? chgModelLandingCtrl.form.unpinChangeModel : chgModelLandingCtrl.form.pinChangeModel}}"
				tooltip-placement="auto top"
				tooltip-append-to-body="true"
				tooltip-is-open="tooltipIsOpen"
				tooltip-class="change-model-truncate-tooltip"
				ng-focus="tooltipIsOpen=true;"
				ng-blur="tooltipIsOpen=false;" >
				<svg ng-if="!chgModelLandingCtrl.isPinned(chgModel.sys_id.value)" width="16px" height="16px" viewBox="0 0 16 16" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-label="{{chgModelLandingCtrl.form.pinChangeModel}}">
					<title>SVG/thumbtack-outline-16</title>
					<g id="SVG/thumbtack-outline-16" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
						<path d="M9.70578155,0.532839186 L15.4370681,6.26412573 L13.31552,8.3856738 L12.218141,7.28688066 L9.44068787,10.0654741 C9.65768151,10.9479926 9.63112362,11.8778638 9.36094072,12.7488789 L9.11553935,13.5400033 L6.09289054,10.5178392 L2.53699732,14.0742293 L1.82989054,13.3671225 L5.38589054,9.81083919 L2.30929789,6.73376185 L3.10042235,6.48836048 C4.03564896,6.19825961 5.03741297,6.1893738 5.9747987,6.45959651 L8.68256832,3.75130807 L7.58423336,2.65438737 L9.70578155,0.532839186 Z M9.70578155,1.94705275 L8.99890262,2.65393169 L10.0971698,3.75078465 L6.24148865,7.6072045 L5.94295821,7.49980529 C5.40432107,7.30602536 4.83154893,7.23129897 4.26606845,7.27631886 L8.57297907,11.5832295 C8.6135105,11.0741503 8.55703331,10.5587622 8.40356931,10.0673489 L8.31342543,9.77869549 L12.2184513,5.87206631 L13.3159755,6.97100478 L14.0228545,6.26412573 L9.70578155,1.94705275 Z" id="Flatten" fill="currentColor" fill-rule="nonzero"></path>
					</g>
				</svg>
				<svg ng-if="chgModelLandingCtrl.isPinned(chgModel.sys_id.value)" width="16px" height="16px" viewBox="0 0 16 16" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-label="{{chgModelLandingCtrl.form.unpinChangeModel}}">
					<title>SVG/thumbtack-fill-16</title>
					<g id="SVG/thumbtack-fill-16" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
						<path d="M9.70624495,1.24013804 L14.7304247,6.2643178 L13.3162111,7.67853136 L12.2187596,6.57966556 L8.88130108,9.91849431 C9.15357158,10.7903428 9.15442174,11.7286737 8.88385155,12.6009374 L6.44689054,10.164138 L2.53699732,14.0742293 L1.82989054,13.3671225 L5.73989054,9.45613804 L3.24901927,6.96610513 C4.18205582,6.6766836 5.19068652,6.6978211 6.11268124,7.02951763 L9.39033243,3.75123843 L8.29203139,2.6543516 L9.70624495,1.24013804 Z" id="Flatten" fill="currentColor" fill-rule="nonzero"></path>
					</g>
				</svg>
			</button>
		</div>
	</div>
	<div class="chg-model-model-description change-model-truncate"
		id="chg-model-description-{{chgModel.sys_id.value}}"
		uib-tooltip="{{chgModel.description.display_value}}"
		show-tooltip-on-text-overflow=""
		tooltip-class="change-model-truncate-tooltip"
		tooltip-append-to-body="true"
		tooltip-placement="auto top"
		tooltip-enable="false">
		<span ng-bind-html="chgModelLandingCtrl.highlight(chgModel.description.display_value, chgModelLandingCtrl.textSearch)"></span>
	</div>
	<div ng-class="{'change-model-card__row': chgModel.success_rate.display_value, 'change-model-card__row__single_cell': !chgModel.success_rate.display_value}"
		class="change-model-card__row__last"
		id="chg-model-type-{{chgModel.sys_id.value}}">
		<div ng-if="chgModel.success_rate.display_value"
			class="change-model-card__row__cell__small"
			uib-tooltip="{{chgModel.success_rate_hint.display_value}}"
			show-tooltip-on-text-overflow=""
			tooltip-class="change-model-card__row__tooltip"
			tooltip-append-to-body="true"
			tooltip-placement="auto top"
			tooltip-enable="true"
			ng-bind="chgModel.success_rate.display_value">
		</div>
		<div class="change-model-card__row__cell__small"
			uib-tooltip="{{chgModelLandingCtrl.getStateModel(chgModel)}}"
			show-tooltip-on-text-overflow=""
			tooltip-class="change-model-card__row__tooltip"
			tooltip-append-to-body="true"
			tooltip-placement="auto top"
			tooltip-enable="true"
			ng-bind="chgModelLandingCtrl.getModelType(chgModel)">
		</div>
	</div>
	<div style="clear: both"></div>
</div>
</div>
