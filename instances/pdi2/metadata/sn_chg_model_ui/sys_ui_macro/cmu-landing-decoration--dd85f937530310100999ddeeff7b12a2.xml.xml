<div role="region" aria-live="polite" aria-relevant="additions" aria-atomic="true">
	<div id="no-results-found" ng-if="chgModelLandingCtrl.showNoResultsFound()" class="change-model-search-results">
		{{::chgModelLandingCtrl.messages['No results found']}}
	</div>
	<div ng-if="isLoading() &amp;&amp; !chgModelLandingCtrl.isSearching()" class="change-model-loading-msg-container">
		<div class="change-model-splash-msg">{{::chgModelLandingCtrl.messages['Loading...']}}</div>
	</div>
	<div ng-if="chgModelLandingCtrl.isSearching()" class="change-model-loading-msg-container">
		<div class="change-model-splash-msg">{{::chgModelLandingCtrl.messages['Searching...']}}</div>
	</div>
	<div ng-if="chgModelLandingCtrl.limitReached" class="change-model-limit-msg-container">
		<div class="change-model-splash-msg">{{::chgModelLandingCtrl.messages['Limit Reached']}}</div>
	</div>
</div>
