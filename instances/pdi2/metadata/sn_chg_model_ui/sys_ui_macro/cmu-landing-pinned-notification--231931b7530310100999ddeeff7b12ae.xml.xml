
<div ng-if="chgModelLandingCtrl.showPinnedNotification" class="alert alert-success change-model-notification" role="alert" ng-show="chgModelLandingCtrl.showChgModelPinnedMsg" ng-animate="'fade'">
	<span class="notification-icon icon-check-circle"></span>
	<span class="change-model-notification-msg" tabindex="0">{{chgModelLandingCtrl.form.schedulePinnedMsg}}</span>
	<button class="btn-icon close icon-cross change-model-close-notification" tabindex="0" ng-click="chgModelLandingCtrl.showChgModelPinnedMsg=false" data-dismiss="alert">
		<span class="sr-only">{{chgModelLandingCtrl.form.close}}</span>
	</button>
</div>
