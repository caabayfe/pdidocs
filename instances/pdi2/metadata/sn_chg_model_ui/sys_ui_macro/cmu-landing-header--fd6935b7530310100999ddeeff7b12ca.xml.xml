<div class="sn-navhub">
	<div class="sn-navhub-content">
		<div class="sn-navhub-content sn-navhub-content_static sn-navhub-content_row">
			<div class="sn-navhub-content">
				<h1 class="sn-navhub-title">{{chgModelLandingCtrl.form.title}}</h1>
			</div>
		</div>
	</div>
	<div class="sn-navhub-content sn-navhub-content_static">
		<div class="sn-navhub-content sn-navhub-content_static sn-navhub-content_row">
			<div class="sn-navhub-content">
				<div class="change-model-icon-loading" ng-show="isLoading()">
					<div ng-show="isLoading()" class="icon icon-loading"></div>
				</div>
			</div>
		</div>
		<div class="sn-navhub-content sn-navhub-content_static sn-navhub-content_row">
			<div class="sn-navhub-content">
				<button class="btn btn-default change-model-filter-label label card-filter-label"
					ng-show="chgModelLandingCtrl.showClearFilters()"
					ng-disabled="isLoading()"
					ng-click="chgModelLandingCtrl.clearFilters()"
					aria-hidden="false">
					<span class="icon-cross"
						aria-label="{{chgModelLandingCtrl.form.clearFilters}}">
					</span>
					<span>{{chgModelLandingCtrl.form.clearFilters}}</span>
				</button>
			</div>
		</div>
		<div class="sn-navhub-content">
			<landing-filter
				configuration="filter"
				template="sn_chg_model_ui_cmu_landingFilter.xml"
				is-disabled-fn="chgModelLandingCtrl.isDisabled()"/>
		</div>
	</div>
</div>
