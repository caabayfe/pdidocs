                            "payload": {
                                "script": {
                                    "apiVersion": "1.0.0",
                                    "controllerElementId": null,
                                    "inlineScript": "/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\t// Only load viewport if user is already on the guided_app_update tab\n\tif (api.state.activeTab !== 'guided_app_update') return null;\n\tvar results = api.data.in_progress_bulk_app_update_session?.results;\n\tif (results && results.length > 0) {\n\t\treturn {\n\t\t\tviewportElementId: 'viewport_3',\n\t\t\troute: 'guided-app-update',\n\t\t\tfields: {\n\t\t\t\ttable: 'sn_um_upgrade_sessions',\n\t\t\t\tsysId: results[0]?.sys_id?.value,\n\t\t\t\tsessionType: 'bulk_app_update'\n\t\t\t},\n\t\t\tparams: {\n\t\t\t\texperience: '68a44ca29f1312106548971b8a0a1ce2'\n\t\t\t}\n\t\t};\n\t}\n\treturn null;\n}",
                                    "scriptSysId": null,
                                    "target": null
                                },
                                "type": "CLIENT_TRANSFORM_SCRIPT"
                            },
                            "sysId": "32408b42ff7a10109046e490703bf176"
