                                "script": {
                                    "apiVersion": "1.0.0",
                                    "controllerElementId": null,
                                    "inlineScript": "/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tconst results = api.data.in_progress_bulk_app_update_session?.results;\n\tif (results && results.length > 0) {\n\t\treturn {\n\t\t\tpropName: 'bulkPatch',\n\t\t\tvalue: results[0]?.sys_id?.value\n\t\t};\n\t}\n\treturn { propName: 'bulkPatch', value: null };\n}",
                                    "scriptSysId": null,
                                    "target": null
                                },
