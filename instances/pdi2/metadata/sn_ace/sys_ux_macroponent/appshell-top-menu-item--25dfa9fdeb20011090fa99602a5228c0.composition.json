        "elementId": "rich_text_1",
        "elementLabel": "Rich text 1",
        "eventMappings": [

        ],
        "extensionPoints": [

        ],
        "isHero": false,
        "isHidden": {
            "script": {
                "apiVersion": "2.0.0",
                "controllerElementId": null,
                "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    const item = api.context.props.item;\n    const shouldReloadPage = item.props_details.soft_reload;\n    const isRouteAvailable = item.page_route;\n    const hasHTML = /<(?=.*? .*?\\/ ?>|br|hr|input|!--|wbr)[a-z]+.*?>|<([a-z]+).*?<\\/\\1>/i.test(item.title);\n    //Added condition to render rich text for html content, \n    //in case route is not passed and if module item is marked as external\n    if (hasHTML || item.props_details.external_link === 'true' || !isRouteAvailable) {\n        return item.props_details.isHidden || shouldReloadPage === 'true';\n    }\n    return true;\n}",
                "scriptSysId": "83fe8ee7a3e97510e11a7257161e6128",
                "target": null
            },
            "type": "CLIENT_TRANSFORM_SCRIPT"
        },
        "isNonDestructive": false,
        "items": [

        ],
        "overrides": null,
        "propertyValues": {
            "html": {
                "script": {
                    "apiVersion": "2.0.0",
                    "controllerElementId": null,
                    "inlineScript": "/**\n  * @param {params} params\n  * @param {api} params.api\n  * @param {TransformApiHelpers} params.helpers\n  */\nfunction evaluateProperty({api, helpers}) {\n  const item = api.context.props.item;\n  const className = item.isActive ? 'active': '';\n  const link = item.props_details.external_link === 'true' ?\n    `<a href='${item.path}' target='_blank'>\n      ${item.title}\n      <now-icon icon='open-link-outline' style='margin-bottom: 3px' />\n    </a>`\n    : `<a href='${item.path}' class='${className}'>\n      ${item.title}\n    </a>`;\n\n  return `\n    <div style='display: flex; flex-direction: row'>      \n      <style>\n        a { color: white;\n          font-size: 1rem;\n          opacity: 0.8;\n          text-decoration: none;\n          padding: 0.75rem 1rem;\n          line-height: 20px;\n        }\n        a.active { opacity : 1; border-bottom: 2px solid white; }\n        a:hover { border-bottom: 2px solid white; opacity: 0.95;}\n      </style>` + link + `</div>`;\n}",
                    "scriptSysId": "f3a38852ff34111010bad66cf43bf1fb",
                    "target": null
                },
                "type": "CLIENT_TRANSFORM_SCRIPT"
            }
        },
        "slot": null,
        "styles": null
    },
