                    "apiVersion": "2.0.0",
                    "controllerElementId": null,
                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    debugger;\n    const item = api.context.props.item;\n    const className = item.isActive ? 'active' : '';\n\n    if (className == 'active') {\n        return {\n            \"border-bottom\": \"2px solid white\",\n            \"box-sizing\": \"border - box\",\n            \"cursor\": \"pointer\",\n            \"display\": \"flex\",\n            \"flex - direction\": \"column\",\n            \"height\": \"100 %\",\n            \"opacity\": \"1\",\n            \"width\": \"100 %\"\n        };\n    }\n    return {\n        \"box-sizing\": \"border - box\",\n        \"cursor\": \"pointer\",\n        \"display\": \"flex\",\n        \"flex-direction\": \"column\",\n        \"height\": \"100 %\",\n        \"opacity\": \".8\",\n        \"width\": \"100 %\"\n    };\n}",
