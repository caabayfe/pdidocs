<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
<g:requires name="scripts/angular_1.5.11/angular.min.js" includes="true" />
	<script src="scripts/app.regression_solution_stats_ui/module.js"> </script>
	<script src="scripts/app.regression_solution_stats_ui/directive.snRegressionSolutionStats.js"></script>
	<link rel="stylesheet" href="styles/regressionSolutionStats_style.css"/>
	<g2:evaluate var="jvar_regression_sol_config" jelly="true">
		var config = {};
		config.solution_name = current.getValue('solution_name');
		config.solution_id = current.getUniqueValue();
		JSON.stringify(config);
	</g2:evaluate>
	<div id="sn.regressionSolutionStats" sn-ng-formatter="sn.regressionSolutionStats" style= "height:100%; width:100%; padding:0px;">
		<regression-solution-stats-directive config="$[jvar_regression_sol_config]"> </regression-solution-stats-directive>	
	</div>
		
</j:jelly>
