<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<g:requires name="scripts/lib/jquery_includes.js" />
	<g:inline template="glide_weba_header.xml" />
	<g:requires name="scripts/thirdparty/jquery-ui.min.js" />
	<g:requires name="scripts/glide-highcharts.js"/>
	<g:requires name="scripts/heisenberg/heisenberg_all.js" includes="true"/>
	<g:requires name="scripts/angular_includes_1.5.11.js" includes="true" />
	<g:requires name="scripts/js_includes_ngCommon.js" includes="true" />
	<g:requires name="scripts/angularjs-1.4/thirdparty/angular-ui-bootstrap/ui-bootstrap-tpls-1.1.2.js" includes="true" />
	<g:requires name="scripts/js_includes_ml_ui.js" includes="true" />
	<link rel="stylesheet" href="styles/retina_icons/retina_icons.css"/>
	<link rel="stylesheet" href="styles/jquery-ui.css"/>
	<link rel="stylesheet" href="styles/ml_ui.css"/>
	<g2:evaluate var="jvar_clustering_config" jelly="true">
		var config = {};
		config.solution_id = current.getUniqueValue();
		JSON.stringify(config);
	</g2:evaluate>	
	<div id="sn.clusteringUI" sn-ng-formatter="sn.clusteringUI" style= "height:100%; width:100%; padding:0px;">
		<g:inline template="clustering_translations.xml"/>
		<sn-clustering config="$[jvar_clustering_config]"></sn-clustering>
	</div>	
</j:jelly>
