    "sn_uib_tcm.HANDLE_TASK_COMMUNICATION_FILTER_CONTROLLER_PAGE_READY": [
        {
            "broker": null,
            "clientScript": null,
            "conditional": null,
            "declarativeAction": null,
            "event": null,
            "operation": {
                "dataBrokerId": "e68230cea38131108d561e3f26fcda82",
                "operationName": "COMMUNICATION_DETAILS_DATA_FILTER_CONDITIONS",
                "parentResourceId": "communicationDetailsDataFilter",
                "payload": {
                    "script": {
                        "apiVersion": "1.0.0",
                        "controllerElementId": null,
                        "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    const adhocTasks = \"adhocTasks\";\n    const directCall = \"directCall\";\n    const directChat = \"directChat\";\n    const communicationTasks = \"communicationTasks\";\n    const collaborationTasks = \"collaborationTasks\";\n    const taskType = api.context.props.taskType;\n    const communicationPlanId = api.context.props.communicationPlanId;\n    \n    // filters to set filter conditions for communication details data filter controller\n    let filters = {};\n    if (taskType) {\n        if (taskType.toUpperCase() === adhocTasks.toUpperCase()) {\n            filters.planFilters = [];\n            filters.planFilters.push(adhocTasks);\n            filters.dataFilters = [];\n            filters.dataFilters.push(directCall);\n            filters.dataFilters.push(directChat);\n        } else {\n            filters.planFilters = [];\n            if (taskType.toUpperCase() === communicationTasks.toUpperCase()) {\n                filters.planFilters.push(taskType);\n            } else if (taskType.toUpperCase() === collaborationTasks.toUpperCase()) {\n                filters.planFilters.push(taskType);\n            }\n        }\n    }\n    if (communicationPlanId) {\n        filters.communicationPlanIds = [];\n        filters.communicationPlanIds.push(communicationPlanId);\n    }\n    return {\n        filters: filters\n    };\n}",
                        "scriptSysId": null,
                        "target": null
                    },
                    "type": "CLIENT_TRANSFORM_SCRIPT"
                }
            },
            "targetId": "cluiiethiijjaabbxrddbhhpnbiidaffeeh",
            "type": "DATABROKER_OP"
        }
    ]
