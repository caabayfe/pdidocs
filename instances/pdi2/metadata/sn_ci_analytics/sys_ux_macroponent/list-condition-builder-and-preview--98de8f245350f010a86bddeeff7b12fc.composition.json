            "items": {
                "script": {
                    "apiVersion": "2.0.0",
                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.imports\n */\nfunction evaluateProperty({\n    api\n}) {\n    const {\n        output\n    } = api.data.get_filters_list;\n    const defaultFilterList = [];\n    const savedFilterList = [];\n    if (output) {\n        output.forEach(filter => {\n            if (filter.source === 'custom') {\n                savedFilterList.push({\n                    id: filter.id,\n                    label: filter.label\n                });\n            } else {\n                defaultFilterList.push({\n                    id: filter.id,\n                    label: filter.label\n                });\n            }\n        });\n    }\n\n    return [{\n        label: 'Default filters',\n        children: defaultFilterList\n    }, {\n        label: 'Saved filters',\n        children: savedFilterList\n    }];\n}"
                },
                "type": "CLIENT_TRANSFORM_SCRIPT"
            },
            "opened": {
                "type": "JSON_LITERAL",
                "value": false
            },
            "panelFitProps": {
                "type": "JSON_LITERAL",
                "value": {}
            },
            "placeholder": {
                "script": {
                    "apiVersion": "2.0.0",
                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.imports\n */\nfunction evaluateProperty({\n    api\n}) {\n    const {\n        selectedFilterId,\n        comparisonModel\n    } = api.state;\n    const {\n        output\n    } = api.data.analytics_locale_get_list;\n    const {\n        listType\n    } = api.context.props;\n\n    if (!selectedFilterId && output) {\n        if (comparisonModel && comparisonModel.length === 1 && !comparisonModel[0].field.internal) {\n            return output['all'];\n        } else {\n            return output['custom'];\n        }\n    }\n    return '';\n}"
                },
                "type": "CLIENT_TRANSFORM_SCRIPT"
            },
