                                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n * @param {any} params.imports\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    const {\n        output\n    } = api.data.get_dotwalk_metadata;\n    if (output && output.dotWalkMetadata) {\n        return {\n            propName: 'dotWalkMetadata',\n            value: output.dotWalkMetadata\n        };\n    }\n    return {\n        propName: null,\n        value: null\n    };\n}",
