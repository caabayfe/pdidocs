<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    <g:macro id="${jvar_name}_${jvar_value}" name="${jvar_name}" value="${jvar_value}" text="${jvar_text}" chkdval="${jvar_value}" onchange="" enabled="${jvar_enabled}" />

    <!-- e/!${jvar_enabled}/${!jvar_enabled}, 
         val/chkd=${jvar_value}/${jvar_chkdval} -->
<div class="row">
 <div class="col-sm-2 form-field">
  <span class="input-group-radio">

 <j:if test="${jvar_enabled}">
  <j:if test="${jvar_value == jvar_chkdval}"> <!-- ENABLED AND CHECKED -->
      <input id="${jvar_id}" class="radio" type="radio" name="${jvar_name}"
       checked="checked"/>
  </j:if>
  <j:if test="${jvar_value != jvar_chkdval}"> <!-- ENABLED AND NOT CHECKED -->
      <input id="${jvar_id}" class="radio" type="radio" name="${jvar_name}" />
  </j:if>
 </j:if>
 <j:if test="${!jvar_enabled}">
  <j:if test="${jvar_value == jvar_chkdval}"> <!-- DISABLED AND CHECKED -->
     <input id="${jvar_id}" class="radio" type="radio" name="${jvar_name}"
      checked="checked" disabled="disabled"/>
  </j:if>
  <j:if test="${jvar_value != jvar_chkdval}"> <!-- DISABLED AND NOT CHECKED -->
     <input id="${jvar_id}" class="radio" type="radio" name="${jvar_name}"
      disabled="disabled"/>
  </j:if>
 </j:if>
     <label for="${jvar_id}" class="radio-label">
       ${jvar_text}
     </label>
   </span>
  </div>
 </div>                
</j:jelly>
