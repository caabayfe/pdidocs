<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
			<div id="app_installation_progres">
				<p class="progressText" id="progressTxt"></p>
				<div class="progress" id="progress">
					<div class="progress-bar" role="progressbar"  aria-valuemin="0" aria-valuemax="100" id="progress-bar">
						<span class="sr-only" aria-live="polite" aria-atomic="true" id="sronlyProgress"></span>
					</div>
				</div>
				<p class="progressText" style="text-align: right; padding-top: 20px;" id="percentage_complete"></p>
				<div class = "row">
				<button id="closeInstallation" class="btn btn-default" aria-label="${gs.getMessage('Close')}" style="float:right;display:none;margin-right:15px" onClick="onCancel()">${gs.getMessage('Close')}</button>
				<button id="view_logs" class="btn btn-default" aria-label="${gs.getMessage('View Logs')}" style="float:right;margin-right:5px;display:none"  onClick="showLogs()">${gs.getMessage('View Logs')}</button>
				</div>
			</div>
</j:jelly>
