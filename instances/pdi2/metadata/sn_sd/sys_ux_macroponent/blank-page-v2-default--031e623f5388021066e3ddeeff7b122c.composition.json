                            "payload": {
                                "script": {
                                    "apiVersion": "1.0.0",
                                    "controllerElementId": null,
                                    "inlineScript": "/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n * @param {any} params.imports\n * @param {ApiHelpers} params.helpers\n */\nfunction handler({\n    api,\n    event,\n    helpers,\n    imports\n}) {\n\n    let tmpRoute = \"\";\n    let eventName = \"\";\n    let selectedServiceGroup = \"\";\n    let aceEventName = event.payload.eventName;\n    if(aceEventName == \"SERVICE_GROUP_SELECTED\")\n        selectedServiceGroup = event.payload.eventPayload.value[0];\n    else\n        selectedServiceGroup = api.state.blockcontext.selectedServiceGroup[0];\n    \n    let handeledEvents = [\"ADVANCE_BUTTON#CLICKED\", \"SINGLE_SCORE_BUTTON#CLICKED\"];\n    if(handeledEvents.includes(aceEventName))\n        eventName = event.payload.eventPayload.blockcontext.buttonConfig.config;\n\n    switch (eventName) {\n        case (\"SD_CONFIGURE_USER_ROLES\"):\n            {\n                tmpRoute = \"user-roles\";\n                break;\n            }\n        case (\"SD_CONFIGURE_KB_DEFLECTION\"):\n            {\n                tmpRoute = \"kb-deflection-configuration\";\n                break;\n            }\n        case (\"SD_CONFIGURE_VA_DEFLECTION\"):\n            {\n                tmpRoute = \"va-deflection-configuration\";\n                break;\n            }\n        case (\"SD_CONFIGURE_CATALOG_ITEM_FULFILMENT_LEVEL\"):\n            {\n                tmpRoute = \"fulfilment-automation-level\";\n                break;\n            }\n        case (\"SD_CONFIGURE_PA_JOBS\"):\n            {\n                tmpRoute = \"pa-jobs-list\";\n                break;\n            }\n        case (\"SD_CONFIGURE_PROCESS_MINING\"):\n            {\n                tmpRoute = \"process-mining-projects\";\n                break;\n            }\n        case (\"SD_CONFIGURE_SYS_PROP\"):\n            {\n                tmpRoute = \"sys-property-config\";\n                break;\n            }\n        case (\"SD_CONFIGURE_KPI\"):\n            {\n                tmpRoute = \"kpi-details\";\n                break;\n            }\n    }\n\n    return {\n        event: \"Success Dashboard setup\",\n        value: {\n            \"Application Id\": \"sn_sd\",\n            \"Page\": tmpRoute || \"home\",\n            \"Service Group\": selectedServiceGroup,\n            \"Application Name\": \"Success Dashboard Admin Console\"\n        }\n    };\n\n}",
                                    "scriptSysId": null,
                                    "target": null
                                },
                                "type": "CLIENT_TRANSFORM_SCRIPT"
                            },
