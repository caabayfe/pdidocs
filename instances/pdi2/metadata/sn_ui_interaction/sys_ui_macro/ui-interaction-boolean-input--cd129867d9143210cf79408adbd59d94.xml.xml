<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
	<j:set var="ref" value="input_map.${jvar_input.name}"/>
	<g:set_if var="jvar_element_display" test="${jvar_shown}" true="display: block;" false="display: none;"/>

	<div id="element.${ref}" class="form-group" style="${jvar_element_display}">
		<div id="label.${ref}">
			<label onclick="return labelClicked(this);" for="${ref}" dir="ltr" class="col-xs-12 col-md-3 col-lg-3 control-label">
				<span id="status.${ref}" role="note" data-dynamic-title="${jvar_input.description}"/>
				<span title="${jvar_input.description}" class="label-text" data-html="false">${jvar_input.label}</span>
			</label>
		</div>
		<div class="col-xs-10 col-md-7 col-lg-7 form-field input_controls">
			<j:if test="${jvar_value}">
				<span class="input-group-checkbox">
					<input type="checkbox" class="checkbox" id="ni.${ref}" name="ni.${ref}" aria-labelledby="label.ni.${ref}" checked="true" data-type="boolean" aria-required="false" data-ref="${ref}"></input>
					<label for="ni.${ref}" id="label.ni.${ref}" dir="ltr" class="checkbox-label" aria-hidden="true" aria-label="${jvar_input.label}"></label>
				</span>
				<input type="hidden" id="${ref}" name="${jvar_input.name}" data-type="boolean" value="true"/>
			</j:if>
			<j:if test="${!jvar_value}">
				<span class="input-group-checkbox">
					<input type="checkbox" class="checkbox" id="ni.${ref}" name="ni.${ref}" aria-labelledby="label.ni.${ref}" data-type="boolean" aria-required="false" data-ref="${ref}"></input>
					<label for="ni.${ref}" id="label.ni.${ref}" dir="ltr" class="checkbox-label" aria-hidden="true" aria-label="${jvar_input.label}"></label>
				</span>
				<input type="hidden" id="${ref}" name="${jvar_input.name}" data-type="boolean" value="false"/>
			</j:if>
		</div>
		<div class="col-xs-2 col-md-1 col-lg-1 form-field-addons">
			<g:macro_invoke macro="configure_ui_interaction_dynamic_value"/>
		</div>
	</div>
</j:jelly>
