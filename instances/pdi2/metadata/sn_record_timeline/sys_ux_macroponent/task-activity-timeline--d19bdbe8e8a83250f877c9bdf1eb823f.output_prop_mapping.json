{
    "isEmpty": {
        "binding": {
            "address": [
                "isEmpty"
            ]
        },
        "type": "STATE_BINDING"
    },
    "isLoading": {
        "binding": {
            "address": [
                "isLoading"
            ]
        },
        "type": "STATE_BINDING"
    },
    "isNew": {
        "operation": {
            "left": {
                "operation": {
                    "operand": {
                        "binding": {
                            "address": [
                                "sysId"
                            ],
                            "category": "props"
                        },
                        "type": "CONTEXT_BINDING"
                    },
                    "operator": "NOT"
                },
                "type": "UNARY"
            },
            "operator": "OR",
            "right": {
                "operation": {
                    "left": {
                        "binding": {
                            "address": [
                                "sysId"
                            ],
                            "category": "props"
                        },
                        "type": "CONTEXT_BINDING"
                    },
                    "operator": "EQUAL",
                    "right": {
                        "type": "JSON_LITERAL",
                        "value": "-1"
                    }
                },
                "type": "BINARY"
            }
        },
        "type": "BINARY"
    },
    "output": {
        "binding": {
            "address": [
                "get_timeline_data",
                "data"
            ]
        },
        "type": "DATA_OUTPUT_BINDING"
    }
}
